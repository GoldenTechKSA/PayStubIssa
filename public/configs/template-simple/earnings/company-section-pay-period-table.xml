<table id="title-table">
    <style>
        <background>#f0f0f0</background>
        <borderTop>2px solid #888b91</borderTop>
        <borderBottom>1px solid #888b91</borderBottom>
        <fontWeight>bold</fontWeight>
    </style>
    <header title="Pay Period Information">
        <style>
            <fontWeight>bold</fontWeight>
            <fontSize>20px</fontSize>
        </style>
    </header>
    <cells>
        <rowcells>
            <cell id="period-dates" type="substitute">
                <value>Period: {incomeDetails.periodStartDate} - {incomeDetails.periodEndDate}</value>
            </cell>
        </rowcells>
        <rowcells>
            <cell id="period-paydate" type="substitute">
                <value>Pay Date: {incomeDetails.periodPayDate}</value>
            </cell>
        </rowcells>
        <rowcells>
            <cell id="period-subno" type="substitute">
                <value>Paystub No.: {generalInfo.payStubNumber}</value>
            </cell>
        </rowcells>
    </cells>
</table>