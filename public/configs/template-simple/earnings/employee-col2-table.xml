<table id="employee-table">
    <style>
        <background>#f0f0f0</background>
        <marginTop>20px</marginTop>
        <borderTop>2px solid #888b91</borderTop>
        <borderBottom>1px solid #888b91</borderBottom>
        <fontWeight>bold</fontWeight>
    </style>
    <cells>
    <rowcells>
        <cell id="employee-name" type="substitute"><value>{employeeInfo.employeeFirstName} {employeeInfo.employeeLastName}</value></cell>
    </rowcells>
    <rowcells>
        <cell id="employee-id" type="substitute"><value>{employeeInfo.employeeID}</value></cell>
    </rowcells>
    <rowcells>
        <cell id="employee-dept" type="substitute"><value>{employeeInfo.employeeAddress1}</value></cell>
    </rowcells>
    </cells>
</table>