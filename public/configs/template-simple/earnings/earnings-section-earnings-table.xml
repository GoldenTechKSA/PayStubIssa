<table id="earnings-table">
    <header>
        <hdata>
            <hd id="description">
                <style>
                    <backgroundColor>#c8cbcd</backgroundColor>
                    <fontWeight>bold</fontWeight>
                    <fontSize>14px</fontSize>
                    <width>250px</width>
                </style>
                <label>Description</label>
            </hd>
            <hd id="reg-rate">
                <style>
                    <backgroundColor>#c8cbcd</backgroundColor>
                    <fontWeight>bold</fontWeight>
                    <fontSize>14px</fontSize>
                    <width>60px</width>
                </style>
                <label>Rate</label>
            </hd>
            <hd id="hours">
                <style>
                    <backgroundColor>#c8cbcd</backgroundColor>
                    <fontWeight>bold</fontWeight>
                    <fontSize>14px</fontSize>
                    <width>60px</width>
                </style>
                <label>Hours</label>
            </hd>
            <hd id="current">
                <style>
                    <backgroundColor>#c8cbcd</backgroundColor>
                    <fontWeight>bold</fontWeight>
                    <fontSize>14px</fontSize>
                    <width>100px</width>
                </style>
                <label>Total</label>
            </hd>
            <hd id="ytd">
                <style>
                    <backgroundColor>#c8cbcd</backgroundColor>
                    <fontWeight>bold</fontWeight>
                    <fontSize>14px</fontSize>
                    <width>100px</width>
                </style>
                <label>YTD</label>
            </hd>
        </hdata>
    </header>
    <cells>
        <rowcells>
            <cell id="description-value" type="static"><value>Regular Pay</value></cell>
            <cell id="rate-value" type="substitute"><value>{incomeDetails.hourlyRate}</value></cell>
            <cell id="hours-value" type="substitute"><value>{incomeDetails.hoursWorked}</value></cell>
            <cell id="current-value1" type="calculated">
                <formula>{incomeDetails.hourlyRate} * {incomeDetails.hoursWorked}</formula>
            </cell>
            <cell id="ytd-value" type="substitute"><value>{yearToDate.grossPay}</value></cell>
        </rowcells>
        <rowcells>
            <cell id="description-value" type="static"><value>Overtime Pay</value></cell>
            <cell id="rate-value" type="substitute"><value>{incomeDetails.overtimeRate}</value></cell>
            <cell id="hours-value" type="substitute"><value>{incomeDetails.overtimeHours}</value></cell>
            <cell id="current-value2" type="calculated">
                <formula>{incomeDetails.overtimeRate} * {incomeDetails.overtimeHours}</formula>
            </cell>
            <cell id="ytd-value" type="substitute"><value>{yearToDate.grossPay}</value></cell>
        </rowcells>
        <rowcells>
            <cell id="description-value" type="static"><value>Other Earnings</value></cell>
            <cell id="rate-value" type="substitute"><value>{incomeDetails.bonusAmount}</value></cell>
            <cell id="hours-value" type="substitute"><value>{incomeDetails.commission}</value></cell>
            <cell id="current-value3" type="calculated">
                <formula>{incomeDetails.bonusAmount} + {incomeDetails.commission} + {incomeDetails.shiftDifferential} + {incomeDetails.reimbursement}</formula>
            </cell>
            <cell id="ytd-value" type="substitute"><value>{yearToDate.grossPay}</value></cell>
        </rowcells>
    </cells>
</table>