<table id="earnings-table">
    <header title="Earnings Details">
        <style>
            <fontWeight>bold</fontWeight>
            <fontSize>20px</fontSize>
        </style>
        <hdata>
            <hd id="description">
                <style>
                    <borderTop>2px solid #888b91</borderTop>
                    <borderBottom>1px solid #888b91</borderBottom>
                    <fontWeight>bold</fontWeight>
                    <fontSize>14px</fontSize>
                    <width>20%</width>
                </style>
                <label>Description</label>
            </hd>
            <hd id="reg-rate">
                <style>
                    <borderTop>2px solid #888b91</borderTop>
                    <borderBottom>1px solid #888b91</borderBottom>
                    <fontWeight>bold</fontWeight>
                    <fontSize>14px</fontSize>
                    <width>10%</width>
                </style>
                <label>Rate</label>
            </hd>
            <hd id="hours">
                <style>
                    <borderTop>2px solid #888b91</borderTop>
                    <borderBottom>1px solid #888b91</borderBottom>
                    <fontWeight>bold</fontWeight>
                    <fontSize>14px</fontSize>
                    <width>10%</width>
                </style>
                <label>Hours</label>
            </hd>
            <hd id="current">
                <style>
                    <borderTop>2px solid #888b91</borderTop>
                    <borderBottom>1px solid #888b91</borderBottom>
                    <fontWeight>bold</fontWeight>
                    <fontSize>14px</fontSize>
                    <width>10%</width>
                </style>
                <label>Total</label>
            </hd>
            <hd id="ytd">
                <style>
                    <borderTop>2px solid #888b91</borderTop>
                    <borderBottom>1px solid #888b91</borderBottom>
                    <fontWeight>bold</fontWeight>
                    <fontSize>14px</fontSize>
                    <width>10%</width>
                </style>
                <label>YTD</label>
            </hd>
        </hdata>
    </header>
    <cells>
        <rowcells>
            <cell id="reg-desc" type="static"><value>Regular Pay</value></cell>
            <cell id="reg-rate" type="substitute" format="currency"><value>{incomeDetails.hourlyRate}</value></cell>
            <cell id="reg-hours" type="substitute" format="number"><value>{incomeDetails.hoursWorked}</value></cell>
            <cell id="reg-current" type="substitute" format="currency"><value>{regularPay}</value></cell>
            <cell id="reg-ytd" type="substitute" format="currency"><value>{regularPayYTD}</value></cell>
        </rowcells>
        <rowcells>
            <cell id="ot-desc" type="static"><value>Overtime Pay</value></cell>
            <cell id="ot-rate" type="substitute" format="currency"><value>{incomeDetails.overtimeRate}</value></cell>
            <cell id="ot-hours" type="substitute" format="number"><value>{incomeDetails.overtimeHours}</value></cell>
            <cell id="ot-current" type="substitute" format="currency"><value>{overtimePay}</value></cell>
            <cell id="ot-ytd" type="substitute" format="currency"><value>{overtimePayYTD}</value></cell>
        </rowcells>
        <rowcells>
            <cell id="other-desc" type="static"><value>Other Earnings</value></cell>
            <cell id="other-rate" type="static"><value> </value></cell>
            <cell id="other-hours" type="static"><value> </value></cell>
            <cell id="other-current" type="substitute" format="currency"><value>{otherEarnings}</value></cell>
            <cell id="other-ytd" type="substitute" format="currency"><value>{otherEarningsYTD}</value></cell>
        </rowcells>
    </cells>
</table>
