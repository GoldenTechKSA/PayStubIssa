<table id="net-pay-table">
    <style>
        <border>1px solid #686868</border>
    </style>
    <cells>
        <rowcells>
            <cell id="gross-amount" type="static">
                <style>
                    <width>100px</width>
                    <borderTop>1px solid #686868</borderTop>
                </style>
                <value>YTD Gross Pay</value>
            </cell>
            <cell id="net-amount" type="calculated">
                <style>
                    <width>100px</width>
                    <borderTop>1px solid #686868</borderTop>
                    <textAlign>right</textAlign>
                </style>
                <formula>{grossPay}</formula>
            </cell>
        </rowcells>
        <rowcells>
            <cell id="ytd-deductions" type="static">
                <style>
                    <width>100px</width>
                    <borderTop>1px solid #686868</borderTop>
                </style>
                <value>YTD Taxes / Deductions</value>
            </cell>
            <cell id="net-deductions" type="calculated">
                <style>
                    <width>100px</width>
                    <borderTop>1px solid #686868</borderTop>
                    <textAlign>right</textAlign>
                </style>
                <formula>{totalDeductions}</formula>
            </cell>
        </rowcells>
        <rowcells>
            <cell id="net-pay" type="static">
                <style>
                    <width>100px</width>
                    <borderTop>1px solid #686868</borderTop>
                </style>
                <value>YTD Net Pay</value>
            </cell>
            <cell id="net-tax" type="calculated">
                <style>
                    <width>100px</width>
                    <borderTop>1px solid #686868</borderTop>
                    <textAlign>right</textAlign>
                </style>
                <formula>{totalTaxes}</formula>
            </cell>
        </rowcells>
    </cells>
</table>