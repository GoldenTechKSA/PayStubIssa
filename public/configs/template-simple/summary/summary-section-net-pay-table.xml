<table id="gross-pay-table">
    <style>
        <border>1px solid #686868</border>
    </style>
    <cells>
        <rowcells>
            <cell id="employee-dept" type="static">
                <style>
                    <width>100px</width>
                    <backgroundColor>#f9fafb</backgroundColor>
                    <borderTop>1px solid #686868</borderTop>
                </style>
                <value>Gross Pay</value>
            </cell>
            <cell id="net-amount" type="calculated">
                <style>
                    <width>100px</width>
                    <backgroundColor>#f9fafb</backgroundColor>
                    <borderTop>1px solid #686868</borderTop>
                    <textAlign>right</textAlign>
                </style>
                <formula>{payment.grossPay}</formula>
            </cell>
        </rowcells>
        <rowcells>
            <cell id="employee-dept-2" type="static">
                <style>
                    <width>100px</width>
                    <borderTop>1px solid #686868</borderTop>
                    <backgroundColor>#f9fafb</backgroundColor>
                </style>
                <value>Taxes / Deductions</value>
            </cell>
            <cell id="final-net-pay" type="calculated">
                <style>
                    <width>100px</width>
                    <backgroundColor>#f9fafb</backgroundColor>
                    <borderTop>1px solid #686868</borderTop>
                    <textAlign>right</textAlign>
                </style>
                <formula>{yearToDate.totalTaxes}</formula>
            </cell>
        </rowcells>
        <rowcells>
            <cell id="employee-dept-3" type="static">
                <style>
                    <width>100px</width>
                    <backgroundColor>#f9fafb</backgroundColor>
                    <borderTop>1px solid #686868</borderTop>
                    <borderBottom>1px solid #686868</borderBottom>
                </style>
                <value>Net Pay</value>
            </cell>
            <cell id="final-net-pay" type="calculated">
                <style>
                    <width>100px</width>
                    <backgroundColor>#f9fafb</backgroundColor>
                    <borderTop>1px solid #686868</borderTop>
                    <borderBottom>1px solid #686868</borderBottom>
                    <textAlign>right</textAlign>
                </style>
                <formula>{payment.netPay}</formula>
            </cell>
         </rowcells>
    </cells>
</table>