<table id="deductions-table">
    <header title="Deductions Details">
        <style>
            <fontWeight>bold</fontWeight>
            <fontSize>20px</fontSize>
        </style>
        <hdata>
            <hd id="description">
                <style>
                    <borderTop>2px solid #6b7280</borderTop>
                    <borderBottom>1px solid #6b7280</borderBottom>
                    <fontWeight>bold</fontWeight>
                    <fontSize>14px</fontSize>
                    <width>30%</width>
                </style>
                <label>Deductions</label>
            </hd>
            <hd id="current">
                <style>
                    <borderTop>2px solid #6b7280</borderTop>
                    <borderBottom>1px solid #6b7280</borderBottom>
                    <fontWeight>bold</fontWeight>
                    <fontSize>14px</fontSize>
                    <width>20%</width>
                </style>
                <label>This Period</label>
            </hd>
            <hd id="ytd">
                <style>
                    <borderTop>2px solid #6b7280</borderTop>
                    <borderBottom>1px solid #6b7280</borderBottom>
                    <fontWeight>bold</fontWeight>
                    <fontSize>14px</fontSize>
                    <width>20%</width>
                </style>
                <label>YTD</label>
            </hd>
        </hdata>
    </header>
    <cells>
        <rowcells>
            <cell id="medical-desc" type="static"><value>Medical</value></cell>
            <cell id="medical-current" type="substitute" format="currency"><value>{medical}</value></cell>
            <cell id="medical-ytd" type="substitute" format="currency"><value>{medicalYTD}</value></cell>
        </rowcells>
        <rowcells>
            <cell id="dental-desc" type="static"><value>Dental</value></cell>
            <cell id="dental-current" type="substitute" format="currency"><value>{dental}</value></cell>
            <cell id="dental-ytd" type="substitute" format="currency"><value>{dentalYTD}</value></cell>
        </rowcells>
        <rowcells>
            <cell id="vision-desc" type="static"><value>Vision</value></cell>
            <cell id="vision-current" type="substitute" format="currency"><value>{vision}</value></cell>
            <cell id="vision-ytd" type="substitute" format="currency"><value>{visionYTD}</value></cell>
        </rowcells>
        <rowcells>
            <cell id="retirement-desc" type="static"><value>401(k)</value></cell>
            <cell id="retirement-current" type="substitute" format="currency"><value>{retirement401k}</value></cell>
            <cell id="retirement-ytd" type="substitute" format="currency"><value>{retirement401kYTD}</value></cell>
        </rowcells>
        <rowcells>
            <cell id="other-desc" type="static"><value>Other</value></cell>
            <cell id="other-current" type="substitute" format="currency"><value>{otherDeductions}</value></cell>
            <cell id="other-ytd" type="substitute" format="currency"><value>{otherDeductionsYTD}</value></cell>
        </rowcells>
        <rowcells>
            <cell id="total-desc" type="static"><value>Total Deductions</value></cell>
            <cell id="total-current" type="substitute" format="currency"><value>{totalDeductions}</value></cell>
            <cell id="total-ytd" type="substitute" format="currency"><value>{totalDeductionsYTD}</value></cell>
        </rowcells>
    </cells>
</table>
