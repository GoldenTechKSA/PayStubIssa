<table id="summary-table">
    <style>
        <background>#f0f0f0</background>
        <borderTop>2px solid #888b91</borderTop>
        <borderBottom>1px solid #888b91</borderBottom>
        <fontWeight>bold</fontWeight>
    </style>
    <header title="Summary">
        <style>
            <fontWeight>bold</fontWeight>
            <fontSize>20px</fontSize>
        </style>
    </header>
    <cells>
        <rowcells>
            <cell id="gross-label" type="static">
                <style>
                    <paddingRight>40px</paddingRight>
                    <fontWeight>bold</fontWeight>
                </style>
                <value>Gross Pay</value>
            </cell>
            <cell id="gross-value" type="substitute" format="currency">
                <style>
                    <paddingRight>10px</paddingRight>
                    <fontWeight>bold</fontWeight>
                </style>
                <value>{grossPay}</value>
            </cell>
        </rowcells>
        <rowcells>
            <cell id="deductions-label" type="static">
                <style>
                    <paddingRight>40px</paddingRight>
                    <fontWeight>bold</fontWeight>
                </style>
                <value>Deductions</value>
            </cell>
            <cell id="deductions-value" type="substitute" format="currency">
                <style>
                    <paddingRight>10px</paddingRight>
                    <fontWeight>bold</fontWeight>
                </style>
                <value>{totalDeductions}</value>
            </cell>
        </rowcells>
        <rowcells>
            <cell id="taxes-label" type="static">
                <style>
                    <paddingRight>40px</paddingRight>
                    <fontWeight>bold</fontWeight>
                </style>
                <value>Taxes</value>
            </cell>
            <cell id="taxes-value" type="substitute" format="currency">
                <style>
                    <paddingRight>10px</paddingRight>
                    <fontWeight>bold</fontWeight>
                </style>
                <value>{totalTaxes}</value>
            </cell>
        </rowcells>
        <rowcells>
            <cell id="net-label" type="static">
                <style>
                    <paddingRight>40px</paddingRight>
                    <fontWeight>bold</fontWeight>
                </style>
                <value>Net Pay</value>
            </cell>
            <cell id="net-value" type="substitute" format="currency">
                <style>
                    <paddingRight>10px</paddingRight>
                    <fontWeight>bold</fontWeight>
                </style>
                <value>{netPay}</value>
            </cell>
        </rowcells>
    </cells>
</table>
