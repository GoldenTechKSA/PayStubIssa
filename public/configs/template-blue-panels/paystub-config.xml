<?xml version='1.0' encoding='utf-8'?>
<paystub>
  <!--
    Earnings Statement, Blue Panels (blue-panels). Set in Roboto with one blue accent: the
    company name, two gray identity panels with a blue bar, blue-banded Earnings and
    Taxes / Deductions ledgers, and two bordered totals tables (year to date, this period)
    closing on a blue Net Pay band. The logo slot collapses when no logo is uploaded.
    Designed for the 720 x 960 px printable area of a US Letter sheet (see CLAUDE.md,
    "one stub, one sheet").
  -->
  <style>
    <fontFamily>Roboto, 'Helvetica Neue', Arial, sans-serif</fontFamily>
    <color>#333333</color>
    <fontSize>12px</fontSize>
    <lineHeight>1.35</lineHeight>
    <backgroundColor>#ffffff</backgroundColor>
    <padding>10px 0 0</padding>
  </style>
  <!-- Section bp-header: logo slot and company (left) / Earnings Statement, check and stub numbers (right) -->
  <section id="bp-header">
    <style>
      <alignItems>center</alignItems>
      <marginBottom>22px</marginBottom>
    </style>
    <column id="bp-logo-col" width="auto">
      <style>
        <flexShrink>0</flexShrink>
      </style>
      <table id="bp-logo">
        <cells>
          <rowcells>
            <cell id="bp-logo-img" type="image">
              <style>
                <maxHeight>72px</maxHeight>
                <maxWidth>140px</maxWidth>
                <display>block</display>
                <marginRight>14px</marginRight>
                <textAlign>left</textAlign>
              </style>
              <value>{companyInfo.companyLogo}</value>
            </cell>
          </rowcells>
        </cells>
      </table>
    </column>
    <column id="bp-company-col" width="auto">
      <style>
        <flexGrow>1</flexGrow>
      </style>
      <table id="bp-company">
        <style>
          <width>100%</width>
        </style>
        <cells>
          <rowcells>
            <cell id="bp-co-name" type="substitute">
              <style>
                <textAlign>left</textAlign>
                <padding>0</padding>
                <whiteSpace>normal</whiteSpace>
                <fontSize>17px</fontSize>
                <fontWeight>bold</fontWeight>
                <color>#1D5BBF</color>
                <lineHeight>1.2</lineHeight>
              </style>
              <value>{companyInfo.companyName}</value>
            </cell>
          </rowcells>
          <rowcells renderIf="companyInfo.companyEIN">
            <cell id="bp-co-ein" type="substitute">
              <style>
                <textAlign>left</textAlign>
                <padding>0 0 4px</padding>
                <whiteSpace>normal</whiteSpace>
                <fontSize>13px</fontSize>
                <fontStyle>italic</fontStyle>
              </style>
              <value>({companyInfo.companyEIN})</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="bp-co-addr1" type="substitute">
              <style>
                <textAlign>left</textAlign>
                <padding>0</padding>
                <whiteSpace>normal</whiteSpace>
              </style>
              <value>{companyInfo.companyAddress1}</value>
            </cell>
          </rowcells>
          <rowcells renderIf="companyInfo.companyAddress2">
            <cell id="bp-co-addr2" type="substitute">
              <style>
                <textAlign>left</textAlign>
                <padding>0</padding>
                <whiteSpace>normal</whiteSpace>
              </style>
              <value>{companyInfo.companyAddress2}</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="bp-co-city" type="substitute">
              <style>
                <textAlign>left</textAlign>
                <padding>0</padding>
                <whiteSpace>normal</whiteSpace>
              </style>
              <value>{companyCityStateZip}</value>
            </cell>
          </rowcells>
        </cells>
      </table>
    </column>
    <column id="bp-statement-col" width="36%">
      <style>
        <flexShrink>0</flexShrink>
      </style>
      <table id="bp-statement">
        <cells>
          <rowcells>
            <cell id="bp-st-title" type="static" colspan="2">
              <style>
                <textAlign>left</textAlign>
                <padding>0 0 3px</padding>
                <whiteSpace>nowrap</whiteSpace>
                <fontSize>15px</fontSize>
                <fontWeight>bold</fontWeight>
              </style>
              <value>Earnings Statement</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="bp-st-check-label" type="static">
              <style>
                <textAlign>left</textAlign>
                <padding>0 5px 0 0</padding>
                <whiteSpace>nowrap</whiteSpace>
              </style>
              <value>Check Number:</value>
            </cell>
            <cell id="bp-st-check" type="substitute" format="text">
              <style>
                <textAlign>left</textAlign>
                <padding>0</padding>
                <whiteSpace>normal</whiteSpace>
                <fontWeight>bold</fontWeight>
              </style>
              <value>{checkNumber}</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="bp-st-stub-label" type="static">
              <style>
                <textAlign>left</textAlign>
                <padding>0 5px 0 0</padding>
                <whiteSpace>nowrap</whiteSpace>
              </style>
              <value>Stub Number:</value>
            </cell>
            <cell id="bp-st-stub" type="substitute" format="text">
              <style>
                <textAlign>left</textAlign>
                <padding>0</padding>
                <whiteSpace>normal</whiteSpace>
                <fontWeight>bold</fontWeight>
              </style>
              <value>{stubNumber}</value>
            </cell>
          </rowcells>
        </cells>
      </table>
    </column>
  </section>
  <!-- Section bp-identity: employee panel (left) / pay date, schedule, period and payment panel (right) -->
  <section id="bp-identity">
    <style>
      <justifyContent>space-between</justifyContent>
      <marginBottom>22px</marginBottom>
    </style>
    <column id="bp-employee-col" width="54.6%">
      <style>
        <backgroundColor>#EEEEEE</backgroundColor>
        <borderLeft>9px solid #1D5BBF</borderLeft>
        <padding>14px 14px 14px 16px</padding>
      </style>
      <table id="bp-employee">
        <style>
          <width>100%</width>
        </style>
        <cells>
          <rowcells>
            <cell id="bp-emp-name" type="substitute">
              <style>
                <textAlign>left</textAlign>
                <padding>0</padding>
                <whiteSpace>normal</whiteSpace>
                <fontSize>13px</fontSize>
                <fontWeight>bold</fontWeight>
                <color>#1D5BBF</color>
              </style>
              <value>{employeeInfo.employeeFirstName} {employeeInfo.employeeMiddleInitial} {employeeInfo.employeeLastName}</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="bp-emp-ssn" type="substitute">
              <style>
                <textAlign>left</textAlign>
                <padding>0 0 4px</padding>
                <whiteSpace>normal</whiteSpace>
                <fontSize>12px</fontSize>
                <fontStyle>italic</fontStyle>
              </style>
              <value>({employeeSSNMasked})</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="bp-emp-addr1" type="substitute">
              <style>
                <textAlign>left</textAlign>
                <padding>0</padding>
                <whiteSpace>normal</whiteSpace>
                <fontSize>11.5px</fontSize>
              </style>
              <value>{employeeInfo.employeeAddress1}</value>
            </cell>
          </rowcells>
          <rowcells renderIf="employeeInfo.employeeAddress2">
            <cell id="bp-emp-addr2" type="substitute">
              <style>
                <textAlign>left</textAlign>
                <padding>0</padding>
                <whiteSpace>normal</whiteSpace>
                <fontSize>11.5px</fontSize>
              </style>
              <value>{employeeInfo.employeeAddress2}</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="bp-emp-city" type="substitute">
              <style>
                <textAlign>left</textAlign>
                <padding>0</padding>
                <whiteSpace>normal</whiteSpace>
                <fontSize>11.5px</fontSize>
              </style>
              <value>{employeeAddressLine}</value>
            </cell>
          </rowcells>
        </cells>
      </table>
      <table id="bp-employee-more">
        <style>
          <marginTop>8px</marginTop>
        </style>
        <cells>
          <rowcells renderIf="employeeInfo.employeeID">
            <cell id="bp-emp-id-label" type="static">
              <style>
                <textAlign>left</textAlign>
                <padding>0 10px 0 0</padding>
                <whiteSpace>nowrap</whiteSpace>
                <fontSize>11.5px</fontSize>
              </style>
              <value>Employee ID</value>
            </cell>
            <cell id="bp-emp-id" type="substitute" format="text">
              <style>
                <textAlign>left</textAlign>
                <padding>0</padding>
                <whiteSpace>normal</whiteSpace>
                <fontSize>11.5px</fontSize>
                <fontWeight>bold</fontWeight>
                <color>#1D5BBF</color>
              </style>
              <value>{employeeInfo.employeeID}</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="bp-emp-filing-label" type="static">
              <style>
                <textAlign>left</textAlign>
                <padding>0 10px 0 0</padding>
                <whiteSpace>nowrap</whiteSpace>
                <fontSize>11.5px</fontSize>
              </style>
              <value>Filing Status</value>
            </cell>
            <cell id="bp-emp-filing" type="substitute">
              <style>
                <textAlign>left</textAlign>
                <padding>0</padding>
                <whiteSpace>normal</whiteSpace>
                <fontSize>11.5px</fontSize>
                <fontWeight>bold</fontWeight>
                <color>#1D5BBF</color>
              </style>
              <value>{filingStatusLabel}</value>
            </cell>
          </rowcells>
        </cells>
      </table>
    </column>
    <column id="bp-period-col" width="44.2%">
      <style>
        <backgroundColor>#EEEEEE</backgroundColor>
        <borderLeft>9px solid #1D5BBF</borderLeft>
        <padding>14px 14px 14px 16px</padding>
      </style>
      <table id="bp-period">
        <style>
          <width>100%</width>
          <tableLayout>fixed</tableLayout>
        </style>
        <cells>
          <rowcells>
            <cell id="bp-per-paydate-label" type="static">
              <style>
                <textAlign>left</textAlign>
                <padding>0</padding>
                <whiteSpace>normal</whiteSpace>
                <fontSize>11.5px</fontSize>
              </style>
              <value>Pay Date</value>
            </cell>
            <cell id="bp-per-schedule-label" type="static">
              <style>
                <textAlign>left</textAlign>
                <padding>0</padding>
                <whiteSpace>normal</whiteSpace>
                <fontSize>11.5px</fontSize>
              </style>
              <value>Pay Schedule</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="bp-per-paydate" type="substitute" format="date">
              <style>
                <textAlign>left</textAlign>
                <padding>0</padding>
                <whiteSpace>normal</whiteSpace>
                <fontSize>11.5px</fontSize>
                <fontWeight>bold</fontWeight>
                <color>#1D5BBF</color>
              </style>
              <value>{incomeDetails.periodPayDate}</value>
            </cell>
            <cell id="bp-per-schedule" type="substitute">
              <style>
                <textAlign>left</textAlign>
                <padding>0</padding>
                <whiteSpace>normal</whiteSpace>
                <fontSize>11.5px</fontSize>
                <fontWeight>bold</fontWeight>
                <color>#1D5BBF</color>
              </style>
              <value>{incomeDetails.periodType}</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="bp-per-period-label" type="static" colspan="2">
              <style>
                <textAlign>left</textAlign>
                <padding>9px 0 0</padding>
                <whiteSpace>normal</whiteSpace>
                <fontSize>11.5px</fontSize>
              </style>
              <value>Pay Period</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="bp-per-period" type="substitute" colspan="2">
              <style>
                <textAlign>left</textAlign>
                <padding>0</padding>
                <whiteSpace>normal</whiteSpace>
                <fontSize>11.5px</fontSize>
                <fontWeight>bold</fontWeight>
                <color>#1D5BBF</color>
              </style>
              <value>{payPeriodLabel}</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="bp-per-method-label" type="static" colspan="2">
              <style>
                <textAlign>left</textAlign>
                <padding>9px 0 0</padding>
                <whiteSpace>normal</whiteSpace>
                <fontSize>11.5px</fontSize>
              </style>
              <value>Payment</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="bp-per-method" type="substitute" colspan="2">
              <style>
                <textAlign>left</textAlign>
                <padding>0</padding>
                <whiteSpace>normal</whiteSpace>
                <fontSize>11.5px</fontSize>
                <fontWeight>bold</fontWeight>
                <color>#1D5BBF</color>
              </style>
              <value>{paymentMethodLabel}</value>
            </cell>
          </rowcells>
        </cells>
      </table>
    </column>
  </section>
  <!-- Section bp-ledgers: Earnings ledger (left) / Taxes and Deductions ledger (right) -->
  <section id="bp-ledgers">
    <style>
      <justifyContent>space-between</justifyContent>
      <alignItems>flex-start</alignItems>
      <marginBottom>22px</marginBottom>
    </style>
    <column id="bp-earnings-col" width="54.6%">
      <table id="bp-earnings">
        <style>
          <width>100%</width>
          <tableLayout>fixed</tableLayout>
        </style>
        <header>
          <hdata>
            <hd id="bp-earn-h-desc">
              <style>
                <width>30%</width>
                <textAlign>left</textAlign>
                <backgroundColor>#1D5BBF</backgroundColor>
                <color>#ffffff</color>
                <fontSize>12px</fontSize>
                <fontWeight>bold</fontWeight>
                <padding>5px 9px</padding>
              </style>
              <label>Earnings</label>
            </hd>
            <hd id="bp-earn-h-rate">
              <style>
                <width>15%</width>
                <textAlign>right</textAlign>
                <backgroundColor>#1D5BBF</backgroundColor>
                <color>#ffffff</color>
                <fontSize>12px</fontSize>
                <fontWeight>bold</fontWeight>
                <padding>5px 4px</padding>
              </style>
              <label>Rate</label>
            </hd>
            <hd id="bp-earn-h-hours">
              <style>
                <width>13%</width>
                <textAlign>right</textAlign>
                <backgroundColor>#1D5BBF</backgroundColor>
                <color>#ffffff</color>
                <fontSize>12px</fontSize>
                <fontWeight>bold</fontWeight>
                <padding>5px 4px</padding>
              </style>
              <label>Hours</label>
            </hd>
            <hd id="bp-earn-h-cur">
              <style>
                <width>20%</width>
                <textAlign>right</textAlign>
                <backgroundColor>#1D5BBF</backgroundColor>
                <color>#ffffff</color>
                <fontSize>12px</fontSize>
                <fontWeight>bold</fontWeight>
                <padding>5px 4px</padding>
              </style>
              <label>Total</label>
            </hd>
            <hd id="bp-earn-h-ytd">
              <style>
                <width>22%</width>
                <textAlign>right</textAlign>
                <backgroundColor>#1D5BBF</backgroundColor>
                <color>#ffffff</color>
                <fontSize>12px</fontSize>
                <fontWeight>bold</fontWeight>
                <padding>5px 9px 5px 4px</padding>
              </style>
              <label>YTD</label>
            </hd>
          </hdata>
        </header>
        <cells>
          <rowcells renderIf="isHourly">
            <cell id="bp-earn-regular-desc" type="static">
              <style>
                <textAlign>left</textAlign>
                <fontSize>11.5px</fontSize>
                <padding>5px 9px</padding>
                <backgroundColor>#E8E8E8</backgroundColor>
                <borderBottom>1px solid #9A9A9A</borderBottom>
                <whiteSpace>normal</whiteSpace>
              </style>
              <value>Regular Earnings</value>
            </cell>
            <cell id="bp-earn-regular-rate" type="substitute" format="currency">
              <style>
                <textAlign>right</textAlign>
                <fontSize>11.5px</fontSize>
                <padding>5px 4px</padding>
                <backgroundColor>#E8E8E8</backgroundColor>
                <borderBottom>1px solid #9A9A9A</borderBottom>
              </style>
              <value>{incomeDetails.hourlyRate}</value>
            </cell>
            <cell id="bp-earn-regular-hours" type="substitute" format="number">
              <style>
                <textAlign>right</textAlign>
                <fontSize>11.5px</fontSize>
                <padding>5px 4px</padding>
                <backgroundColor>#E8E8E8</backgroundColor>
                <borderBottom>1px solid #9A9A9A</borderBottom>
              </style>
              <value>{incomeDetails.hoursWorked}</value>
            </cell>
            <cell id="bp-earn-regular-cur" type="substitute" format="currency">
              <style>
                <textAlign>right</textAlign>
                <fontSize>11.5px</fontSize>
                <padding>5px 4px</padding>
                <backgroundColor>#E8E8E8</backgroundColor>
                <borderBottom>1px solid #9A9A9A</borderBottom>
              </style>
              <value>{regularPay}</value>
            </cell>
            <cell id="bp-earn-regular-ytd" type="substitute" format="currency">
              <style>
                <textAlign>right</textAlign>
                <fontSize>11.5px</fontSize>
                <padding>5px 9px 5px 4px</padding>
                <backgroundColor>#E8E8E8</backgroundColor>
                <borderBottom>1px solid #9A9A9A</borderBottom>
              </style>
              <value>{regularPayYTD}</value>
            </cell>
          </rowcells>
          <rowcells renderIf="isSalaried">
            <cell id="bp-earn-salary-desc" type="static">
              <style>
                <textAlign>left</textAlign>
                <fontSize>11.5px</fontSize>
                <padding>5px 9px</padding>
                <backgroundColor>#E8E8E8</backgroundColor>
                <borderBottom>1px solid #9A9A9A</borderBottom>
                <whiteSpace>normal</whiteSpace>
              </style>
              <value>Salary</value>
            </cell>
            <cell id="bp-earn-salary-blank0" type="static">
              <style>
                <textAlign>right</textAlign>
                <fontSize>11.5px</fontSize>
                <padding>5px 9px</padding>
                <backgroundColor>#E8E8E8</backgroundColor>
                <borderBottom>1px solid #9A9A9A</borderBottom>
              </style>
              <value> </value>
            </cell>
            <cell id="bp-earn-salary-blank1" type="static">
              <style>
                <textAlign>right</textAlign>
                <fontSize>11.5px</fontSize>
                <padding>5px 9px</padding>
                <backgroundColor>#E8E8E8</backgroundColor>
                <borderBottom>1px solid #9A9A9A</borderBottom>
              </style>
              <value> </value>
            </cell>
            <cell id="bp-earn-salary-cur" type="substitute" format="currency">
              <style>
                <textAlign>right</textAlign>
                <fontSize>11.5px</fontSize>
                <padding>5px 4px</padding>
                <backgroundColor>#E8E8E8</backgroundColor>
                <borderBottom>1px solid #9A9A9A</borderBottom>
              </style>
              <value>{regularPay}</value>
            </cell>
            <cell id="bp-earn-salary-ytd" type="substitute" format="currency">
              <style>
                <textAlign>right</textAlign>
                <fontSize>11.5px</fontSize>
                <padding>5px 9px 5px 4px</padding>
                <backgroundColor>#E8E8E8</backgroundColor>
                <borderBottom>1px solid #9A9A9A</borderBottom>
              </style>
              <value>{regularPayYTD}</value>
            </cell>
          </rowcells>
          <rowcells renderIf="overtimePay">
            <cell id="bp-earn-overtime-desc" type="static">
              <style>
                <textAlign>left</textAlign>
                <fontSize>11.5px</fontSize>
                <padding>5px 9px</padding>
                <backgroundColor>#E8E8E8</backgroundColor>
                <borderBottom>1px solid #9A9A9A</borderBottom>
                <whiteSpace>normal</whiteSpace>
              </style>
              <value>Overtime</value>
            </cell>
            <cell id="bp-earn-overtime-rate" type="substitute" format="currency">
              <style>
                <textAlign>right</textAlign>
                <fontSize>11.5px</fontSize>
                <padding>5px 4px</padding>
                <backgroundColor>#E8E8E8</backgroundColor>
                <borderBottom>1px solid #9A9A9A</borderBottom>
              </style>
              <value>{incomeDetails.overtimeRate}</value>
            </cell>
            <cell id="bp-earn-overtime-hours" type="substitute" format="number">
              <style>
                <textAlign>right</textAlign>
                <fontSize>11.5px</fontSize>
                <padding>5px 4px</padding>
                <backgroundColor>#E8E8E8</backgroundColor>
                <borderBottom>1px solid #9A9A9A</borderBottom>
              </style>
              <value>{incomeDetails.overtimeHours}</value>
            </cell>
            <cell id="bp-earn-overtime-cur" type="substitute" format="currency">
              <style>
                <textAlign>right</textAlign>
                <fontSize>11.5px</fontSize>
                <padding>5px 4px</padding>
                <backgroundColor>#E8E8E8</backgroundColor>
                <borderBottom>1px solid #9A9A9A</borderBottom>
              </style>
              <value>{overtimePay}</value>
            </cell>
            <cell id="bp-earn-overtime-ytd" type="substitute" format="currency">
              <style>
                <textAlign>right</textAlign>
                <fontSize>11.5px</fontSize>
                <padding>5px 9px 5px 4px</padding>
                <backgroundColor>#E8E8E8</backgroundColor>
                <borderBottom>1px solid #9A9A9A</borderBottom>
              </style>
              <value>{overtimePayYTD}</value>
            </cell>
          </rowcells>
          <rowcells renderIf="otherEarnings">
            <cell id="bp-earn-bonus-desc" type="static">
              <style>
                <textAlign>left</textAlign>
                <fontSize>11.5px</fontSize>
                <padding>5px 9px</padding>
                <backgroundColor>#E8E8E8</backgroundColor>
                <borderBottom>1px solid #9A9A9A</borderBottom>
                <whiteSpace>normal</whiteSpace>
              </style>
              <value>Bonus</value>
            </cell>
            <cell id="bp-earn-bonus-blank0" type="static">
              <style>
                <textAlign>right</textAlign>
                <fontSize>11.5px</fontSize>
                <padding>5px 9px</padding>
                <backgroundColor>#E8E8E8</backgroundColor>
                <borderBottom>1px solid #9A9A9A</borderBottom>
              </style>
              <value> </value>
            </cell>
            <cell id="bp-earn-bonus-blank1" type="static">
              <style>
                <textAlign>right</textAlign>
                <fontSize>11.5px</fontSize>
                <padding>5px 9px</padding>
                <backgroundColor>#E8E8E8</backgroundColor>
                <borderBottom>1px solid #9A9A9A</borderBottom>
              </style>
              <value> </value>
            </cell>
            <cell id="bp-earn-bonus-cur" type="substitute" format="currency">
              <style>
                <textAlign>right</textAlign>
                <fontSize>11.5px</fontSize>
                <padding>5px 4px</padding>
                <backgroundColor>#E8E8E8</backgroundColor>
                <borderBottom>1px solid #9A9A9A</borderBottom>
              </style>
              <value>{otherEarnings}</value>
            </cell>
            <cell id="bp-earn-bonus-ytd" type="substitute" format="currency">
              <style>
                <textAlign>right</textAlign>
                <fontSize>11.5px</fontSize>
                <padding>5px 9px 5px 4px</padding>
                <backgroundColor>#E8E8E8</backgroundColor>
                <borderBottom>1px solid #9A9A9A</borderBottom>
              </style>
              <value>{otherEarningsYTD}</value>
            </cell>
          </rowcells>
        </cells>
      </table>
    </column>
    <column id="bp-taxes-col" width="44.2%">
      <table id="bp-taxes">
        <style>
          <width>100%</width>
