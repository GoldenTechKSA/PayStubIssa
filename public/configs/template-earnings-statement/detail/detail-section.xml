<?xml version='1.0' encoding='utf-8'?>
<!-- The body of the form: earnings on the left, withholding on the right, split by
     a full-height hairline. That rule is the right border of the left column, and
     both columns stretch to the section minHeight so it runs all the way down to
     the summary band even when the two lists are different lengths.

     Both header rows use identical type and padding, so their bottom borders meet
     as one continuous rule across the page.

     Overtime and bonus get their own fixed rows. A row cannot hide itself when a
     value is zero (renderIf applies to a whole table, not a row), so they print as
     0.00 rather than silently dropping earnings the customer entered. -->
<section id="es-detail-section">
    <style><minHeight>180px</minHeight></style>

    <column id="es-income-col" width="50%">
        <style><borderRight>1px solid #000000</borderRight></style>
        <table id="es-income-table">
            <style><width>100%</width></style>
            <header>
                <hdata>
                    <hd id="es-h-income">
                        <style><width>40%</width><textAlign>left</textAlign><fontSize>11px</fontSize><fontWeight>bold</fontWeight><padding>5px 10px</padding><borderBottom>1px solid #000000</borderBottom><whiteSpace>nowrap</whiteSpace></style>
                        <label>INCOME</label>
                    </hd>
                    <hd id="es-h-rate">
                        <style><width>18%</width><textAlign>center</textAlign><fontSize>11px</fontSize><fontWeight>bold</fontWeight><padding>5px 10px</padding><borderBottom>1px solid #000000</borderBottom><whiteSpace>nowrap</whiteSpace></style>
                        <label>RATE</label>
                    </hd>
                    <hd id="es-h-hours">
                        <style><width>18%</width><textAlign>center</textAlign><fontSize>11px</fontSize><fontWeight>bold</fontWeight><padding>5px 10px</padding><borderBottom>1px solid #000000</borderBottom><whiteSpace>nowrap</whiteSpace></style>
                        <label>HOURS</label>
                    </hd>
                    <hd id="es-h-income-total">
                        <style><width>24%</width><textAlign>right</textAlign><fontSize>11px</fontSize><fontWeight>bold</fontWeight><padding>5px 10px</padding><borderBottom>1px solid #000000</borderBottom><whiteSpace>nowrap</whiteSpace></style>
                        <label>CURRENT TOTAL</label>
                    </hd>
                </hdata>
            </header>
            <cells>
                <rowcells>
                    <cell id="es-wages-desc" type="static"><style><textAlign>left</textAlign><padding>4px 10px</padding></style><value>GROSS WAGES</value></cell>
                    <cell id="es-wages-rate" type="substitute" format="number"><style><textAlign>center</textAlign><padding>4px 10px</padding></style><value>{incomeDetails.hourlyRate}</value></cell>
                    <cell id="es-wages-hours" type="substitute" format="number"><style><textAlign>center</textAlign><padding>4px 10px</padding></style><value>{incomeDetails.hoursWorked}</value></cell>
                    <cell id="es-wages-total" type="substitute" format="number"><style><textAlign>right</textAlign><padding>4px 10px</padding></style><value>{regularPay}</value></cell>
                </rowcells>
                <rowcells>
                    <cell id="es-ot-desc" type="static"><style><textAlign>left</textAlign><padding>4px 10px</padding></style><value>OVERTIME</value></cell>
                    <cell id="es-ot-rate" type="substitute" format="number"><style><textAlign>center</textAlign><padding>4px 10px</padding></style><value>{incomeDetails.overtimeRate}</value></cell>
                    <cell id="es-ot-hours" type="substitute" format="number"><style><textAlign>center</textAlign><padding>4px 10px</padding></style><value>{incomeDetails.overtimeHours}</value></cell>
                    <cell id="es-ot-total" type="substitute" format="number"><style><textAlign>right</textAlign><padding>4px 10px</padding></style><value>{overtimePay}</value></cell>
                </rowcells>
                <rowcells>
                    <cell id="es-bonus-desc" type="static"><style><textAlign>left</textAlign><padding>4px 10px</padding></style><value>BONUS</value></cell>
                    <cell id="es-bonus-rate" type="static"><style><padding>4px 10px</padding></style><value> </value></cell>
                    <cell id="es-bonus-hours" type="static"><style><padding>4px 10px</padding></style><value> </value></cell>
                    <cell id="es-bonus-total" type="substitute" format="number"><style><textAlign>right</textAlign><padding>4px 10px</padding></style><value>{otherEarnings}</value></cell>
                </rowcells>
            </cells>
        </table>
    </column>

    <column id="es-deductions-col" width="50%">
        <table id="es-deductions-table">
            <style><width>100%</width></style>
            <header>
                <hdata>
                    <hd id="es-h-deductions">
                        <style><width>40%</width><textAlign>left</textAlign><fontSize>11px</fontSize><fontWeight>bold</fontWeight><padding>5px 10px</padding><borderBottom>1px solid #000000</borderBottom><whiteSpace>nowrap</whiteSpace></style>
                        <label>DEDUCTIONS</label>
                    </hd>
                    <hd id="es-h-ded-current">
                        <style><width>30%</width><textAlign>right</textAlign><fontSize>11px</fontSize><fontWeight>bold</fontWeight><padding>5px 10px</padding><borderBottom>1px solid #000000</borderBottom><whiteSpace>nowrap</whiteSpace></style>
                        <label>CURRENT TOTAL</label>
                    </hd>
                    <hd id="es-h-ded-ytd">
                        <style><width>30%</width><textAlign>right</textAlign><fontSize>11px</fontSize><fontWeight>bold</fontWeight><padding>5px 10px</padding><borderBottom>1px solid #000000</borderBottom><whiteSpace>nowrap</whiteSpace></style>
                        <label>YEAR-TO-DATE</label>
                    </hd>
                </hdata>
            </header>
            <cells>
                <rowcells>
                    <cell id="es-fica-med-desc" type="static"><style><textAlign>left</textAlign><padding>4px 10px</padding></style><value>FICA MED TAX</value></cell>
                    <cell id="es-fica-med-current" type="substitute" format="number"><style><textAlign>right</textAlign><padding>4px 10px</padding></style><value>{medicare}</value></cell>
                    <cell id="es-fica-med-ytd" type="substitute" format="number"><style><textAlign>right</textAlign><padding>4px 10px</padding></style><value>{medicareYTD}</value></cell>
                </rowcells>
                <rowcells>
                    <cell id="es-fica-ss-desc" type="static"><style><textAlign>left</textAlign><padding>4px 10px</padding></style><value>FICA SS TAX</value></cell>
                    <cell id="es-fica-ss-current" type="substitute" format="number"><style><textAlign>right</textAlign><padding>4px 10px</padding></style><value>{socialSecurity}</value></cell>
                    <cell id="es-fica-ss-ytd" type="substitute" format="number"><style><textAlign>right</textAlign><padding>4px 10px</padding></style><value>{socialSecurityYTD}</value></cell>
                </rowcells>
                <rowcells>
                    <cell id="es-fed-desc" type="static"><style><textAlign>left</textAlign><padding>4px 10px</padding></style><value>FED TAX</value></cell>
                    <cell id="es-fed-current" type="substitute" format="number"><style><textAlign>right</textAlign><padding>4px 10px</padding></style><value>{federalTax}</value></cell>
                    <cell id="es-fed-ytd" type="substitute" format="number"><style><textAlign>right</textAlign><padding>4px 10px</padding></style><value>{federalTaxYTD}</value></cell>
                </rowcells>
                <rowcells>
                    <cell id="es-state-desc" type="substitute"><style><textAlign>left</textAlign><padding>4px 10px</padding></style><value>{stateTaxLabel}</value></cell>
                    <cell id="es-state-current" type="substitute" format="number"><style><textAlign>right</textAlign><padding>4px 10px</padding></style><value>{stateTax}</value></cell>
                    <cell id="es-state-ytd" type="substitute" format="number"><style><textAlign>right</textAlign><padding>4px 10px</padding></style><value>{stateTaxYTD}</value></cell>
                </rowcells>
            </cells>
        </table>
    </column>
</section>
