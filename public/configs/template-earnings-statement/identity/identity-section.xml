<?xml version='1.0' encoding='utf-8'?>
<!-- Identity strip: six labelled fields on one row. First column reads left,
     last reads right, the middle four centre under their labels.
     SSN, pay period and the state tax label are prose the renderer cannot build
     from a path lookup, so they arrive pre-assembled on the model. -->
<section id="es-identity-section">
    <column id="es-identity-col" width="100%">
        <table id="es-identity-table">
            <style><width>100%</width></style>
            <header>
                <hdata>
                    <hd id="es-h-name">
                        <style><width>32%</width><textAlign>left</textAlign><fontSize>11px</fontSize><fontWeight>bold</fontWeight><padding>5px 10px</padding><borderBottom>1px solid #000000</borderBottom><whiteSpace>nowrap</whiteSpace></style>
                        <label>EMPLOYEE NAME</label>
                    </hd>
                    <hd id="es-h-ssn">
                        <style><width>11%</width><textAlign>center</textAlign><fontSize>11px</fontSize><fontWeight>bold</fontWeight><padding>5px 10px</padding><borderBottom>1px solid #000000</borderBottom><whiteSpace>nowrap</whiteSpace></style>
                        <label>SSN</label>
                    </hd>
                    <hd id="es-h-empid">
                        <style><width>13%</width><textAlign>center</textAlign><fontSize>11px</fontSize><fontWeight>bold</fontWeight><padding>5px 10px</padding><borderBottom>1px solid #000000</borderBottom><whiteSpace>nowrap</whiteSpace></style>
                        <label>EMPLOYEE ID</label>
                    </hd>
                    <hd id="es-h-check">
                        <style><width>12%</width><textAlign>center</textAlign><fontSize>11px</fontSize><fontWeight>bold</fontWeight><padding>5px 10px</padding><borderBottom>1px solid #000000</borderBottom><whiteSpace>nowrap</whiteSpace></style>
                        <label>CHECK NO.</label>
                    </hd>
                    <hd id="es-h-period">
                        <style><width>20%</width><textAlign>center</textAlign><fontSize>11px</fontSize><fontWeight>bold</fontWeight><padding>5px 10px</padding><borderBottom>1px solid #000000</borderBottom><whiteSpace>nowrap</whiteSpace></style>
                        <label>PAY PERIOD</label>
                    </hd>
                    <hd id="es-h-paydate">
                        <style><width>12%</width><textAlign>right</textAlign><fontSize>11px</fontSize><fontWeight>bold</fontWeight><padding>5px 10px</padding><borderBottom>1px solid #000000</borderBottom><whiteSpace>nowrap</whiteSpace></style>
                        <label>PAY DATE</label>
                    </hd>
                </hdata>
            </header>
            <cells>
                <rowcells>
                    <cell id="es-v-name" type="substitute">
                        <style><textAlign>left</textAlign><padding>5px 10px</padding><borderBottom>1px solid #000000</borderBottom></style>
                        <value>{employeeInfo.employeeFirstName} {employeeInfo.employeeLastName}</value>
                    </cell>
                    <cell id="es-v-ssn" type="substitute">
                        <style><textAlign>center</textAlign><padding>5px 10px</padding><borderBottom>1px solid #000000</borderBottom></style>
                        <value>{employeeSSNMasked}</value>
                    </cell>
                    <cell id="es-v-empid" type="substitute">
                        <style><textAlign>center</textAlign><padding>5px 10px</padding><borderBottom>1px solid #000000</borderBottom></style>
                        <value>{employeeInfo.employeeID}</value>
                    </cell>
                    <cell id="es-v-check" type="substitute">
                        <style><textAlign>center</textAlign><padding>5px 10px</padding><borderBottom>1px solid #000000</borderBottom></style>
                        <value>{checkNumber}</value>
                    </cell>
                    <cell id="es-v-period" type="substitute">
                        <style><textAlign>center</textAlign><padding>5px 10px</padding><borderBottom>1px solid #000000</borderBottom></style>
                        <value>{payPeriodLabel}</value>
                    </cell>
                    <cell id="es-v-paydate" type="substitute" format="date">
                        <style><textAlign>right</textAlign><padding>5px 10px</padding><borderBottom>1px solid #000000</borderBottom></style>
                        <value>{incomeDetails.periodPayDate}</value>
                    </cell>
                </rowcells>
            </cells>
        </table>
    </column>
</section>
