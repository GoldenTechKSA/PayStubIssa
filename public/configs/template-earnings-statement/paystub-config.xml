<?xml version='1.0' encoding='utf-8'?>
<paystub>
  <style>
    <fontFamily>'Times New Roman', 'Liberation Serif', Georgia, serif</fontFamily>
    <color>#000000</color>
    <fontSize>12px</fontSize>
    <border>1px solid #000000</border>
    <backgroundColor>#ffffff</backgroundColor>
  </style>
  <!-- Section es-header-section -->
  <section id="es-header-section">
    <style>
      <alignItems>center</alignItems>
      <borderBottom>1px solid #000000</borderBottom>
    </style>
    <column id="es-header-company" width="55%">
      <table id="es-company-table">
        <style>
          <width>100%</width>
        </style>
        <cells>
          <rowcells>
            <cell id="es-company-name" type="substitute">
              <style>
                <fontSize>14px</fontSize>
                <fontWeight>bold</fontWeight>
                <textAlign>left</textAlign>
                <padding>10px 10px 0 10px</padding>
              </style>
              <value>{companyInfo.companyName}</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="es-company-address" type="substitute">
              <style>
                <fontSize>11px</fontSize>
                <textAlign>left</textAlign>
                <padding>2px 10px 10px 10px</padding>
              </style>
              <value>{companyAddressLine}</value>
            </cell>
          </rowcells>
        </cells>
      </table>
    </column>
    <column id="es-header-title" width="45%">
      <table id="es-title-table">
        <style>
          <width>100%</width>
        </style>
        <cells>
          <rowcells>
            <cell id="es-statement-title" type="static">
              <style>
                <fontSize>20px</fontSize>
                <fontWeight>bold</fontWeight>
                <textAlign>right</textAlign>
                <padding>10px</padding>
              </style>
              <value>EARNINGS STATEMENT</value>
            </cell>
          </rowcells>
        </cells>
      </table>
    </column>
  </section>
  <!-- Section es-identity-section -->
  <section id="es-identity-section">
    <column id="es-identity-col" width="100%">
      <table id="es-identity-table">
        <style>
          <width>100%</width>
        </style>
        <header>
          <hdata>
            <hd id="es-h-name">
              <style>
                <width>32%</width>
                <textAlign>left</textAlign>
                <fontSize>11px</fontSize>
                <fontWeight>bold</fontWeight>
                <padding>5px 10px</padding>
                <borderBottom>1px solid #000000</borderBottom>
                <whiteSpace>nowrap</whiteSpace>
              </style>
              <label>EMPLOYEE NAME</label>
            </hd>
            <hd id="es-h-ssn">
              <style>
                <width>11%</width>
                <textAlign>center</textAlign>
                <fontSize>11px</fontSize>
                <fontWeight>bold</fontWeight>
                <padding>5px 10px</padding>
                <borderBottom>1px solid #000000</borderBottom>
                <whiteSpace>nowrap</whiteSpace>
              </style>
              <label>SSN</label>
            </hd>
            <hd id="es-h-empid">
              <style>
                <width>13%</width>
                <textAlign>center</textAlign>
                <fontSize>11px</fontSize>
                <fontWeight>bold</fontWeight>
                <padding>5px 10px</padding>
                <borderBottom>1px solid #000000</borderBottom>
                <whiteSpace>nowrap</whiteSpace>
              </style>
              <label>EMPLOYEE ID</label>
            </hd>
            <hd id="es-h-check">
              <style>
                <width>12%</width>
                <textAlign>center</textAlign>
                <fontSize>11px</fontSize>
                <fontWeight>bold</fontWeight>
                <padding>5px 10px</padding>
                <borderBottom>1px solid #000000</borderBottom>
                <whiteSpace>nowrap</whiteSpace>
              </style>
              <label>CHECK NO.</label>
            </hd>
            <hd id="es-h-period">
              <style>
                <width>20%</width>
                <textAlign>center</textAlign>
                <fontSize>11px</fontSize>
                <fontWeight>bold</fontWeight>
                <padding>5px 10px</padding>
                <borderBottom>1px solid #000000</borderBottom>
                <whiteSpace>nowrap</whiteSpace>
              </style>
              <label>PAY PERIOD</label>
            </hd>
            <hd id="es-h-paydate">
              <style>
                <width>12%</width>
                <textAlign>right</textAlign>
                <fontSize>11px</fontSize>
                <fontWeight>bold</fontWeight>
                <padding>5px 10px</padding>
                <borderBottom>1px solid #000000</borderBottom>
                <whiteSpace>nowrap</whiteSpace>
              </style>
              <label>PAY DATE</label>
            </hd>
          </hdata>
        </header>
        <cells>
          <rowcells>
            <cell id="es-v-name" type="substitute">
              <style>
                <textAlign>left</textAlign>
                <padding>5px 10px</padding>
                <borderBottom>1px solid #000000</borderBottom>
              </style>
              <value>{employeeInfo.employeeFirstName} {employeeInfo.employeeLastName}</value>
            </cell>
            <cell id="es-v-ssn" type="substitute">
              <style>
                <textAlign>center</textAlign>
                <padding>5px 10px</padding>
                <borderBottom>1px solid #000000</borderBottom>
              </style>
              <value>{employeeSSNMasked}</value>
            </cell>
            <cell id="es-v-empid" type="substitute">
              <style>
                <textAlign>center</textAlign>
                <padding>5px 10px</padding>
                <borderBottom>1px solid #000000</borderBottom>
              </style>
              <value>{employeeInfo.employeeID}</value>
            </cell>
            <cell id="es-v-check" type="substitute">
              <style>
                <textAlign>center</textAlign>
                <padding>5px 10px</padding>
                <borderBottom>1px solid #000000</borderBottom>
              </style>
              <value>{checkNumber}</value>
            </cell>
            <cell id="es-v-period" type="substitute">
              <style>
                <textAlign>center</textAlign>
                <padding>5px 10px</padding>
                <borderBottom>1px solid #000000</borderBottom>
              </style>
              <value>{payPeriodLabel}</value>
            </cell>
            <cell id="es-v-paydate" type="substitute" format="date">
              <style>
                <textAlign>right</textAlign>
                <padding>5px 10px</padding>
                <borderBottom>1px solid #000000</borderBottom>
              </style>
              <value>{incomeDetails.periodPayDate}</value>
            </cell>
          </rowcells>
        </cells>
      </table>
    </column>
  </section>
  <!-- Section es-detail-section -->
  <section id="es-detail-section">
    <style>
      <minHeight>180px</minHeight>
    </style>
    <column id="es-income-col" width="50%">
      <style>
        <borderRight>1px solid #000000</borderRight>
      </style>
      <table id="es-income-table">
        <style>
          <width>100%</width>
        </style>
        <header>
          <hdata>
            <hd id="es-h-income">
              <style>
                <width>40%</width>
                <textAlign>left</textAlign>
                <fontSize>11px</fontSize>
                <fontWeight>bold</fontWeight>
                <padding>5px 10px</padding>
                <borderBottom>1px solid #000000</borderBottom>
                <whiteSpace>nowrap</whiteSpace>
              </style>
              <label>INCOME</label>
            </hd>
            <hd id="es-h-rate">
              <style>
                <width>18%</width>
                <textAlign>center</textAlign>
                <fontSize>11px</fontSize>
                <fontWeight>bold</fontWeight>
                <padding>5px 10px</padding>
                <borderBottom>1px solid #000000</borderBottom>
                <whiteSpace>nowrap</whiteSpace>
              </style>
              <label>RATE</label>
            </hd>
            <hd id="es-h-hours">
              <style>
                <width>18%</width>
                <textAlign>center</textAlign>
                <fontSize>11px</fontSize>
                <fontWeight>bold</fontWeight>
                <padding>5px 10px</padding>
                <borderBottom>1px solid #000000</borderBottom>
                <whiteSpace>nowrap</whiteSpace>
              </style>
              <label>HOURS</label>
            </hd>
            <hd id="es-h-income-total">
              <style>
                <width>24%</width>
                <textAlign>right</textAlign>
                <fontSize>11px</fontSize>
                <fontWeight>bold</fontWeight>
                <padding>5px 10px</padding>
                <borderBottom>1px solid #000000</borderBottom>
                <whiteSpace>nowrap</whiteSpace>
              </style>
              <label>CURRENT TOTAL</label>
            </hd>
          </hdata>
        </header>
        <cells>
          <rowcells>
            <cell id="es-wages-desc" type="static">
              <style>
                <textAlign>left</textAlign>
                <padding>4px 10px</padding>
              </style>
              <value>GROSS WAGES</value>
            </cell>
            <cell id="es-wages-rate" type="substitute" format="number">
              <style>
                <textAlign>center</textAlign>
                <padding>4px 10px</padding>
              </style>
              <value>{incomeDetails.hourlyRate}</value>
            </cell>
            <cell id="es-wages-hours" type="substitute" format="number">
              <style>
                <textAlign>center</textAlign>
                <padding>4px 10px</padding>
              </style>
              <value>{incomeDetails.hoursWorked}</value>
            </cell>
            <cell id="es-wages-total" type="substitute" format="number">
              <style>
                <textAlign>right</textAlign>
                <padding>4px 10px</padding>
              </style>
              <value>{regularPay}</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="es-ot-desc" type="static">
              <style>
                <textAlign>left</textAlign>
                <padding>4px 10px</padding>
              </style>
              <value>OVERTIME</value>
            </cell>
            <cell id="es-ot-rate" type="substitute" format="number">
              <style>
                <textAlign>center</textAlign>
                <padding>4px 10px</padding>
              </style>
              <value>{incomeDetails.overtimeRate}</value>
            </cell>
            <cell id="es-ot-hours" type="substitute" format="number">
              <style>
                <textAlign>center</textAlign>
                <padding>4px 10px</padding>
              </style>
              <value>{incomeDetails.overtimeHours}</value>
            </cell>
            <cell id="es-ot-total" type="substitute" format="number">
              <style>
                <textAlign>right</textAlign>
                <padding>4px 10px</padding>
              </style>
              <value>{overtimePay}</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="es-bonus-desc" type="static">
              <style>
                <textAlign>left</textAlign>
                <padding>4px 10px</padding>
              </style>
              <value>BONUS</value>
            </cell>
            <cell id="es-bonus-rate" type="static">
              <style>
                <padding>4px 10px</padding>
              </style>
              <value> </value>
            </cell>
            <cell id="es-bonus-hours" type="static">
              <style>
                <padding>4px 10px</padding>
              </style>
              <value> </value>
            </cell>
            <cell id="es-bonus-total" type="substitute" format="number">
              <style>
                <textAlign>right</textAlign>
                <padding>4px 10px</padding>
              </style>
              <value>{otherEarnings}</value>
            </cell>
          </rowcells>
        </cells>
      </table>
    </column>
    <column id="es-deductions-col" width="50%">
      <table id="es-deductions-table">
        <style>
          <width>100%</width>
        </style>
        <header>
          <hdata>
            <hd id="es-h-deductions">
              <style>
                <width>40%</width>
                <textAlign>left</textAlign>
                <fontSize>11px</fontSize>
                <fontWeight>bold</fontWeight>
                <padding>5px 10px</padding>
                <borderBottom>1px solid #000000</borderBottom>
                <whiteSpace>nowrap</whiteSpace>
              </style>
              <label>DEDUCTIONS</label>
            </hd>
            <hd id="es-h-ded-current">
              <style>
                <width>30%</width>
                <textAlign>right</textAlign>
                <fontSize>11px</fontSize>
                <fontWeight>bold</fontWeight>
                <padding>5px 10px</padding>
                <borderBottom>1px solid #000000</borderBottom>
                <whiteSpace>nowrap</whiteSpace>
              </style>
              <label>CURRENT TOTAL</label>
            </hd>
            <hd id="es-h-ded-ytd">
              <style>
                <width>30%</width>
                <textAlign>right</textAlign>
                <fontSize>11px</fontSize>
                <fontWeight>bold</fontWeight>
                <padding>5px 10px</padding>
                <borderBottom>1px solid #000000</borderBottom>
                <whiteSpace>nowrap</whiteSpace>
              </style>
              <label>YEAR-TO-DATE</label>
            </hd>
          </hdata>
        </header>
        <cells>
          <rowcells>
            <cell id="es-fica-med-desc" type="static">
              <style>
                <textAlign>left</textAlign>
                <padding>4px 10px</padding>
              </style>
              <value>FICA MED TAX</value>
            </cell>
            <cell id="es-fica-med-current" type="substitute" format="number">
              <style>
                <textAlign>right</textAlign>
                <padding>4px 10px</padding>
              </style>
              <value>{medicare}</value>
            </cell>
            <cell id="es-fica-med-ytd" type="substitute" format="number">
              <style>
                <textAlign>right</textAlign>
                <padding>4px 10px</padding>
              </style>
              <value>{medicareYTD}</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="es-fica-ss-desc" type="static">
              <style>
                <textAlign>left</textAlign>
                <padding>4px 10px</padding>
              </style>
              <value>FICA SS TAX</value>
            </cell>
            <cell id="es-fica-ss-current" type="substitute" format="number">
              <style>
                <textAlign>right</textAlign>
                <padding>4px 10px</padding>
              </style>
              <value>{socialSecurity}</value>
            </cell>
            <cell id="es-fica-ss-ytd" type="substitute" format="number">
              <style>
                <textAlign>right</textAlign>
                <padding>4px 10px</padding>
              </style>
              <value>{socialSecurityYTD}</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="es-fed-desc" type="static">
              <style>
                <textAlign>left</textAlign>
                <padding>4px 10px</padding>
              </style>
              <value>FED TAX</value>
            </cell>
            <cell id="es-fed-current" type="substitute" format="number">
              <style>
                <textAlign>right</textAlign>
                <padding>4px 10px</padding>
              </style>
              <value>{federalTax}</value>
            </cell>
            <cell id="es-fed-ytd" type="substitute" format="number">
              <style>
                <textAlign>right</textAlign>
                <padding>4px 10px</padding>
              </style>
              <value>{federalTaxYTD}</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="es-state-desc" type="substitute">
              <style>
                <textAlign>left</textAlign>
                <padding>4px 10px</padding>
              </style>
              <value>{stateTaxLabel}</value>
            </cell>
            <cell id="es-state-current" type="substitute" format="number">
              <style>
                <textAlign>right</textAlign>
                <padding>4px 10px</padding>
              </style>
              <value>{stateTax}</value>
            </cell>
            <cell id="es-state-ytd" type="substitute" format="number">
              <style>
                <textAlign>right</textAlign>
                <padding>4px 10px</padding>
              </style>
              <value>{stateTaxYTD}</value>
            </cell>
          </rowcells>
        </cells>
      </table>
    </column>
  </section>
  <!-- Section es-summary-section -->
  <section id="es-summary-section">
    <style>
      <borderTop>1px solid #000000</borderTop>
    </style>
    <column id="es-summary-col" width="100%">
      <table id="es-summary-table">
        <style>
          <width>100%</width>
        </style>
        <header>
          <hdata>
            <hd id="es-h-ytd-gross">
              <style>
                <width>15%</width>
                <textAlign>left</textAlign>
                <fontSize>11px</fontSize>
                <fontWeight>bold</fontWeight>
                <padding>5px 10px</padding>
                <borderBottom>1px solid #000000</borderBottom>
                <whiteSpace>nowrap</whiteSpace>
              </style>
              <label>YTD GROSS</label>
            </hd>
            <hd id="es-h-ytd-deductions">
              <style>
                <width>18%</width>
                <textAlign>center</textAlign>
                <fontSize>11px</fontSize>
                <fontWeight>bold</fontWeight>
                <padding>5px 10px</padding>
                <borderBottom>1px solid #000000</borderBottom>
                <whiteSpace>nowrap</whiteSpace>
              </style>
              <label>YTD DEDUCTIONS</label>
            </hd>
            <hd id="es-h-ytd-net">
              <style>
                <width>17%</width>
                <textAlign>center</textAlign>
                <fontSize>11px</fontSize>
                <fontWeight>bold</fontWeight>
                <padding>5px 10px</padding>
                <borderBottom>1px solid #000000</borderBottom>
                <whiteSpace>nowrap</whiteSpace>
              </style>
              <label>YTD NET PAY</label>
            </hd>
            <hd id="es-h-cur-total">
              <style>
                <width>15%</width>
                <textAlign>center</textAlign>
                <fontSize>11px</fontSize>
                <fontWeight>bold</fontWeight>
                <padding>5px 10px</padding>
                <borderBottom>1px solid #000000</borderBottom>
                <borderLeft>1px solid #000000</borderLeft>
                <whiteSpace>nowrap</whiteSpace>
              </style>
              <label>CURRENT TOTAL</label>
            </hd>
            <hd id="es-h-cur-deductions">
              <style>
                <width>21%</width>
                <textAlign>center</textAlign>
                <fontSize>11px</fontSize>
                <fontWeight>bold</fontWeight>
                <padding>5px 10px</padding>
                <borderBottom>1px solid #000000</borderBottom>
                <whiteSpace>nowrap</whiteSpace>
              </style>
              <label>CURRENT DEDUCTIONS</label>
            </hd>
            <hd id="es-h-net">
              <style>
                <width>14%</width>
                <textAlign>right</textAlign>
                <fontSize>11px</fontSize>
                <fontWeight>bold</fontWeight>
                <padding>5px 10px</padding>
                <borderBottom>1px solid #000000</borderBottom>
                <whiteSpace>nowrap</whiteSpace>
              </style>
              <label>NET PAY</label>
            </hd>
          </hdata>
        </header>
        <cells>
          <rowcells>
            <cell id="es-v-ytd-gross" type="substitute" format="number">
              <style>
                <textAlign>left</textAlign>
                <padding>6px 10px</padding>
              </style>
              <value>{grossPayYTD}</value>
            </cell>
            <cell id="es-v-ytd-deductions" type="calculated" format="number">
              <style>
                <textAlign>center</textAlign>
                <padding>6px 10px</padding>
              </style>
              <formula>{totalTaxesYTD} + {totalDeductionsYTD}</formula>
            </cell>
            <cell id="es-v-ytd-net" type="substitute" format="number">
              <style>
                <textAlign>center</textAlign>
                <padding>6px 10px</padding>
              </style>
              <value>{netPayYTD}</value>
            </cell>
            <cell id="es-v-cur-total" type="substitute" format="number">
              <style>
                <textAlign>center</textAlign>
                <padding>6px 10px</padding>
                <borderLeft>1px solid #000000</borderLeft>
              </style>
              <value>{grossPay}</value>
            </cell>
            <cell id="es-v-cur-deductions" type="calculated" format="number">
              <style>
                <textAlign>center</textAlign>
                <padding>6px 10px</padding>
              </style>
              <formula>{totalTaxes} + {totalDeductions}</formula>
            </cell>
            <cell id="es-v-net" type="substitute" format="number">
              <style>
                <textAlign>right</textAlign>
                <padding>6px 10px</padding>
              </style>
              <value>{netPay}</value>
            </cell>
          </rowcells>
        </cells>
      </table>
    </column>
  </section>
</paystub>
