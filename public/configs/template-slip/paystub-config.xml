            </cell>
          </rowcells>
          <rowcells renderIf="companyInfo.companyEIN">
            <cell id="sl-head-r3c0" type="substitute">
              <style>
                <textAlign>center</textAlign>
                <padding>0</padding>
                <whiteSpace>normal</whiteSpace>
                <fontSize>10.5px</fontSize>
                <color>#6B6B6B</color>
              </style>
              <value>EIN {companyInfo.companyEIN}</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="sl-head-r4c0" type="static">
              <style>
                <textAlign>center</textAlign>
                <padding>0</padding>
                <whiteSpace>normal</whiteSpace>
                <fontSize>13px</fontSize>
                <fontWeight>700</fontWeight>
                <letterSpacing>6px</letterSpacing>
                <paddingTop>10px</paddingTop>
              </style>
