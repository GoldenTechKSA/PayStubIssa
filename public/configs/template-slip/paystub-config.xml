<?xml version='1.0' encoding='utf-8'?>
<paystub>
  <!--
    Pay Slip, Compact (slip). One narrow, centred slip inside a single outline, read top to bottom like a
    till receipt: employer, the slip's particulars as label / value pairs, earnings, taxes, deductions, and a
    boxed net pay, with dashed rules between the parts. Every amount is in one right-hand column, with year
    to date beside it. Roboto, black and gray only, no logo.
    Designed for the 720 x 960 px printable area of a US Letter sheet (see CLAUDE.md, "one stub, one sheet").
  -->
  <style>
    <fontFamily>Roboto, 'Helvetica Neue', Arial, sans-serif</fontFamily>
    <color>#1A1A1A</color>
    <fontSize>11px</fontSize>
    <lineHeight>1.35</lineHeight>
    <backgroundColor>#ffffff</backgroundColor>
    <padding>8px 0 0</padding>
  </style>
  <!-- Section sl-slip: the whole slip in one outlined, centred column -->
  <section id="sl-slip">
    <style>
      <justifyContent>center</justifyContent>
    </style>
    <column id="sl-col" width="60%">
      <style>
        <border>1px solid #1A1A1A</border>
        <padding>18px 26px 14px</padding>
      </style>
      <table id="sl-head">
        <style>
          <width>100%</width>
        </style>
        <cells>
          <rowcells>
            <cell id="sl-head-r0c0" type="substitute">
              <style>
                <textAlign>center</textAlign>
                <padding>0</padding>
                <whiteSpace>normal</whiteSpace>
                <fontSize>16px</fontSize>
                <fontWeight>700</fontWeight>
                <lineHeight>1.2</lineHeight>
              </style>
              <value>{companyInfo.companyName}</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="sl-head-r1c0" type="substitute">
              <style>
                <textAlign>center</textAlign>
                <padding>0</padding>
                <whiteSpace>normal</whiteSpace>
                <fontSize>10.5px</fontSize>
                <color>#6B6B6B</color>
                <paddingTop>2px</paddingTop>
              </style>
              <value>{companyInfo.companyAddress1} {companyInfo.companyAddress2}</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="sl-head-r2c0" type="substitute">
