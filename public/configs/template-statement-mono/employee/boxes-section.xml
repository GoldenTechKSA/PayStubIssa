<?xml version='1.0' encoding='utf-8'?>
<!-- The two outlined boxes. The outline lives on the COLUMN so the tables stacked inside
     compose into one box, and flex stretch keeps both boxes the same height. -->
<section id="sm-boxes-section">
    <style><justifyContent>space-between</justifyContent></style>

    <column id="sm-employee-box" width="64%">
        <style><border>1px solid #000000</border><padding>10px 12px</padding></style>
        <table id="sm-employee-table">
            <style><width>100%</width></style>
            <cells>
                <rowcells>
                    <cell id="sm-emp-name-label" type="static"><style><textAlign>left</textAlign><fontSize>12px</fontSize><fontWeight>600</fontWeight><padding>2px 0</padding><whiteSpace>nowrap</whiteSpace></style><value>Employee Name:</value></cell>
                    <cell id="sm-emp-name-value" type="substitute"><style><textAlign>left</textAlign><fontSize>12px</fontSize><padding>2px 0 2px 16px</padding><width>100%</width></style><value>{employeeInfo.employeeFirstName} {employeeInfo.employeeLastName}</value></cell>
                </rowcells>
                <rowcells>
                    <cell id="sm-emp-ssn-label" type="static"><style><textAlign>left</textAlign><fontSize>12px</fontSize><fontWeight>600</fontWeight><padding>2px 0</padding><whiteSpace>nowrap</whiteSpace></style><value>Employee Social:</value></cell>
                    <cell id="sm-emp-ssn-value" type="substitute"><style><textAlign>left</textAlign><fontSize>12px</fontSize><padding>2px 0 2px 16px</padding></style><value>{employeeSSNMasked}</value></cell>
                </rowcells>
                <rowcells>
                    <cell id="sm-emp-id-label" type="static"><style><textAlign>left</textAlign><fontSize>12px</fontSize><fontWeight>600</fontWeight><padding>2px 0</padding><whiteSpace>nowrap</whiteSpace></style><value>Employee ID:</value></cell>
                    <cell id="sm-emp-id-value" type="substitute"><style><textAlign>left</textAlign><fontSize>12px</fontSize><padding>2px 0 2px 16px</padding></style><value>{employeeInfo.employeeID}</value></cell>
                </rowcells>
                <rowcells>
                    <cell id="sm-emp-addr-label" type="static"><style><textAlign>left</textAlign><fontSize>12px</fontSize><fontWeight>600</fontWeight><padding>2px 0</padding><whiteSpace>nowrap</whiteSpace></style><value>Employee Address:</value></cell>
                    <cell id="sm-emp-addr-value" type="substitute"><style><textAlign>left</textAlign><fontSize>12px</fontSize><padding>2px 0 2px 16px</padding></style><value>{employeeInfo.employeeAddress1}</value></cell>
                </rowcells>
                <rowcells>
                    <cell id="sm-emp-addr2-label" type="static"><style><padding>2px 0</padding></style><value> </value></cell>
                    <cell id="sm-emp-addr2-value" type="substitute"><style><textAlign>left</textAlign><fontSize>12px</fontSize><padding>2px 0 2px 16px</padding></style><value>{employeeAddressLine}</value></cell>
                </rowcells>
            </cells>
        </table>
    </column>

    <column id="sm-schedule-box" width="33%">
        <style><border>1px solid #000000</border><padding>10px 12px</padding></style>
        <table id="sm-schedule-table">
            <style><width>100%</width></style>
            <cells>
                <rowcells>
                    <cell id="sm-sch-type-label" type="static"><style><textAlign>left</textAlign><fontSize>12px</fontSize><fontWeight>600</fontWeight><padding>2px 0</padding><whiteSpace>nowrap</whiteSpace></style><value>Pay Schedule:</value></cell>
                    <cell id="sm-sch-type-value" type="substitute"><style><textAlign>left</textAlign><fontSize>12px</fontSize><padding>2px 0 2px 8px</padding><width>100%</width></style><value>{incomeDetails.periodType}</value></cell>
                </rowcells>
                <rowcells>
                    <cell id="sm-sch-beg-label" type="static"><style><textAlign>left</textAlign><fontSize>12px</fontSize><fontWeight>600</fontWeight><padding>2px 0</padding><whiteSpace>nowrap</whiteSpace></style><value>Period Beg:</value></cell>
                    <cell id="sm-sch-beg-value" type="substitute" format="date"><style><textAlign>left</textAlign><fontSize>12px</fontSize><padding>2px 0 2px 8px</padding></style><value>{incomeDetails.periodStartDate}</value></cell>
                </rowcells>
                <rowcells>
                    <cell id="sm-sch-end-label" type="static"><style><textAlign>left</textAlign><fontSize>12px</fontSize><fontWeight>600</fontWeight><padding>2px 0</padding><whiteSpace>nowrap</whiteSpace></style><value>Period End:</value></cell>
                    <cell id="sm-sch-end-value" type="substitute" format="date"><style><textAlign>left</textAlign><fontSize>12px</fontSize><padding>2px 0 2px 8px</padding></style><value>{incomeDetails.periodEndDate}</value></cell>
                </rowcells>
                <rowcells>
                    <cell id="sm-sch-pay-label" type="static"><style><textAlign>left</textAlign><fontSize>12px</fontSize><fontWeight>600</fontWeight><padding>2px 0</padding><whiteSpace>nowrap</whiteSpace></style><value>Pay Date:</value></cell>
                    <cell id="sm-sch-pay-value" type="substitute" format="date"><style><textAlign>left</textAlign><fontSize>12px</fontSize><padding>2px 0 2px 8px</padding></style><value>{incomeDetails.periodPayDate}</value></cell>
                </rowcells>
            </cells>
        </table>
    </column>
</section>
