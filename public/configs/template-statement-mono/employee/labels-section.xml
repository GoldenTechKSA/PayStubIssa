<?xml version='1.0' encoding='utf-8'?>
<!-- The two italic captions that sit above the outlined boxes, on the same 60/39 grid. -->
<section id="sm-labels-section">
    <style><marginTop>30px</marginTop><justifyContent>space-between</justifyContent></style>
    <column id="sm-label-employee" width="64%">
        <table id="sm-label-employee-table">
            <style><width>100%</width></style>
            <cells>
                <rowcells>
                    <cell id="sm-label-employee-text" type="static"><style><textAlign>left</textAlign><fontSize>14px</fontSize><fontStyle>italic</fontStyle><padding>0 0 6px</padding></style><value>Employee Information</value></cell>
                </rowcells>
            </cells>
        </table>
    </column>
    <column id="sm-label-schedule" width="33%">
        <table id="sm-label-schedule-table">
            <style><width>100%</width></style>
            <cells>
                <rowcells>
                    <cell id="sm-label-schedule-text" type="static"><style><textAlign>left</textAlign><fontSize>14px</fontSize><fontStyle>italic</fontStyle><padding>0 0 6px</padding></style><value>Pay Schedule</value></cell>
                </rowcells>
            </cells>
        </table>
    </column>
</section>
