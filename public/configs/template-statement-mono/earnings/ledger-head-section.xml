<?xml version='1.0' encoding='utf-8'?>
<!-- Header band. The two rules are the section-s own borders, so they cross the gap
     between the earnings and withholdings groups as one continuous line; the body below
     repeats these exact column widths so every figure sits under its heading. -->
<section id="sm-ledger-head">
    <style><borderTop>2px solid #000000</borderTop><borderBottom>2px solid #000000</borderBottom><justifyContent>space-between</justifyContent></style>
    <column id="sm-ledger-head-earnings" width="57%">
        <table id="sm-ledger-head-earnings-table">
            <style><width>100%</width><tableLayout>fixed</tableLayout></style>
            <cells>
                <rowcells>
                    <cell id="sm-eh-a1" type="static"><style><width>62%</width><padding>5px 4px 0</padding></style><value> </value></cell>
                    <cell id="sm-eh-a2" type="static"><style><width>10%</width><padding>5px 4px 0</padding></style><value> </value></cell>
                    <cell id="sm-eh-a3" type="static"><style><width>13%</width><padding>5px 4px 0</padding></style><value> </value></cell>
                    <cell id="sm-eh-a4" type="static"><style><width>15%</width><textAlign>center</textAlign><fontSize>9px</fontSize><fontWeight>600</fontWeight><padding>5px 4px 0</padding><whiteSpace>nowrap</whiteSpace></style><value>CURRENT</value></cell>
                </rowcells>
                <rowcells>
                    <cell id="sm-eh-b1" type="static"><style><width>62%</width><textAlign>center</textAlign><fontSize>9px</fontSize><fontWeight>600</fontWeight><padding>0 4px 5px</padding><whiteSpace>nowrap</whiteSpace></style><value>EARNINGS</value></cell>
                    <cell id="sm-eh-b2" type="static"><style><width>10%</width><textAlign>center</textAlign><fontSize>9px</fontSize><fontWeight>600</fontWeight><padding>0 4px 5px</padding><whiteSpace>nowrap</whiteSpace></style><value>HOURS</value></cell>
                    <cell id="sm-eh-b3" type="static"><style><width>13%</width><textAlign>center</textAlign><fontSize>9px</fontSize><fontWeight>600</fontWeight><padding>0 4px 5px</padding><whiteSpace>nowrap</whiteSpace></style><value>RATE</value></cell>
                    <cell id="sm-eh-b4" type="static"><style><width>15%</width><textAlign>center</textAlign><fontSize>9px</fontSize><fontWeight>600</fontWeight><padding>0 4px 5px</padding><whiteSpace>nowrap</whiteSpace></style><value>AMOUNT</value></cell>
                </rowcells>
            </cells>
        </table>
    </column>
    <column id="sm-ledger-head-withholdings" width="42%">
        <table id="sm-ledger-head-withholdings-table">
            <style><width>100%</width><tableLayout>fixed</tableLayout></style>
            <cells>
                <rowcells>
                    <cell id="sm-wh-a1" type="static"><style><width>50%</width><textAlign>center</textAlign><fontSize>9px</fontSize><fontWeight>600</fontWeight><padding>5px 4px 0</padding><whiteSpace>nowrap</whiteSpace></style><value>WITHHOLDINGS/</value></cell>
                    <cell id="sm-wh-a2" type="static"><style><width>22%</width><textAlign>center</textAlign><fontSize>9px</fontSize><fontWeight>600</fontWeight><padding>5px 4px 0</padding><whiteSpace>nowrap</whiteSpace></style><value>CURRENT</value></cell>
                    <cell id="sm-wh-a3" type="static"><style><width>28%</width><textAlign>center</textAlign><fontSize>9px</fontSize><fontWeight>600</fontWeight><padding>5px 4px 0</padding><whiteSpace>nowrap</whiteSpace></style><value>YTD</value></cell>
                </rowcells>
                <rowcells>
                    <cell id="sm-wh-b1" type="static"><style><width>50%</width><textAlign>center</textAlign><fontSize>9px</fontSize><fontWeight>600</fontWeight><padding>0 4px 5px</padding><whiteSpace>nowrap</whiteSpace></style><value>DEDUCTIONS</value></cell>
                    <cell id="sm-wh-b2" type="static"><style><width>22%</width><textAlign>center</textAlign><fontSize>9px</fontSize><fontWeight>600</fontWeight><padding>0 4px 5px</padding><whiteSpace>nowrap</whiteSpace></style><value>AMOUNT</value></cell>
                    <cell id="sm-wh-b3" type="static"><style><width>28%</width><textAlign>center</textAlign><fontSize>9px</fontSize><fontWeight>600</fontWeight><padding>0 4px 5px</padding><whiteSpace>nowrap</whiteSpace></style><value>AMOUNT</value></cell>
                </rowcells>
            </cells>
        </table>
    </column>
</section>
