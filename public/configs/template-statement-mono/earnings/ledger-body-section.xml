<?xml version='1.0' encoding='utf-8'?>
<!-- Ledger body, on the same column widths as the header band above.

     The wage-type branch is two mutually exclusive tables: a salaried stub prints SALARY
     with Hours and Rate left blank, an hourly one prints REGULAR with both filled.
     Overtime and bonus follow only when non-zero. -->
<section id="sm-ledger-body">
    <style><justifyContent>space-between</justifyContent><minHeight>104px</minHeight><paddingTop>8px</paddingTop></style>

    <column id="sm-ledger-body-earnings" width="57%">
        <table id="sm-earn-salary" renderIf="isSalaried">
            <style><width>100%</width><tableLayout>fixed</tableLayout></style>
            <cells>
                <rowcells>
                    <cell id="sm-earn-salary-desc" type="static"><style><width>62%</width><textAlign>left</textAlign><fontSize>10px</fontSize><padding>3px 4px 3px 0</padding></style><value>SALARY</value></cell>
                    <cell id="sm-earn-salary-hours" type="static"><style><width>10%</width><padding>3px 4px</padding></style><value> </value></cell>
                    <cell id="sm-earn-salary-rate" type="static"><style><width>13%</width><padding>3px 4px</padding></style><value> </value></cell>
                    <cell id="sm-earn-salary-amt" type="substitute" format="currency"><style><width>15%</width><textAlign>right</textAlign><fontSize>10px</fontSize><padding>3px 4px</padding></style><value>{regularPay}</value></cell>
                </rowcells>
            </cells>
        </table>
        <table id="sm-earn-regular" renderIf="isHourly">
            <style><width>100%</width><tableLayout>fixed</tableLayout></style>
            <cells>
                <rowcells>
                    <cell id="sm-earn-regular-desc" type="static"><style><width>62%</width><textAlign>left</textAlign><fontSize>10px</fontSize><padding>3px 4px 3px 0</padding></style><value>REGULAR</value></cell>
                    <cell id="sm-earn-regular-hours" type="substitute" format="number"><style><width>10%</width><textAlign>right</textAlign><fontSize>10px</fontSize><padding>3px 4px</padding></style><value>{incomeDetails.hoursWorked}</value></cell>
                    <cell id="sm-earn-regular-rate" type="substitute" format="number"><style><width>13%</width><textAlign>right</textAlign><fontSize>10px</fontSize><padding>3px 4px</padding></style><value>{incomeDetails.hourlyRate}</value></cell>
                    <cell id="sm-earn-regular-amt" type="substitute" format="currency"><style><width>15%</width><textAlign>right</textAlign><fontSize>10px</fontSize><padding>3px 4px</padding></style><value>{regularPay}</value></cell>
                </rowcells>
            </cells>
        </table>
        <table id="sm-earn-overtime" renderIf="overtimePay">
            <style><width>100%</width><tableLayout>fixed</tableLayout></style>
            <cells>
                <rowcells>
                    <cell id="sm-earn-overtime-desc" type="static"><style><width>62%</width><textAlign>left</textAlign><fontSize>10px</fontSize><padding>3px 4px 3px 0</padding></style><value>OVERTIME</value></cell>
                    <cell id="sm-earn-overtime-hours" type="substitute" format="number"><style><width>10%</width><textAlign>right</textAlign><fontSize>10px</fontSize><padding>3px 4px</padding></style><value>{incomeDetails.overtimeHours}</value></cell>
                    <cell id="sm-earn-overtime-rate" type="substitute" format="number"><style><width>13%</width><textAlign>right</textAlign><fontSize>10px</fontSize><padding>3px 4px</padding></style><value>{incomeDetails.overtimeRate}</value></cell>
                    <cell id="sm-earn-overtime-amt" type="substitute" format="currency"><style><width>15%</width><textAlign>right</textAlign><fontSize>10px</fontSize><padding>3px 4px</padding></style><value>{overtimePay}</value></cell>
                </rowcells>
            </cells>
        </table>
        <table id="sm-earn-bonus" renderIf="otherEarnings">
            <style><width>100%</width><tableLayout>fixed</tableLayout></style>
            <cells>
                <rowcells>
                    <cell id="sm-earn-bonus-desc" type="static"><style><width>62%</width><textAlign>left</textAlign><fontSize>10px</fontSize><padding>3px 4px 3px 0</padding></style><value>BONUS</value></cell>
                    <cell id="sm-earn-bonus-hours" type="static"><style><width>10%</width><padding>3px 4px</padding></style><value> </value></cell>
                    <cell id="sm-earn-bonus-rate" type="static"><style><width>13%</width><padding>3px 4px</padding></style><value> </value></cell>
                    <cell id="sm-earn-bonus-amt" type="substitute" format="currency"><style><width>15%</width><textAlign>right</textAlign><fontSize>10px</fontSize><padding>3px 4px</padding></style><value>{otherEarnings}</value></cell>
                </rowcells>
            </cells>
        </table>
    </column>

    <column id="sm-ledger-body-withholdings" width="42%">
        <table id="sm-ded-table">
            <style><width>100%</width><tableLayout>fixed</tableLayout></style>
            <cells>
                <rowcells>
                    <cell id="sm-ded-fed-desc" type="static"><style><width>50%</width><textAlign>left</textAlign><fontSize>10px</fontSize><padding>3px 4px 3px 0</padding></style><value>Federal Tax</value></cell>
                    <cell id="sm-ded-fed-cur" type="substitute" format="currency"><style><width>22%</width><textAlign>right</textAlign><fontSize>10px</fontSize><padding>3px 4px</padding></style><value>{federalTax}</value></cell>
                    <cell id="sm-ded-fed-ytd" type="substitute" format="currency"><style><width>28%</width><textAlign>right</textAlign><fontSize>10px</fontSize><padding>3px 4px</padding></style><value>{federalTaxYTD}</value></cell>
                </rowcells>
                <rowcells>
                    <cell id="sm-ded-med-desc" type="static"><style><width>50%</width><textAlign>left</textAlign><fontSize>10px</fontSize><padding>3px 4px 3px 0</padding></style><value>FICA - Medicare</value></cell>
                    <cell id="sm-ded-med-cur" type="substitute" format="currency"><style><width>22%</width><textAlign>right</textAlign><fontSize>10px</fontSize><padding>3px 4px</padding></style><value>{medicare}</value></cell>
                    <cell id="sm-ded-med-ytd" type="substitute" format="currency"><style><width>28%</width><textAlign>right</textAlign><fontSize>10px</fontSize><padding>3px 4px</padding></style><value>{medicareYTD}</value></cell>
                </rowcells>
                <rowcells>
                    <cell id="sm-ded-ss-desc" type="static"><style><width>50%</width><textAlign>left</textAlign><fontSize>10px</fontSize><padding>3px 4px 3px 0</padding></style><value>FICA - Social Security</value></cell>
                    <cell id="sm-ded-ss-cur" type="substitute" format="currency"><style><width>22%</width><textAlign>right</textAlign><fontSize>10px</fontSize><padding>3px 4px</padding></style><value>{socialSecurity}</value></cell>
                    <cell id="sm-ded-ss-ytd" type="substitute" format="currency"><style><width>28%</width><textAlign>right</textAlign><fontSize>10px</fontSize><padding>3px 4px</padding></style><value>{socialSecurityYTD}</value></cell>
                </rowcells>
                <rowcells>
                    <cell id="sm-ded-st-desc" type="substitute"><style><width>50%</width><textAlign>left</textAlign><fontSize>10px</fontSize><padding>3px 4px 3px 0</padding></style><value>{employeeStateCode} State Tax</value></cell>
                    <cell id="sm-ded-st-cur" type="substitute" format="currency"><style><width>22%</width><textAlign>right</textAlign><fontSize>10px</fontSize><padding>3px 4px</padding></style><value>{stateTax}</value></cell>
                    <cell id="sm-ded-st-ytd" type="substitute" format="currency"><style><width>28%</width><textAlign>right</textAlign><fontSize>10px</fontSize><padding>3px 4px</padding></style><value>{stateTaxYTD}</value></cell>
                </rowcells>
            </cells>
        </table>
        <table id="sm-ded-paid-leave" renderIf="paidLeave">
            <style><width>100%</width><tableLayout>fixed</tableLayout></style>
            <cells>
                <rowcells>
                    <cell id="sm-ded-pfml-desc" type="substitute"><style><width>50%</width><textAlign>left</textAlign><fontSize>10px</fontSize><padding>3px 4px 3px 0</padding></style><value>{paidLeaveLabel}</value></cell>
                    <cell id="sm-ded-pfml-cur" type="substitute" format="currency"><style><width>22%</width><textAlign>right</textAlign><fontSize>10px</fontSize><padding>3px 4px</padding></style><value>{paidLeave}</value></cell>
                    <cell id="sm-ded-pfml-ytd" type="substitute" format="currency"><style><width>28%</width><textAlign>right</textAlign><fontSize>10px</fontSize><padding>3px 4px</padding></style><value>{paidLeaveYTD}</value></cell>
                </rowcells>
            </cells>
        </table>
    </column>
</section>
