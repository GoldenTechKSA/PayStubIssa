<?xml version='1.0' encoding='utf-8'?>
<!-- Footer disclaimer, separated by a hairline top rule. Small, muted gray text. -->
<section id="modern-footer-section">
    <style><marginTop>28px</marginTop><paddingTop>10px</paddingTop><borderTop>1px solid #d1d5db</borderTop></style>
    <column id="modern-footer-col" width="100%">
        <table id="modern-footer-table">
            <style><width>100%</width></style>
            <cells>
                <rowcells>
                    <cell id="disclaimer-text" type="static"><style><fontSize>10px</fontSize><color>#6b7280</color><textAlign>center</textAlign></style><value>This statement is for informational purposes only and is not a negotiable instrument.</value></cell>
                </rowcells>
                <rowcells>
                    <cell id="record-text" type="static"><style><fontSize>10px</fontSize><color>#6b7280</color><textAlign>center</textAlign></style><value>Please retain for your records.</value></cell>
                </rowcells>
                <rowcells>
                    <cell id="contact-text" type="substitute"><style><fontSize>10px</fontSize><color>#6b7280</color><textAlign>center</textAlign></style><value>{companyInfo.companyName} · {companyInfo.companyPhone}</value></cell>
                </rowcells>
            </cells>
        </table>
    </column>
</section>
