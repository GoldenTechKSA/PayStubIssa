<?xml version='1.0' encoding='utf-8'?>
<!-- Modern header: dark grayscale band with logo + company brand (left) and
     statement title + pay date (right). Color is inherited white from the
     section; the band itself reads strong on a black-and-white printer. -->
<section id="modern-header-section">
    <style>
        <backgroundColor>#111827</backgroundColor>
        <color>#ffffff</color>
        <padding>20px</padding>
        <alignItems>center</alignItems>
    </style>
    <column id="modern-header-brand" width="60%">
        <table id="modern-brand-table">
            <style><width>100%</width></style>
            <cells>
                <rowcells>
                    <cell id="company-logo" type="image">
                        <style>
                            <maxHeight>48px</maxHeight>
                            <maxWidth>160px</maxWidth>
                            <textAlign>left</textAlign>
                        </style>
                        <value>{companyInfo.companyLogo}</value>
                    </cell>
                </rowcells>
                <rowcells>
                    <cell id="company-name" type="substitute">
                        <style>
                            <fontSize>22px</fontSize>
                            <fontWeight>bold</fontWeight>
                            <textAlign>left</textAlign>
                        </style>
                        <value>{companyInfo.companyName}</value>
                    </cell>
                </rowcells>
                <rowcells>
                    <cell id="company-address" type="substitute">
                        <style><fontSize>11px</fontSize><textAlign>left</textAlign></style>
                        <value>{companyInfo.companyAddress1}, {companyInfo.companyCity} {companyInfo.companyState} {companyInfo.companyZipCode}</value>
                    </cell>
                </rowcells>
                <rowcells>
                    <cell id="company-ein" type="substitute">
                        <style><fontSize>11px</fontSize><textAlign>left</textAlign></style>
                        <value>EIN {companyInfo.companyEIN}</value>
                    </cell>
                </rowcells>
            </cells>
        </table>
    </column>
    <column id="modern-header-meta" width="40%">
        <table id="modern-meta-table">
            <style><width>100%</width></style>
            <cells>
                <rowcells>
                    <cell id="statement-title" colspan="2" type="static">
                        <style>
                            <fontSize>22px</fontSize>
                            <fontWeight>bold</fontWeight>
                            <textAlign>right</textAlign>
                            <letterSpacing>2px</letterSpacing>
                        </style>
                        <value>PAY STATEMENT</value>
                    </cell>
                </rowcells>
                <rowcells>
                    <cell id="meta-paydate-label" type="static"><style><textAlign>right</textAlign><fontSize>11px</fontSize></style><value>Pay Date</value></cell>
                    <cell id="meta-paydate-value" type="substitute" format="date"><style><textAlign>right</textAlign><fontSize>11px</fontSize><fontWeight>bold</fontWeight></style><value>{incomeDetails.periodPayDate}</value></cell>
                </rowcells>
                <rowcells>
                    <cell id="meta-stub-label" type="static"><style><textAlign>right</textAlign><fontSize>11px</fontSize></style><value>Pay Stub No.</value></cell>
                    <cell id="meta-stub-value" type="substitute"><style><textAlign>right</textAlign><fontSize>11px</fontSize><fontWeight>bold</fontWeight></style><value>{generalInfo.payStubNumber}</value></cell>
                </rowcells>
            </cells>
        </table>
    </column>
</section>
