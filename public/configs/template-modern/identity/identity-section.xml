<?xml version='1.0' encoding='utf-8'?>
<!-- Employee (left) and pay-period (right) identity strip, separated from the
     earnings below by a hairline rule. Dates use dedicated format="date" cells. -->
<section id="modern-identity-section">
    <style>
        <marginTop>20px</marginTop>
        <paddingBottom>12px</paddingBottom>
        <borderBottom>1px solid #d1d5db</borderBottom>
    </style>
    <column id="modern-employee" width="60%">
        <table id="modern-employee-table">
            <style><width>100%</width></style>
            <header title="EMPLOYEE">
                <style>
                    <fontSize>12px</fontSize>
                    <fontWeight>bold</fontWeight>
                    <color>#374151</color>
                    <letterSpacing>1px</letterSpacing>
                    <borderBottom>2px solid #111827</borderBottom>
                    <marginBottom>6px</marginBottom>
                </style>
            </header>
            <cells>
                <rowcells>
                    <cell id="emp-name" type="substitute"><style><fontSize>15px</fontSize><fontWeight>bold</fontWeight><textAlign>left</textAlign></style><value>{employeeInfo.employeeFirstName} {employeeInfo.employeeLastName}</value></cell>
                </rowcells>
                <rowcells>
                    <cell id="emp-id" type="substitute"><style><fontSize>11px</fontSize><textAlign>left</textAlign></style><value>Employee ID: {employeeInfo.employeeID}</value></cell>
                </rowcells>
                <rowcells>
                    <cell id="emp-addr" type="substitute"><style><fontSize>11px</fontSize><textAlign>left</textAlign></style><value>{employeeInfo.employeeAddress1}</value></cell>
                </rowcells>
                <rowcells>
                    <cell id="emp-city" type="substitute"><style><fontSize>11px</fontSize><textAlign>left</textAlign></style><value>{employeeInfo.employeeCity} {employeeInfo.employeeState} {employeeInfo.employeeZipCode}</value></cell>
                </rowcells>
            </cells>
        </table>
    </column>
    <column id="modern-payperiod" width="40%">
        <table id="modern-payperiod-table">
            <style><width>100%</width></style>
            <header title="PAY PERIOD">
                <style>
                    <fontSize>12px</fontSize>
                    <fontWeight>bold</fontWeight>
                    <color>#374151</color>
                    <letterSpacing>1px</letterSpacing>
                    <borderBottom>2px solid #111827</borderBottom>
                    <marginBottom>6px</marginBottom>
                </style>
            </header>
            <cells>
                <rowcells>
                    <cell id="pp-begin-label" type="static"><style><fontSize>11px</fontSize><textAlign>left</textAlign></style><value>Period Begins</value></cell>
                    <cell id="pp-begin-value" type="substitute" format="date"><style><fontSize>11px</fontSize><textAlign>right</textAlign></style><value>{incomeDetails.periodStartDate}</value></cell>
                </rowcells>
                <rowcells>
                    <cell id="pp-end-label" type="static"><style><fontSize>11px</fontSize><textAlign>left</textAlign></style><value>Period Ends</value></cell>
                    <cell id="pp-end-value" type="substitute" format="date"><style><fontSize>11px</fontSize><textAlign>right</textAlign></style><value>{incomeDetails.periodEndDate}</value></cell>
                </rowcells>
                <rowcells>
                    <cell id="pp-pay-label" type="static"><style><fontSize>11px</fontSize><textAlign>left</textAlign></style><value>Pay Date</value></cell>
                    <cell id="pp-pay-value" type="substitute" format="date"><style><fontSize>11px</fontSize><textAlign>right</textAlign><fontWeight>bold</fontWeight></style><value>{incomeDetails.periodPayDate}</value></cell>
                </rowcells>
            </cells>
        </table>
    </column>
</section>
