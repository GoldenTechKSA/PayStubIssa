<?xml version='1.0' encoding='utf-8'?>
<paystub>
  <style>
    <fontFamily>'IBM Plex Sans', Arial, sans-serif</fontFamily>
    <color>#111827</color>
    <fontSize>12px</fontSize>
  </style>
  <!-- Section modern-header-section -->
  <section id="modern-header-section">
    <style>
      <backgroundColor>#111827</backgroundColor>
      <color>#ffffff</color>
      <padding>20px</padding>
      <alignItems>center</alignItems>
    </style>
    <column id="modern-header-brand" width="60%">
      <table id="modern-brand-table">
        <style>
          <width>100%</width>
        </style>
        <cells>
          <rowcells>
            <cell id="company-logo" type="image">
              <style>
                <maxHeight>48px</maxHeight>
                <maxWidth>160px</maxWidth>
                <textAlign>left</textAlign>
              </style>
              <value>{companyInfo.companyLogo}</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="company-name" type="substitute">
              <style>
                <fontSize>22px</fontSize>
                <fontWeight>bold</fontWeight>
                <textAlign>left</textAlign>
              </style>
              <value>{companyInfo.companyName}</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="company-address" type="substitute">
              <style>
                <fontSize>11px</fontSize>
                <textAlign>left</textAlign>
              </style>
              <value>{companyInfo.companyAddress1}, {companyInfo.companyCity} {companyInfo.companyState} {companyInfo.companyZipCode}</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="company-ein" type="substitute">
              <style>
                <fontSize>11px</fontSize>
                <textAlign>left</textAlign>
              </style>
              <value>EIN {companyInfo.companyEIN}</value>
            </cell>
          </rowcells>
        </cells>
      </table>
    </column>
    <column id="modern-header-meta" width="40%">
      <table id="modern-meta-table">
        <style>
          <width>100%</width>
        </style>
        <cells>
          <rowcells>
            <cell id="statement-title" colspan="2" type="static">
              <style>
                <fontSize>22px</fontSize>
                <fontWeight>bold</fontWeight>
                <textAlign>right</textAlign>
                <letterSpacing>2px</letterSpacing>
              </style>
              <value>PAY STATEMENT</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="meta-paydate-label" type="static">
              <style>
                <textAlign>right</textAlign>
                <fontSize>11px</fontSize>
              </style>
              <value>Pay Date</value>
            </cell>
            <cell id="meta-paydate-value" type="substitute" format="date">
              <style>
                <textAlign>right</textAlign>
                <fontSize>11px</fontSize>
                <fontWeight>bold</fontWeight>
              </style>
              <value>{incomeDetails.periodPayDate}</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="meta-stub-label" type="static">
              <style>
                <textAlign>right</textAlign>
                <fontSize>11px</fontSize>
              </style>
              <value>Pay Stub No.</value>
            </cell>
            <cell id="meta-stub-value" type="substitute">
              <style>
                <textAlign>right</textAlign>
                <fontSize>11px</fontSize>
                <fontWeight>bold</fontWeight>
              </style>
              <value>{generalInfo.payStubNumber}</value>
            </cell>
          </rowcells>
        </cells>
      </table>
    </column>
  </section>
  <!-- Section modern-identity-section: EMPLOYEE / PAY PERIOD -->
  <section id="modern-identity-section">
    <style>
      <marginTop>20px</marginTop>
      <paddingBottom>12px</paddingBottom>
      <borderBottom>1px solid #d1d5db</borderBottom>
    </style>
    <column id="modern-employee" width="60%">
      <table id="modern-employee-table">
        <style>
          <width>100%</width>
        </style>
        <header title="EMPLOYEE">
          <style>
            <fontSize>12px</fontSize>
            <fontWeight>bold</fontWeight>
            <color>#374151</color>
            <letterSpacing>1px</letterSpacing>
            <borderBottom>2px solid #111827</borderBottom>
            <marginBottom>6px</marginBottom>
          </style>
        </header>
        <cells>
          <rowcells>
            <cell id="emp-name" type="substitute">
              <style>
                <fontSize>15px</fontSize>
                <fontWeight>bold</fontWeight>
                <textAlign>left</textAlign>
              </style>
              <value>{employeeInfo.employeeFirstName} {employeeInfo.employeeLastName}</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="emp-id" type="substitute">
              <style>
                <fontSize>11px</fontSize>
                <textAlign>left</textAlign>
              </style>
              <value>Employee ID: {employeeInfo.employeeID}</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="emp-addr" type="substitute">
              <style>
                <fontSize>11px</fontSize>
                <textAlign>left</textAlign>
              </style>
              <value>{employeeInfo.employeeAddress1}</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="emp-city" type="substitute">
              <style>
                <fontSize>11px</fontSize>
                <textAlign>left</textAlign>
              </style>
              <value>{employeeInfo.employeeCity} {employeeInfo.employeeState} {employeeInfo.employeeZipCode}</value>
            </cell>
          </rowcells>
        </cells>
      </table>
    </column>
    <column id="modern-payperiod" width="40%">
      <table id="modern-payperiod-table">
        <style>
          <width>100%</width>
        </style>
        <header title="PAY PERIOD">
          <style>
            <fontSize>12px</fontSize>
            <fontWeight>bold</fontWeight>
            <color>#374151</color>
            <letterSpacing>1px</letterSpacing>
            <borderBottom>2px solid #111827</borderBottom>
            <marginBottom>6px</marginBottom>
          </style>
        </header>
        <cells>
          <rowcells>
            <cell id="pp-begin-label" type="static">
              <style>
                <fontSize>11px</fontSize>
                <textAlign>left</textAlign>
              </style>
              <value>Period Begins</value>
            </cell>
            <cell id="pp-begin-value" type="substitute" format="date">
              <style>
                <fontSize>11px</fontSize>
                <textAlign>right</textAlign>
              </style>
              <value>{incomeDetails.periodStartDate}</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="pp-end-label" type="static">
              <style>
                <fontSize>11px</fontSize>
                <textAlign>left</textAlign>
              </style>
              <value>Period Ends</value>
            </cell>
            <cell id="pp-end-value" type="substitute" format="date">
              <style>
                <fontSize>11px</fontSize>
                <textAlign>right</textAlign>
              </style>
              <value>{incomeDetails.periodEndDate}</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="pp-pay-label" type="static">
              <style>
                <fontSize>11px</fontSize>
                <textAlign>left</textAlign>
              </style>
              <value>Pay Date</value>
            </cell>
            <cell id="pp-pay-value" type="substitute" format="date">
              <style>
                <fontSize>11px</fontSize>
                <textAlign>right</textAlign>
                <fontWeight>bold</fontWeight>
              </style>
              <value>{incomeDetails.periodPayDate}</value>
            </cell>
          </rowcells>
        </cells>
      </table>
    </column>
  </section>
  <!-- Section modern-earnings-section: EARNINGS / TAXES -->
  <section id="modern-earnings-section">
    <style>
      <marginTop>20px</marginTop>
    </style>
    <column id="modern-earnings-col" width="60%">
      <style>
        <paddingRight>12px</paddingRight>
      </style>
      <table id="modern-earnings-table">
        <style>
          <width>100%</width>
        </style>
        <header title="EARNINGS">
          <style>
            <fontSize>13px</fontSize>
            <fontWeight>bold</fontWeight>
            <color>#374151</color>
            <letterSpacing>1px</letterSpacing>
            <marginBottom>4px</marginBottom>
          </style>
          <hdata>
            <hd id="e-desc">
              <style>
                <textAlign>left</textAlign>
                <fontSize>11px</fontSize>
                <fontWeight>bold</fontWeight>
                <backgroundColor>#f3f4f6</backgroundColor>
                <borderTop>2px solid #111827</borderTop>
                <borderBottom>1px solid #d1d5db</borderBottom>
                <padding>6px</padding>
                <width>40%</width>
              </style>
              <label>Description</label>
            </hd>
            <hd id="e-rate">
              <style>
                <textAlign>right</textAlign>
                <fontSize>11px</fontSize>
                <fontWeight>bold</fontWeight>
                <backgroundColor>#f3f4f6</backgroundColor>
                <borderTop>2px solid #111827</borderTop>
                <borderBottom>1px solid #d1d5db</borderBottom>
                <padding>6px</padding>
                <width>15%</width>
              </style>
              <label>Rate</label>
            </hd>
            <hd id="e-hours">
              <style>
                <textAlign>right</textAlign>
                <fontSize>11px</fontSize>
                <fontWeight>bold</fontWeight>
                <backgroundColor>#f3f4f6</backgroundColor>
                <borderTop>2px solid #111827</borderTop>
                <borderBottom>1px solid #d1d5db</borderBottom>
                <padding>6px</padding>
                <width>15%</width>
              </style>
              <label>Hours</label>
            </hd>
            <hd id="e-current">
              <style>
                <textAlign>right</textAlign>
                <fontSize>11px</fontSize>
                <fontWeight>bold</fontWeight>
                <backgroundColor>#f3f4f6</backgroundColor>
                <borderTop>2px solid #111827</borderTop>
                <borderBottom>1px solid #d1d5db</borderBottom>
                <padding>6px</padding>
                <width>15%</width>
              </style>
              <label>Current</label>
            </hd>
            <hd id="e-ytd">
              <style>
                <textAlign>right</textAlign>
                <fontSize>11px</fontSize>
                <fontWeight>bold</fontWeight>
                <backgroundColor>#f3f4f6</backgroundColor>
                <borderTop>2px solid #111827</borderTop>
                <borderBottom>1px solid #d1d5db</borderBottom>
                <padding>6px</padding>
                <width>15%</width>
              </style>
              <label>YTD</label>
            </hd>
          </hdata>
        </header>
        <cells>
          <rowcells>
            <cell id="reg-desc" type="static">
              <style>
                <textAlign>left</textAlign>
                <padding>6px</padding>
                <borderBottom>1px solid #d1d5db</borderBottom>
              </style>
              <value>Regular Pay</value>
            </cell>
            <cell id="reg-rate" type="substitute" format="currency">
              <style>
                <textAlign>right</textAlign>
                <padding>6px</padding>
                <borderBottom>1px solid #d1d5db</borderBottom>
              </style>
              <value>{incomeDetails.hourlyRate}</value>
            </cell>
            <cell id="reg-hours" type="substitute" format="number">
              <style>
                <textAlign>right</textAlign>
                <padding>6px</padding>
                <borderBottom>1px solid #d1d5db</borderBottom>
              </style>
              <value>{incomeDetails.hoursWorked}</value>
            </cell>
            <cell id="reg-current" type="substitute" format="currency">
              <style>
                <textAlign>right</textAlign>
                <padding>6px</padding>
                <borderBottom>1px solid #d1d5db</borderBottom>
              </style>
              <value>{regularPay}</value>
            </cell>
            <cell id="reg-ytd" type="substitute" format="currency">
              <style>
                <textAlign>right</textAlign>
                <padding>6px</padding>
                <borderBottom>1px solid #d1d5db</borderBottom>
              </style>
              <value>{regularPayYTD}</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="ot-desc" type="static">
              <style>
                <textAlign>left</textAlign>
                <padding>6px</padding>
                <borderBottom>1px solid #d1d5db</borderBottom>
              </style>
              <value>Overtime Pay</value>
            </cell>
            <cell id="ot-rate" type="substitute" format="currency">
              <style>
                <textAlign>right</textAlign>
                <padding>6px</padding>
                <borderBottom>1px solid #d1d5db</borderBottom>
              </style>
              <value>{incomeDetails.overtimeRate}</value>
            </cell>
            <cell id="ot-hours" type="substitute" format="number">
              <style>
                <textAlign>right</textAlign>
                <padding>6px</padding>
                <borderBottom>1px solid #d1d5db</borderBottom>
              </style>
              <value>{incomeDetails.overtimeHours}</value>
            </cell>
            <cell id="ot-current" type="substitute" format="currency">
              <style>
                <textAlign>right</textAlign>
                <padding>6px</padding>
                <borderBottom>1px solid #d1d5db</borderBottom>
              </style>
              <value>{overtimePay}</value>
            </cell>
            <cell id="ot-ytd" type="substitute" format="currency">
              <style>
                <textAlign>right</textAlign>
                <padding>6px</padding>
                <borderBottom>1px solid #d1d5db</borderBottom>
              </style>
              <value>{overtimePayYTD}</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="oth-desc" type="static">
              <style>
                <textAlign>left</textAlign>
                <padding>6px</padding>
                <borderBottom>1px solid #d1d5db</borderBottom>
              </style>
              <value>Other Earnings</value>
            </cell>
            <cell id="oth-rate" type="static">
              <style>
                <textAlign>right</textAlign>
                <padding>6px</padding>
                <borderBottom>1px solid #d1d5db</borderBottom>
              </style>
              <value> </value>
            </cell>
            <cell id="oth-hours" type="static">
              <style>
                <textAlign>right</textAlign>
                <padding>6px</padding>
                <borderBottom>1px solid #d1d5db</borderBottom>
              </style>
              <value> </value>
            </cell>
            <cell id="oth-current" type="substitute" format="currency">
              <style>
                <textAlign>right</textAlign>
                <padding>6px</padding>
                <borderBottom>1px solid #d1d5db</borderBottom>
              </style>
              <value>{otherEarnings}</value>
            </cell>
            <cell id="oth-ytd" type="substitute" format="currency">
              <style>
                <textAlign>right</textAlign>
                <padding>6px</padding>
                <borderBottom>1px solid #d1d5db</borderBottom>
              </style>
              <value>{otherEarningsYTD}</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="gross-desc" colspan="3" type="static">
              <style>
                <textAlign>left</textAlign>
                <fontWeight>bold</fontWeight>
                <padding>6px</padding>
                <borderTop>2px solid #111827</borderTop>
              </style>
              <value>Gross Pay</value>
            </cell>
            <cell id="gross-current" type="substitute" format="currency">
              <style>
                <textAlign>right</textAlign>
                <fontWeight>bold</fontWeight>
                <padding>6px</padding>
                <borderTop>2px solid #111827</borderTop>
              </style>
              <value>{grossPay}</value>
            </cell>
            <cell id="gross-ytd" type="substitute" format="currency">
              <style>
                <textAlign>right</textAlign>
                <fontWeight>bold</fontWeight>
                <padding>6px</padding>
                <borderTop>2px solid #111827</borderTop>
              </style>
              <value>{grossPayYTD}</value>
            </cell>
          </rowcells>
        </cells>
      </table>
    </column>
    <column id="modern-taxes-col" width="40%">
      <style>
        <paddingLeft>12px</paddingLeft>
      </style>
      <table id="modern-taxes-table">
        <style>
          <width>100%</width>
        </style>
        <header title="TAXES">
          <style>
            <fontSize>13px</fontSize>
            <fontWeight>bold</fontWeight>
            <color>#374151</color>
            <letterSpacing>1px</letterSpacing>
            <marginBottom>4px</marginBottom>
          </style>
          <hdata>
            <hd id="t-desc">
              <style>
                <textAlign>left</textAlign>
                <fontSize>11px</fontSize>
                <fontWeight>bold</fontWeight>
                <backgroundColor>#f3f4f6</backgroundColor>
                <borderTop>2px solid #111827</borderTop>
                <borderBottom>1px solid #d1d5db</borderBottom>
                <padding>6px</padding>
                <width>50%</width>
              </style>
              <label>Tax</label>
            </hd>
            <hd id="t-current">
              <style>
                <textAlign>right</textAlign>
                <fontSize>11px</fontSize>
                <fontWeight>bold</fontWeight>
                <backgroundColor>#f3f4f6</backgroundColor>
                <borderTop>2px solid #111827</borderTop>
                <borderBottom>1px solid #d1d5db</borderBottom>
                <padding>6px</padding>
                <width>25%</width>
              </style>
              <label>Current</label>
            </hd>
            <hd id="t-ytd">
              <style>
                <textAlign>right</textAlign>
                <fontSize>11px</fontSize>
                <fontWeight>bold</fontWeight>
                <backgroundColor>#f3f4f6</backgroundColor>
                <borderTop>2px solid #111827</borderTop>
                <borderBottom>1px solid #d1d5db</borderBottom>
                <padding>6px</padding>
                <width>25%</width>
              </style>
              <label>YTD</label>
            </hd>
          </hdata>
        </header>
        <cells>
          <rowcells>
            <cell id="fed-desc" type="static">
              <style>
                <textAlign>left</textAlign>
                <padding>6px</padding>
                <borderBottom>1px solid #d1d5db</borderBottom>
              </style>
              <value>Federal Income Tax</value>
            </cell>
            <cell id="fed-current" type="substitute" format="currency">
              <style>
                <textAlign>right</textAlign>
                <padding>6px</padding>
                <borderBottom>1px solid #d1d5db</borderBottom>
              </style>
              <value>{federalTax}</value>
            </cell>
            <cell id="fed-ytd" type="substitute" format="currency">
              <style>
                <textAlign>right</textAlign>
                <padding>6px</padding>
                <borderBottom>1px solid #d1d5db</borderBottom>
              </style>
              <value>{federalTaxYTD}</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="ss-desc" type="static">
              <style>
                <textAlign>left</textAlign>
                <padding>6px</padding>
                <borderBottom>1px solid #d1d5db</borderBottom>
              </style>
              <value>Social Security</value>
            </cell>
            <cell id="ss-current" type="substitute" format="currency">
              <style>
                <textAlign>right</textAlign>
                <padding>6px</padding>
                <borderBottom>1px solid #d1d5db</borderBottom>
              </style>
              <value>{socialSecurity}</value>
            </cell>
            <cell id="ss-ytd" type="substitute" format="currency">
              <style>
                <textAlign>right</textAlign>
                <padding>6px</padding>
                <borderBottom>1px solid #d1d5db</borderBottom>
              </style>
              <value>{socialSecurityYTD}</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="med-desc" type="static">
              <style>
                <textAlign>left</textAlign>
                <padding>6px</padding>
                <borderBottom>1px solid #d1d5db</borderBottom>
              </style>
              <value>Medicare</value>
            </cell>
            <cell id="med-current" type="substitute" format="currency">
              <style>
                <textAlign>right</textAlign>
                <padding>6px</padding>
                <borderBottom>1px solid #d1d5db</borderBottom>
              </style>
              <value>{medicare}</value>
            </cell>
            <cell id="med-ytd" type="substitute" format="currency">
              <style>
                <textAlign>right</textAlign>
                <padding>6px</padding>
                <borderBottom>1px solid #d1d5db</borderBottom>
              </style>
              <value>{medicareYTD}</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="state-desc" type="static">
              <style>
                <textAlign>left</textAlign>
                <padding>6px</padding>
                <borderBottom>1px solid #d1d5db</borderBottom>
              </style>
              <value>State Tax</value>
            </cell>
            <cell id="state-current" type="substitute" format="currency">
              <style>
                <textAlign>right</textAlign>
                <padding>6px</padding>
                <borderBottom>1px solid #d1d5db</borderBottom>
              </style>
              <value>{stateTax}</value>
            </cell>
            <cell id="state-ytd" type="substitute" format="currency">
              <style>
                <textAlign>right</textAlign>
                <padding>6px</padding>
                <borderBottom>1px solid #d1d5db</borderBottom>
              </style>
              <value>{stateTaxYTD}</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="t-total-desc" type="static">
              <style>
                <textAlign>left</textAlign>
                <fontWeight>bold</fontWeight>
                <padding>6px</padding>
                <borderTop>2px solid #111827</borderTop>
              </style>
              <value>Total Taxes</value>
            </cell>
            <cell id="t-total-current" type="substitute" format="currency">
              <style>
                <textAlign>right</textAlign>
                <fontWeight>bold</fontWeight>
                <padding>6px</padding>
                <borderTop>2px solid #111827</borderTop>
              </style>
              <value>{totalTaxes}</value>
            </cell>
            <cell id="t-total-ytd" type="substitute" format="currency">
              <style>
                <textAlign>right</textAlign>
                <fontWeight>bold</fontWeight>
                <padding>6px</padding>
                <borderTop>2px solid #111827</borderTop>
              </style>
              <value>{totalTaxesYTD}</value>
            </cell>
          </rowcells>
        </cells>
      </table>
    </column>
  </section>
  <!-- Section modern-deductions-section: DEDUCTIONS / SUMMARY -->
  <section id="modern-deductions-section">
    <style>
      <marginTop>20px</marginTop>
      <justifyContent>flex-end</justifyContent>
    </style>
    <column id="modern-deductions-col" width="60%" renderIf="totalDeductions">
      <style>
        <paddingRight>12px</paddingRight>
      </style>
      <table id="modern-deductions-table">
        <style>
          <width>100%</width>
        </style>
        <header title="DEDUCTIONS">
          <style>
            <fontSize>13px</fontSize>
            <fontWeight>bold</fontWeight>
            <color>#374151</color>
            <letterSpacing>1px</letterSpacing>
            <marginBottom>4px</marginBottom>
          </style>
          <hdata>
            <hd id="d-desc">
              <style>
                <textAlign>left</textAlign>
                <fontSize>11px</fontSize>
                <fontWeight>bold</fontWeight>
                <backgroundColor>#f3f4f6</backgroundColor>
                <borderTop>2px solid #111827</borderTop>
                <borderBottom>1px solid #d1d5db</borderBottom>
                <padding>6px</padding>
                <width>50%</width>
              </style>
              <label>Deduction</label>
            </hd>
            <hd id="d-current">
              <style>
                <textAlign>right</textAlign>
                <fontSize>11px</fontSize>
                <fontWeight>bold</fontWeight>
                <backgroundColor>#f3f4f6</backgroundColor>
                <borderTop>2px solid #111827</borderTop>
                <borderBottom>1px solid #d1d5db</borderBottom>
                <padding>6px</padding>
                <width>25%</width>
              </style>
              <label>Current</label>
            </hd>
            <hd id="d-ytd">
              <style>
                <textAlign>right</textAlign>
