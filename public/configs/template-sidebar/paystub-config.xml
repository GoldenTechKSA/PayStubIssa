<?xml version='1.0' encoding='utf-8'?>
<paystub>
  <!--
    Pay Stub, Dark Sidebar (sidebar). A full-height slate sidebar on the left carries the logo,
    the employer, the pay period, the employee and the net pay; the white area on the right holds
    the Earnings, Taxes and Deductions ledgers and a current / year-to-date summary. Set in IBM Plex
    Sans with one teal accent. The logo slot collapses when no logo is uploaded.
    Designed for the 720 x 960 px printable area of a US Letter sheet (see CLAUDE.md, "one stub, one sheet").
  -->
  <style>
    <fontFamily>'IBM Plex Sans', Arial, Helvetica, sans-serif</fontFamily>
    <color>#374151</color>
    <fontSize>11px</fontSize>
    <lineHeight>1.35</lineHeight>
    <backgroundColor>#ffffff</backgroundColor>
  </style>
  <!-- Section sb-body: slate sidebar (logo, employer, pay period, employee, net pay) / ledgers and summary -->
  <section id="sb-body">
    <style>
      <alignItems>stretch</alignItems>
      <minHeight>800px</minHeight>
    </style>
    <column id="sb-side" width="31%">
      <style>
        <backgroundColor>#1F2937</backgroundColor>
        <padding>24px 18px 26px</padding>
        <flexShrink>0</flexShrink>
      </style>
      <table id="sb-logo">
        <cells>
          <rowcells>
            <cell id="sb-logo-r0c0" type="image">
              <style>
                <maxHeight>60px</maxHeight>
                <maxWidth>150px</maxWidth>
                <display>block</display>
                <backgroundColor>#ffffff</backgroundColor>
                <padding>6px</padding>
                <borderRadius>6px</borderRadius>
                <marginBottom>12px</marginBottom>
                <textAlign>left</textAlign>
              </style>
              <value>{companyInfo.companyLogo}</value>
            </cell>
          </rowcells>
        </cells>
      </table>
