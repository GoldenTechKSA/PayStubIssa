    <column id="ml-period-col" width="81%">
      <table id="ml-period-t">
        <style>
          <width>100%</width>
          <tableLayout>fixed</tableLayout>
        </style>
        <cells>
          <rowcells>
            <cell id="ml-period-t-r0c0" type="static">
              <style>
                <textAlign>left</textAlign>
                <padding>0</padding>
                <whiteSpace>normal</whiteSpace>
                <fontSize>9px</fontSize>
                <letterSpacing>0.8px</letterSpacing>
                <color>#737373</color>
                <width>34%</width>
              </style>
              <value>PERIOD</value>
            </cell>
            <cell id="ml-period-t-r0c1" type="static">
              <style>
                <textAlign>left</textAlign>
                <padding>0</padding>
                <whiteSpace>normal</whiteSpace>
                <fontSize>9px</fontSize>
                <letterSpacing>0.8px</letterSpacing>
                <color>#737373</color>
                <width>22%</width>
              </style>
              <value>PAY DATE</value>
            </cell>
            <cell id="ml-period-t-r0c2" type="static">
              <style>
                <textAlign>left</textAlign>
                <padding>0</padding>
                <whiteSpace>normal</whiteSpace>
                <fontSize>9px</fontSize>
                <letterSpacing>0.8px</letterSpacing>
                <color>#737373</color>
                <width>22%</width>
              </style>
              <value>SCHEDULE</value>
            </cell>
            <cell id="ml-period-t-r0c3" type="static">
              <style>
                <textAlign>left</textAlign>
                <padding>0</padding>
                <whiteSpace>normal</whiteSpace>
                <fontSize>9px</fontSize>
                <letterSpacing>0.8px</letterSpacing>
                <color>#737373</color>
                <width>22%</width>
              </style>
              <value>CHECK NO.</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="ml-period-t-r1c0" type="substitute">
              <style>
                <textAlign>left</textAlign>
                <padding>0</padding>
                <whiteSpace>normal</whiteSpace>
                <fontSize>11.5px</fontSize>
                <paddingBottom>2px</paddingBottom>
              </style>
              <value>{payPeriodLabel}</value>
            </cell>
            <cell id="ml-period-t-r1c1" type="substitute" format="date">
              <style>
                <textAlign>left</textAlign>
                <padding>0</padding>
                <whiteSpace>normal</whiteSpace>
                <fontSize>11.5px</fontSize>
                <paddingBottom>2px</paddingBottom>
              </style>
              <value>{incomeDetails.periodPayDate}</value>
            </cell>
            <cell id="ml-period-t-r1c2" type="substitute">
              <style>
                <textAlign>left</textAlign>
                <padding>0</padding>
                <whiteSpace>normal</whiteSpace>
                <fontSize>11.5px</fontSize>
                <paddingBottom>2px</paddingBottom>
              </style>
              <value>{incomeDetails.periodType}</value>
            </cell>
            <cell id="ml-period-t-r1c3" type="substitute" format="text">
              <style>
                <textAlign>left</textAlign>
                <padding>0</padding>
                <whiteSpace>normal</whiteSpace>
                <fontSize>11.5px</fontSize>
                <paddingBottom>2px</paddingBottom>
              </style>
              <value>{checkNumber}</value>
            </cell>
          </rowcells>
        </cells>
      </table>
    </column>
  </section>
  <!-- Section ml-earnings: Earnings -->
  <section id="ml-earnings">
    <style>
      <borderTop>1px solid #111111</borderTop>
      <padding>11px 0 15px</padding>
    </style>
    <column id="ml-earnings-label" width="19%">
      <table id="ml-earnings-label-t">
        <cells>
          <rowcells>
            <cell id="ml-earnings-label-t-r0c0" type="static">
              <style>
                <textAlign>left</textAlign>
                <padding>0</padding>
                <whiteSpace>normal</whiteSpace>
                <fontSize>9.5px</fontSize>
                <fontWeight>600</fontWeight>
                <letterSpacing>1.6px</letterSpacing>
                <color>#737373</color>
                <paddingTop>2px</paddingTop>
              </style>
              <value>EARNINGS</value>
            </cell>
          </rowcells>
        </cells>
      </table>
    </column>
    <column id="ml-earnings-col" width="81%">
      <table id="ml-earn">
        <style>
          <width>100%</width>
        </style>
        <header>
          <hdata>
            <hd id="ml-earn-h0">
              <style>
                <width>28%</width>
                <textAlign>left</textAlign>
                <padding>0 0 4px</padding>
                <fontSize>9px</fontSize>
                <fontWeight>400</fontWeight>
                <letterSpacing>0.8px</letterSpacing>
                <color>#737373</color>
              </style>
              <label/>
            </hd>
            <hd id="ml-earn-h1">
              <style>
                <width>13%</width>
                <textAlign>right</textAlign>
                <padding>0 0 4px</padding>
                <fontSize>9px</fontSize>
                <fontWeight>400</fontWeight>
                <letterSpacing>0.8px</letterSpacing>
                <color>#737373</color>
              </style>
              <label>HOURS</label>
            </hd>
            <hd id="ml-earn-h2">
              <style>
                <width>15%</width>
                <textAlign>right</textAlign>
                <padding>0 0 4px</padding>
                <fontSize>9px</fontSize>
                <fontWeight>400</fontWeight>
                <letterSpacing>0.8px</letterSpacing>
                <color>#737373</color>
              </style>
              <label>RATE</label>
            </hd>
            <hd id="ml-earn-h3">
              <style>
                <width>21%</width>
                <textAlign>right</textAlign>
                <padding>0 0 4px</padding>
                <fontSize>9px</fontSize>
                <fontWeight>400</fontWeight>
                <letterSpacing>0.8px</letterSpacing>
                <color>#737373</color>
              </style>
              <label>THIS PERIOD</label>
            </hd>
            <hd id="ml-earn-h4">
              <style>
                <width>23%</width>
                <textAlign>right</textAlign>
                <padding>0 0 4px</padding>
                <fontSize>9px</fontSize>
                <fontWeight>400</fontWeight>
                <letterSpacing>0.8px</letterSpacing>
                <color>#737373</color>
              </style>
              <label>YEAR TO DATE</label>
            </hd>
          </hdata>
        </header>
        <cells>
          <rowcells renderIf="isHourly">
            <cell id="ml-earn-r0c0" type="static">
              <style>
                <textAlign>left</textAlign>
                <padding>3px 0</padding>
                <fontSize>11.5px</fontSize>
              </style>
              <value>Regular Pay</value>
            </cell>
            <cell id="ml-earn-r0c1" type="substitute" format="number">
              <style>
                <textAlign>right</textAlign>
                <padding>3px 0</padding>
                <fontSize>11.5px</fontSize>
              </style>
              <value>{incomeDetails.hoursWorked}</value>
            </cell>
            <cell id="ml-earn-r0c2" type="substitute" format="currency">
              <style>
                <textAlign>right</textAlign>
                <padding>3px 0</padding>
                <fontSize>11.5px</fontSize>
              </style>
              <value>{incomeDetails.hourlyRate}</value>
            </cell>
            <cell id="ml-earn-r0c3" type="substitute" format="currency">
              <style>
                <textAlign>right</textAlign>
                <padding>3px 0</padding>
                <fontSize>11.5px</fontSize>
              </style>
              <value>{regularPay}</value>
            </cell>
            <cell id="ml-earn-r0c4" type="substitute" format="currency">
              <style>
                <textAlign>right</textAlign>
                <padding>3px 0</padding>
                <fontSize>11.5px</fontSize>
              </style>
              <value>{regularPayYTD}</value>
            </cell>
          </rowcells>
          <rowcells renderIf="isSalaried">
            <cell id="ml-earn-r1c0" type="static">
              <style>
                <textAlign>left</textAlign>
                <padding>3px 0</padding>
                <fontSize>11.5px</fontSize>
              </style>
              <value>Salary</value>
            </cell>
            <cell id="ml-earn-r1c1" type="static">
              <style>
                <textAlign>right</textAlign>
                <padding>3px 0</padding>
                <fontSize>11.5px</fontSize>
              </style>
              <value/>
            </cell>
            <cell id="ml-earn-r1c2" type="static">
              <style>
                <textAlign>right</textAlign>
                <padding>3px 0</padding>
                <fontSize>11.5px</fontSize>
              </style>
              <value/>
            </cell>
            <cell id="ml-earn-r1c3" type="substitute" format="currency">
              <style>
                <textAlign>right</textAlign>
                <padding>3px 0</padding>
                <fontSize>11.5px</fontSize>
              </style>
              <value>{regularPay}</value>
            </cell>
            <cell id="ml-earn-r1c4" type="substitute" format="currency">
              <style>
                <textAlign>right</textAlign>
                <padding>3px 0</padding>
                <fontSize>11.5px</fontSize>
              </style>
              <value>{regularPayYTD}</value>
            </cell>
          </rowcells>
          <rowcells renderIf="overtimePayYTD">
            <cell id="ml-earn-r2c0" type="static">
              <style>
                <textAlign>left</textAlign>
                <padding>3px 0</padding>
                <fontSize>11.5px</fontSize>
              </style>
              <value>Overtime</value>
            </cell>
            <cell id="ml-earn-r2c1" type="substitute" format="number">
              <style>
                <textAlign>right</textAlign>
                <padding>3px 0</padding>
                <fontSize>11.5px</fontSize>
              </style>
              <value>{incomeDetails.overtimeHours}</value>
            </cell>
            <cell id="ml-earn-r2c2" type="substitute" format="currency">
              <style>
                <textAlign>right</textAlign>
                <padding>3px 0</padding>
                <fontSize>11.5px</fontSize>
              </style>
              <value>{incomeDetails.overtimeRate}</value>
            </cell>
            <cell id="ml-earn-r2c3" type="substitute" format="currency">
              <style>
                <textAlign>right</textAlign>
                <padding>3px 0</padding>
                <fontSize>11.5px</fontSize>
              </style>
              <value>{overtimePay}</value>
            </cell>
            <cell id="ml-earn-r2c4" type="substitute" format="currency">
              <style>
                <textAlign>right</textAlign>
                <padding>3px 0</padding>
                <fontSize>11.5px</fontSize>
              </style>
              <value>{overtimePayYTD}</value>
            </cell>
          </rowcells>
          <rowcells renderIf="otherEarningsYTD">
