    </column>
    <column id="ml-taxes-col" width="81%">
      <table id="ml-tax">
        <style>
          <width>100%</width>
        </style>
        <header>
          <hdata>
            <hd id="ml-tax-h0">
              <style>
                <width>56%</width>
                <textAlign>left</textAlign>
                <padding>0 0 4px</padding>
                <fontSize>9px</fontSize>
