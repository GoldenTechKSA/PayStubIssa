  <!-- Section ml-taxes: Taxes -->
  <section id="ml-taxes">
    <style>
      <borderTop>1px solid #111111</borderTop>
      <padding>11px 0 15px</padding>
    </style>
    <column id="ml-taxes-label" width="19%">
      <table id="ml-taxes-label-t">
        <cells>
          <rowcells>
            <cell id="ml-taxes-label-t-r0c0" type="static">
              <style>
                <textAlign>left</textAlign>
                <padding>0</padding>
                <whiteSpace>normal</whiteSpace>
                <fontSize>9.5px</fontSize>
                <fontWeight>600</fontWeight>
                <letterSpacing>1.6px</letterSpacing>
                <color>#737373</color>
                <paddingTop>2px</paddingTop>
              </style>
