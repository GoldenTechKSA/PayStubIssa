                <fontSize>11.5px</fontSize>
              </style>
              <value>{otherEarnings}</value>
            </cell>
            <cell id="ml-earn-r3c4" type="substitute" format="currency">
              <style>
                <textAlign>right</textAlign>
                <padding>3px 0</padding>
                <fontSize>11.5px</fontSize>
              </style>
              <value>{otherEarningsYTD}</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="ml-earn-r4c0" type="static" colspan="3">
              <style>
                <textAlign>left</textAlign>
                <padding>6px 0 0</padding>
                <fontSize>11.5px</fontSize>
                <fontWeight>600</fontWeight>
                <color>#111111</color>
