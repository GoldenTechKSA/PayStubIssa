                <fontWeight>600</fontWeight>
                <color>#111111</color>
                <borderTop>1px solid #D4D4D4</borderTop>
              </style>
              <value>{grossPay}</value>
            </cell>
            <cell id="ml-earn-r4c2" type="substitute" format="currency">
              <style>
                <textAlign>right</textAlign>
                <padding>6px 0 0</padding>
                <fontSize>11.5px</fontSize>
