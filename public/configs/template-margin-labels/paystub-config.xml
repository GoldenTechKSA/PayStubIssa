<?xml version='1.0' encoding='utf-8'?>
<paystub>
  <!--
    Pay Stub, Minimal (margin-labels). No boxes and no fills: black hairlines, generous space and light type.
    Each band of the page has its name in the left margin (Employer, Employee, Pay period, Earnings, Taxes,
    Deductions, Net pay) and its content to the right, the way a typeset statement or a resume is laid out.
    Net pay closes the page in large light figures. IBM Plex Sans, black and gray only, no logo.
    Designed for the 720 x 960 px printable area of a US Letter sheet (see CLAUDE.md, "one stub, one sheet").
  -->
  <style>
    <fontFamily>'IBM Plex Sans', Arial, Helvetica, sans-serif</fontFamily>
    <color>#262626</color>
    <fontSize>11.5px</fontSize>
    <lineHeight>1.4</lineHeight>
    <backgroundColor>#ffffff</backgroundColor>
    <padding>10px 0 0</padding>
  </style>
  <!-- Section ml-title: document title (left) / stub number (right) -->
  <section id="ml-title">
    <style>
      <alignItems>flex-end</alignItems>
      <paddingBottom>16px</paddingBottom>
    </style>
    <column id="ml-title-left" width="60%">
      <table id="ml-title-t">
        <cells>
          <rowcells>
            <cell id="ml-title-t-r0c0" type="static">
              <style>
                <textAlign>left</textAlign>
                <padding>0</padding>
                <whiteSpace>normal</whiteSpace>
                <fontSize>34px</fontSize>
                <fontWeight>300</fontWeight>
                <color>#111111</color>
                <lineHeight>1.1</lineHeight>
                <letterSpacing>-0.5px</letterSpacing>
              </style>
              <value>Pay Stub</value>
            </cell>
          </rowcells>
        </cells>
      </table>
    </column>
    <column id="ml-title-right" width="40%">
      <table id="ml-title-no">
        <style>
          <width>100%</width>
        </style>
        <cells>
          <rowcells>
            <cell id="ml-title-no-r0c0" type="substitute">
              <style>
                <textAlign>right</textAlign>
                <padding>0 0 6px</padding>
                <fontSize>11px</fontSize>
                <color>#737373</color>
              </style>
              <value>No. {stubNumber}</value>
            </cell>
          </rowcells>
        </cells>
      </table>
    </column>
  </section>
  <!-- Section ml-employer: Employer -->
  <section id="ml-employer">
    <style>
      <borderTop>1px solid #111111</borderTop>
      <padding>11px 0 15px</padding>
    </style>
    <column id="ml-employer-label" width="19%">
      <table id="ml-employer-label-t">
        <cells>
          <rowcells>
            <cell id="ml-employer-label-t-r0c0" type="static">
              <style>
                <textAlign>left</textAlign>
                <padding>0</padding>
                <whiteSpace>normal</whiteSpace>
                <fontSize>9.5px</fontSize>
                <fontWeight>600</fontWeight>
                <letterSpacing>1.6px</letterSpacing>
                <color>#737373</color>
                <paddingTop>2px</paddingTop>
              </style>
              <value>EMPLOYER</value>
            </cell>
          </rowcells>
        </cells>
      </table>
    </column>
    <column id="ml-employer-col" width="81%">
      <table id="ml-employer-t">
        <style>
          <width>100%</width>
        </style>
        <cells>
          <rowcells>
            <cell id="ml-employer-t-r0c0" type="substitute">
              <style>
                <textAlign>left</textAlign>
                <padding>0</padding>
                <whiteSpace>normal</whiteSpace>
                <fontSize>13px</fontSize>
                <fontWeight>600</fontWeight>
                <color>#111111</color>
              </style>
              <value>{companyInfo.companyName}</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="ml-employer-t-r1c0" type="substitute">
              <style>
                <textAlign>left</textAlign>
                <padding>0</padding>
                <whiteSpace>normal</whiteSpace>
                <fontSize>11.5px</fontSize>
              </style>
              <value>{companyAddressLine}</value>
            </cell>
          </rowcells>
          <rowcells renderIf="companyInfo.companyEIN">
            <cell id="ml-employer-t-r2c0" type="substitute">
              <style>
                <textAlign>left</textAlign>
                <padding>0</padding>
                <whiteSpace>normal</whiteSpace>
                <fontSize>10.5px</fontSize>
                <color>#737373</color>
              </style>
              <value>EIN {companyInfo.companyEIN}</value>
            </cell>
          </rowcells>
        </cells>
      </table>
    </column>
  </section>
  <!-- Section ml-employee: Employee -->
  <section id="ml-employee">
    <style>
      <borderTop>1px solid #111111</borderTop>
      <padding>11px 0 15px</padding>
    </style>
    <column id="ml-employee-label" width="19%">
      <table id="ml-employee-label-t">
        <cells>
          <rowcells>
            <cell id="ml-employee-label-t-r0c0" type="static">
              <style>
                <textAlign>left</textAlign>
                <padding>0</padding>
                <whiteSpace>normal</whiteSpace>
                <fontSize>9.5px</fontSize>
                <fontWeight>600</fontWeight>
                <letterSpacing>1.6px</letterSpacing>
                <color>#737373</color>
                <paddingTop>2px</paddingTop>
              </style>
              <value>EMPLOYEE</value>
            </cell>
          </rowcells>
        </cells>
      </table>
    </column>
    <column id="ml-employee-col" width="45%">
      <table id="ml-employee-t">
        <style>
          <width>100%</width>
        </style>
        <cells>
          <rowcells>
            <cell id="ml-employee-t-r0c0" type="substitute">
              <style>
                <textAlign>left</textAlign>
                <padding>0</padding>
                <whiteSpace>normal</whiteSpace>
                <fontSize>13px</fontSize>
                <fontWeight>600</fontWeight>
                <color>#111111</color>
              </style>
              <value>{employeeInfo.employeeFirstName} {employeeInfo.employeeMiddleInitial} {employeeInfo.employeeLastName}</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="ml-employee-t-r1c0" type="substitute">
              <style>
                <textAlign>left</textAlign>
                <padding>0</padding>
                <whiteSpace>normal</whiteSpace>
                <fontSize>11.5px</fontSize>
              </style>
              <value>{employeeInfo.employeeAddress1} {employeeInfo.employeeAddress2}</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="ml-employee-t-r2c0" type="substitute">
              <style>
                <textAlign>left</textAlign>
                <padding>0</padding>
                <whiteSpace>normal</whiteSpace>
                <fontSize>11.5px</fontSize>
              </style>
              <value>{employeeAddressLine}</value>
            </cell>
          </rowcells>
        </cells>
      </table>
    </column>
    <column id="ml-employee-ids" width="36%">
      <table id="ml-employee-ids-t">
        <style>
          <width>100%</width>
        </style>
        <cells>
          <rowcells>
            <cell id="ml-employee-ids-t-r0c0" type="substitute">
              <style>
                <textAlign>left</textAlign>
                <padding>0</padding>
                <whiteSpace>normal</whiteSpace>
                <fontSize>11.5px</fontSize>
                <paddingTop>2px</paddingTop>
              </style>
              <value>SSN {employeeSSNMasked}</value>
            </cell>
          </rowcells>
          <rowcells renderIf="employeeInfo.employeeID">
            <cell id="ml-employee-ids-t-r1c0" type="substitute" format="text">
              <style>
                <textAlign>left</textAlign>
                <padding>0</padding>
                <whiteSpace>normal</whiteSpace>
                <fontSize>11.5px</fontSize>
              </style>
              <value>Employee ID {employeeInfo.employeeID}</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="ml-employee-ids-t-r2c0" type="substitute">
              <style>
                <textAlign>left</textAlign>
                <padding>0</padding>
                <whiteSpace>normal</whiteSpace>
                <fontSize>11.5px</fontSize>
              </style>
              <value>{filingStatusLabel}</value>
            </cell>
          </rowcells>
        </cells>
      </table>
    </column>
  </section>
  <!-- Section ml-period: Pay period -->
  <section id="ml-period">
    <style>
      <borderTop>1px solid #111111</borderTop>
      <padding>11px 0 15px</padding>
    </style>
