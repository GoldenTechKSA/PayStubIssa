<table id="Taxes-table">
    <header title="Taxes and Deductions">
        <hdata>
            <hd id="description"><label>Deductions</label></hd>
            <hd id="current"><label>This Period</label></hd>
            <hd id="ytd"><label>YTD</label></hd>
        </hdata>
    </header>
    <cells>
        <rowcells>
            <cell id="fed-current" type="calculated"><value>Federal Income Tax</value></cell>
            <cell id="fed-ytd" type="static"><value>current taxes</value></cell>
            <cell id="fed-current-ytd" type="calculated"><value>YTD taxes</value></cell>
        </rowcells>
        <rowcells>
            <cell id="description-value" type="static"><value>Social Security Tax</value></cell>
            <cell id="rate-value" type="static"><value>{company.address}</value></cell>
            <cell id="ytd-value" type="static"><value>{company.ein}</value></cell>
        </rowcells>
        <rowcells>
            <cell id="description-value" type="static"><value>Medicare Tax</value></cell>
            <cell id="rate-value" type="static"><value>{company.address}</value></cell>
            <cell id="ytd-value" type="static"><value>{company.ein}</value></cell>
        </rowcells>
        <rowcells>
            <cell id="description-value" type="static"><value>State Tax</value></cell>
            <cell id="rate-value" type="static"><value>{company.address}</value></cell>
            <cell id="ytd-value" type="static"><value>{company.ein}</value></cell>
        </rowcells>
    </cells>
</table>