<?xml version='1.0' encoding='utf-8'?>
<!-- Payment and deductions cards. The outline and the minimum height live on the COLUMN,
     so the tables stacked inside compose into one box; flex stretch then keeps the two
     cards exactly the same height whatever the row counts are.

     Every table repeats the same fixed column widths (tableLayout fixed) so the optional
     rows below line up with the header row above them. -->
<section id="es2-earnings-panels">
    <style>
        <padding>16px 16px 0</padding>
        <justifyContent>space-between</justifyContent>
    </style>

    <column id="es2-payment-panel" width="46.5%">
        <style><border>1px solid #cfcfcf</border><minHeight>150px</minHeight></style>
        <table id="es2-payment-bar">
            <style><width>100%</width><backgroundColor>#d3d3d3</backgroundColor></style>
            <cells>
                <rowcells>
                    <cell id="es2-payment-bar-label" type="static">
                        <style><textAlign>center</textAlign><fontWeight>bold</fontWeight><padding>8px 8px</padding></style>
                        <value>PAYMENT</value>
                    </cell>
                </rowcells>
            </cells>
        </table>
        <table id="es2-payment-main">
            <style><width>100%</width><tableLayout>fixed</tableLayout></style>
            <header>
                <hdata>
                    <hd id="es2-h-pay-desc">
                        <style><width>18%</width><padding>7px 5px 5px</padding><fontWeight>normal</fontWeight></style>
                        <label> </label>
                    </hd>
                    <hd id="es2-h-pay-rate">
                        <style><width>16%</width><textAlign>center</textAlign><padding>7px 5px 5px</padding><whiteSpace>nowrap</whiteSpace></style>
                        <label>RATE</label>
                    </hd>
                    <hd id="es2-h-pay-hours">
                        <style><width>17%</width><textAlign>center</textAlign><padding>7px 5px 5px</padding><whiteSpace>nowrap</whiteSpace></style>
                        <label>HOURS</label>
                    </hd>
                    <hd id="es2-h-pay-current">
                        <style><width>23%</width><textAlign>center</textAlign><padding>7px 5px 5px</padding><whiteSpace>nowrap</whiteSpace></style>
                        <label>CURRENT</label>
                    </hd>
                    <hd id="es2-h-pay-ytd">
                        <style><width>26%</width><textAlign>center</textAlign><padding>7px 5px 5px</padding><whiteSpace>nowrap</whiteSpace></style>
                        <label>YTD</label>
                    </hd>
                </hdata>
            </header>
            <cells>
                <rowcells>
                    <cell id="es2-reg-desc" type="static"><style><width>18%</width><textAlign>left</textAlign><padding>4px 5px</padding></style><value>Regular</value></cell>
                    <cell id="es2-reg-rate" type="substitute" format="currency"><style><width>16%</width><textAlign>right</textAlign><padding>4px 5px</padding></style><value>{incomeDetails.hourlyRate}</value></cell>
                    <cell id="es2-reg-hours" type="substitute" format="number"><style><width>17%</width><textAlign>right</textAlign><padding>4px 5px</padding></style><value>{incomeDetails.hoursWorked}</value></cell>
                    <cell id="es2-reg-current" type="substitute" format="currency"><style><width>23%</width><textAlign>right</textAlign><padding>4px 5px</padding></style><value>{regularPay}</value></cell>
                    <cell id="es2-reg-ytd" type="substitute" format="currency"><style><width>26%</width><textAlign>right</textAlign><padding>4px 5px</padding></style><value>{regularPayYTD}</value></cell>
                </rowcells>
            </cells>
        </table>
        <table id="es2-payment-overtime" renderIf="overtimePay">
            <style><width>100%</width><tableLayout>fixed</tableLayout></style>
            <cells>
                <rowcells>
                    <cell id="es2-ot-desc" type="static"><style><width>18%</width><textAlign>left</textAlign><padding>4px 5px</padding></style><value>Overtime</value></cell>
                    <cell id="es2-ot-rate" type="substitute" format="currency"><style><width>16%</width><textAlign>right</textAlign><padding>4px 5px</padding></style><value>{incomeDetails.overtimeRate}</value></cell>
                    <cell id="es2-ot-hours" type="substitute" format="number"><style><width>17%</width><textAlign>right</textAlign><padding>4px 5px</padding></style><value>{incomeDetails.overtimeHours}</value></cell>
                    <cell id="es2-ot-current" type="substitute" format="currency"><style><width>23%</width><textAlign>right</textAlign><padding>4px 5px</padding></style><value>{overtimePay}</value></cell>
                    <cell id="es2-ot-ytd" type="substitute" format="currency"><style><width>26%</width><textAlign>right</textAlign><padding>4px 5px</padding></style><value>{overtimePayYTD}</value></cell>
                </rowcells>
            </cells>
        </table>
        <table id="es2-payment-bonus" renderIf="otherEarnings">
            <style><width>100%</width><tableLayout>fixed</tableLayout></style>
            <cells>
                <rowcells>
                    <cell id="es2-bonus-desc" type="static"><style><width>18%</width><textAlign>left</textAlign><padding>4px 5px</padding></style><value>Bonus</value></cell>
                    <cell id="es2-bonus-rate" type="static"><style><width>16%</width><padding>4px 5px</padding></style><value> </value></cell>
                    <cell id="es2-bonus-hours" type="static"><style><width>17%</width><padding>4px 5px</padding></style><value> </value></cell>
                    <cell id="es2-bonus-current" type="substitute" format="currency"><style><width>23%</width><textAlign>right</textAlign><padding>4px 5px</padding></style><value>{otherEarnings}</value></cell>
                    <cell id="es2-bonus-ytd" type="substitute" format="currency"><style><width>26%</width><textAlign>right</textAlign><padding>4px 5px</padding></style><value>{otherEarningsYTD}</value></cell>
                </rowcells>
            </cells>
        </table>
    </column>

    <column id="es2-deductions-panel" width="46.5%">
        <style><border>1px solid #cfcfcf</border><minHeight>150px</minHeight></style>
        <table id="es2-deductions-bar">
            <style><width>100%</width><backgroundColor>#d3d3d3</backgroundColor></style>
            <cells>
                <rowcells>
                    <cell id="es2-deductions-bar-label" type="static">
                        <style><textAlign>center</textAlign><fontWeight>bold</fontWeight><padding>8px 8px</padding></style>
                        <value>DEDUCTIONS</value>
                    </cell>
                </rowcells>
            </cells>
        </table>
        <table id="es2-deductions-main">
            <style><width>100%</width><tableLayout>fixed</tableLayout></style>
            <header>
                <hdata>
                    <hd id="es2-h-ded-desc">
                        <style><width>38%</width><padding>7px 5px 5px</padding><fontWeight>normal</fontWeight></style>
                        <label> </label>
                    </hd>
                    <hd id="es2-h-ded-current">
                        <style><width>25%</width><textAlign>center</textAlign><padding>7px 5px 5px</padding><whiteSpace>nowrap</whiteSpace></style>
                        <label>CURRENT</label>
                    </hd>
                    <hd id="es2-h-ded-ytd">
                        <style><width>37%</width><textAlign>center</textAlign><padding>7px 5px 5px</padding><whiteSpace>nowrap</whiteSpace></style>
                        <label>YEAR TO DATE</label>
                    </hd>
                </hdata>
            </header>
            <cells>
                <rowcells>
                    <cell id="es2-med-desc" type="static"><style><width>38%</width><textAlign>left</textAlign><padding>4px 5px</padding></style><value>FICA MED TAX</value></cell>
                    <cell id="es2-med-current" type="substitute" format="currency"><style><width>25%</width><textAlign>right</textAlign><padding>4px 5px</padding></style><value>{medicare}</value></cell>
                    <cell id="es2-med-ytd" type="substitute" format="currency"><style><width>37%</width><textAlign>right</textAlign><padding>4px 5px</padding></style><value>{medicareYTD}</value></cell>
                </rowcells>
                <rowcells>
                    <cell id="es2-ss-desc" type="static"><style><width>38%</width><textAlign>left</textAlign><padding>4px 5px</padding></style><value>FICA SS TAX</value></cell>
                    <cell id="es2-ss-current" type="substitute" format="currency"><style><width>25%</width><textAlign>right</textAlign><padding>4px 5px</padding></style><value>{socialSecurity}</value></cell>
                    <cell id="es2-ss-ytd" type="substitute" format="currency"><style><width>37%</width><textAlign>right</textAlign><padding>4px 5px</padding></style><value>{socialSecurityYTD}</value></cell>
                </rowcells>
                <rowcells>
                    <cell id="es2-fed-desc" type="static"><style><width>38%</width><textAlign>left</textAlign><padding>4px 5px</padding></style><value>FED TAX</value></cell>
                    <cell id="es2-fed-current" type="substitute" format="currency"><style><width>25%</width><textAlign>right</textAlign><padding>4px 5px</padding></style><value>{federalTax}</value></cell>
                    <cell id="es2-fed-ytd" type="substitute" format="currency"><style><width>37%</width><textAlign>right</textAlign><padding>4px 5px</padding></style><value>{federalTaxYTD}</value></cell>
                </rowcells>
                <rowcells>
                    <cell id="es2-st-desc" type="substitute"><style><width>38%</width><textAlign>left</textAlign><padding>4px 5px</padding></style><value>{stateTaxLabel}</value></cell>
                    <cell id="es2-st-current" type="substitute" format="currency"><style><width>25%</width><textAlign>right</textAlign><padding>4px 5px</padding></style><value>{stateTax}</value></cell>
                    <cell id="es2-st-ytd" type="substitute" format="currency"><style><width>37%</width><textAlign>right</textAlign><padding>4px 5px</padding></style><value>{stateTaxYTD}</value></cell>
                </rowcells>
            </cells>
        </table>
        <table id="es2-deductions-paid-leave" renderIf="paidLeave">
            <style><width>100%</width><tableLayout>fixed</tableLayout></style>
            <cells>
                <rowcells>
                    <cell id="es2-pfml-desc" type="substitute"><style><width>38%</width><textAlign>left</textAlign><padding>4px 5px</padding></style><value>{paidLeaveLabel}</value></cell>
                    <cell id="es2-pfml-current" type="substitute" format="currency"><style><width>25%</width><textAlign>right</textAlign><padding>4px 5px</padding></style><value>{paidLeave}</value></cell>
                    <cell id="es2-pfml-ytd" type="substitute" format="currency"><style><width>37%</width><textAlign>right</textAlign><padding>4px 5px</padding></style><value>{paidLeaveYTD}</value></cell>
                </rowcells>
            </cells>
        </table>
    </column>
</section>
