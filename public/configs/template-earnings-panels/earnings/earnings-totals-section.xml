<?xml version='1.0' encoding='utf-8'?>
<!-- The two summary bars under the cards, on the same 46.5% grid.

     TOTAL DEDUCTIONS adds the benefit deductions (medical, dental, vision, 401k, other)
     to the withholding itemised above, so GROSS EARNINGS minus this figure is always the
     NET TOTAL printed further down. Where a customer entered benefit amounts, that total
     is larger than the deduction rows visible in the card. -->
<section id="es2-earnings-totals">
    <style>
        <padding>17px 16px 0</padding>
        <justifyContent>space-between</justifyContent>
    </style>
    <column id="es2-gross-col" width="46.5%">
        <style><border>1px solid #cfcfcf</border></style>
        <table id="es2-gross-table">
            <style><width>100%</width></style>
            <cells>
                <rowcells>
                    <cell id="es2-gross-label" type="static">
                        <style><textAlign>left</textAlign><fontWeight>bold</fontWeight><padding>5px 6px</padding></style>
                        <value>GROSS EARNINGS</value>
                    </cell>
                    <cell id="es2-gross-value" type="substitute" format="currency">
                        <style><textAlign>right</textAlign><padding>5px 6px</padding></style>
                        <value>{grossPay}</value>
                    </cell>
                </rowcells>
            </cells>
        </table>
    </column>
    <column id="es2-totded-col" width="46.5%">
        <style><border>1px solid #cfcfcf</border></style>
        <table id="es2-totded-table">
            <style><width>100%</width></style>
            <cells>
                <rowcells>
                    <cell id="es2-totded-label" type="static">
                        <style><textAlign>left</textAlign><fontWeight>bold</fontWeight><padding>5px 6px</padding></style>
                        <value>TOTAL DEDUCTIONS</value>
                    </cell>
                    <cell id="es2-totded-value" type="calculated" format="currency">
                        <style><textAlign>right</textAlign><padding>5px 6px</padding></style>
                        <formula>{totalTaxes} + {totalDeductions}</formula>
                    </cell>
                </rowcells>
            </cells>
        </table>
    </column>
</section>
