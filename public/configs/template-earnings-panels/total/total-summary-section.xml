<?xml version='1.0' encoding='utf-8'?>
<!-- Right-aligned stack of two boxes. Each grey caption bar and the outlined body under it
     are separate tables, so the outline wraps only the figures. -->
<section id="es2-total-summary">
    <style>
        <padding>34px 16px 0</padding>
        <justifyContent>flex-end</justifyContent>
    </style>
    <column id="es2-total-summary-col" width="40%">
        <table id="es2-ytd-bar">
            <style><width>100%</width><backgroundColor>#d3d3d3</backgroundColor></style>
            <cells>
                <rowcells>
                    <cell id="es2-ytd-bar-label" type="static">
                        <style><textAlign>center</textAlign><fontWeight>bold</fontWeight><padding>8px 8px</padding></style>
                        <value>YEAR TO DATE TOTAL</value>
                    </cell>
                </rowcells>
            </cells>
        </table>
        <table id="es2-ytd-table">
            <style><width>100%</width><border>1px solid #cfcfcf</border></style>
            <cells>
                <rowcells>
                    <cell id="es2-ytd-gross-label" type="static"><style><textAlign>left</textAlign><padding>4px 5px</padding></style><value>YEAR TO DATE GROSS</value></cell>
                    <cell id="es2-ytd-gross-value" type="substitute" format="currency"><style><textAlign>right</textAlign><padding>4px 5px</padding></style><value>{grossPayYTD}</value></cell>
                </rowcells>
                <rowcells>
                    <cell id="es2-ytd-ded-label" type="static"><style><textAlign>left</textAlign><padding>4px 5px</padding></style><value>YEAR TO DATE DEDUCTION</value></cell>
                    <cell id="es2-ytd-ded-value" type="calculated" format="currency"><style><textAlign>right</textAlign><padding>4px 5px</padding></style><formula>{totalTaxesYTD} + {totalDeductionsYTD}</formula></cell>
                </rowcells>
                <rowcells>
                    <cell id="es2-ytd-net-label" type="static"><style><textAlign>left</textAlign><padding>4px 5px</padding></style><value>YEAR TO DATE NET</value></cell>
                    <cell id="es2-ytd-net-value" type="substitute" format="currency"><style><textAlign>right</textAlign><padding>4px 5px</padding></style><value>{netPayYTD}</value></cell>
                </rowcells>
            </cells>
        </table>
        <table id="es2-net-bar">
            <style><width>100%</width><backgroundColor>#d3d3d3</backgroundColor><marginTop>34px</marginTop></style>
            <cells>
                <rowcells>
                    <cell id="es2-net-bar-label" type="static">
                        <style><textAlign>center</textAlign><fontWeight>bold</fontWeight><padding>8px 8px</padding></style>
                        <value>NET TOTAL</value>
                    </cell>
                </rowcells>
            </cells>
        </table>
        <table id="es2-net-table">
            <style><width>100%</width><border>1px solid #cfcfcf</border></style>
            <cells>
                <rowcells>
                    <cell id="es2-net-value" type="substitute" format="currency">
                        <style><textAlign>right</textAlign><padding>5px 6px</padding></style>
                        <value>{netPay}</value>
                    </cell>
                </rowcells>
            </cells>
        </table>
    </column>
</section>
