<?xml version='1.0' encoding='utf-8'?>
<paystub>
  <style>
    <fontFamily>'IBM Plex Sans', Arial, Helvetica, sans-serif</fontFamily>
    <color>#000000</color>
    <fontSize>11px</fontSize>
    <border>1px solid #cfcfcf</border>
    <backgroundColor>#ffffff</backgroundColor>
    <paddingBottom>40px</paddingBottom>
  </style>
  <!-- Section es2-header-section -->
  <section id="es2-header-section">
    <style>
      <padding>18px 6px 0</padding>
      <alignItems>center</alignItems>
    </style>
    <column id="es2-header-company" width="44%">
      <table id="es2-company-table">
        <style>
          <width>100%</width>
          <border>1px solid #cfcfcf</border>
        </style>
        <cells>
          <rowcells>
            <cell id="es2-company-name" type="substitute">
              <style>
                <fontSize>13px</fontSize>
                <fontWeight>bold</fontWeight>
                <textAlign>left</textAlign>
                <padding>9px 11px 0 11px</padding>
              </style>
              <value>{companyInfo.companyName}</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="es2-company-address" type="substitute">
              <style>
                <fontSize>11px</fontSize>
                <textAlign>left</textAlign>
                <padding>2px 11px 9px 11px</padding>
              </style>
              <value>{companyAddressLine}</value>
            </cell>
          </rowcells>
        </cells>
      </table>
    </column>
    <column id="es2-header-title" width="56%">
      <table id="es2-title-table">
        <style>
          <width>100%</width>
        </style>
        <cells>
          <rowcells>
            <cell id="es2-statement-title" type="static">
              <style>
                <fontSize>15px</fontSize>
                <fontWeight>bold</fontWeight>
                <textAlign>right</textAlign>
                <padding>8px 10px</padding>
              </style>
              <value>Earnings Statement</value>
            </cell>
          </rowcells>
        </cells>
      </table>
    </column>
  </section>
  <!-- Section es2-employee-band -->
  <section id="es2-employee-band">
    <style>
      <marginTop>24px</marginTop>
      <backgroundColor>#d3d3d3</backgroundColor>
    </style>
    <column id="es2-employee-band-col" width="100%">
      <table id="es2-employee-band-table">
        <style>
          <width>100%</width>
        </style>
        <cells>
          <rowcells>
            <cell id="es2-employee-band-label" type="static">
              <style>
                <textAlign>center</textAlign>
                <fontWeight>bold</fontWeight>
                <fontSize>12px</fontSize>
                <padding>9px 10px</padding>
              </style>
              <value>EMPLOYEE DETAILS</value>
            </cell>
          </rowcells>
        </cells>
      </table>
    </column>
  </section>
  <!-- Section es2-employee-details -->
  <section id="es2-employee-details">
    <style>
      <padding>12px 6px 3px</padding>
    </style>
    <column id="es2-employee-left" width="60%">
      <table id="es2-employee-left-table">
        <style>
          <width>100%</width>
        </style>
        <cells>
          <rowcells>
            <cell id="es2-emp-name" type="substitute">
              <style>
                <textAlign>left</textAlign>
                <padding>5px 0 5px 18px</padding>
              </style>
              <value>Name: {employeeInfo.employeeFirstName} {employeeInfo.employeeLastName}</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="es2-emp-address" type="substitute">
              <style>
                <textAlign>left</textAlign>
                <padding>5px 0 5px 18px</padding>
              </style>
              <value>Address: {employeeAddressLine}</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="es2-emp-marital" type="substitute">
              <style>
                <textAlign>left</textAlign>
                <padding>5px 0 5px 18px</padding>
              </style>
              <value>Taxable Marital Status: {filingStatusLabel}</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="es2-emp-period" type="substitute">
              <style>
                <textAlign>left</textAlign>
                <padding>5px 0 5px 18px</padding>
              </style>
              <value>Reporting Period: {payPeriodLabel}</value>
            </cell>
          </rowcells>
        </cells>
      </table>
    </column>
    <column id="es2-employee-right" width="40%">
      <table id="es2-employee-right-table">
        <style>
          <width>100%</width>
        </style>
        <cells>
          <rowcells>
            <cell id="es2-emp-ssn" colspan="2" type="substitute">
              <style>
                <textAlign>left</textAlign>
                <padding>5px 0</padding>
              </style>
              <value>Social Sec. ID: {employeeSSNMasked}</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="es2-emp-id" colspan="2" type="substitute">
              <style>
                <textAlign>left</textAlign>
                <padding>5px 0</padding>
              </style>
              <value>Employee ID: {employeeInfo.employeeID}</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="es2-emp-exemptions" colspan="2" type="substitute">
              <style>
                <textAlign>left</textAlign>
                <padding>5px 0</padding>
              </style>
              <value>Exemptions/Allowances: {employeeInfo.employeeExemptions}</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="es2-emp-paydate-label" type="static">
              <style>
                <textAlign>left</textAlign>
                <padding>5px 0</padding>
                <whiteSpace>nowrap</whiteSpace>
              </style>
              <value>Pay Date:</value>
            </cell>
            <cell id="es2-emp-paydate-value" type="substitute" format="date">
              <style>
                <textAlign>left</textAlign>
                <padding>5px 0 5px 4px</padding>
                <width>100%</width>
              </style>
              <value>{incomeDetails.periodPayDate}</value>
            </cell>
          </rowcells>
        </cells>
      </table>
    </column>
  </section>
  <!-- Section es2-earnings-band -->
  <section id="es2-earnings-band">
    <style>
      <marginTop>6px</marginTop>
      <backgroundColor>#d3d3d3</backgroundColor>
    </style>
    <column id="es2-earnings-band-col" width="100%">
      <table id="es2-earnings-band-table">
        <style>
          <width>100%</width>
        </style>
        <cells>
          <rowcells>
            <cell id="es2-earnings-band-label" type="static">
              <style>
                <textAlign>center</textAlign>
                <fontWeight>bold</fontWeight>
                <fontSize>12px</fontSize>
                <padding>9px 10px</padding>
              </style>
              <value>EARNINGS</value>
            </cell>
          </rowcells>
        </cells>
      </table>
    </column>
  </section>
  <!-- Section es2-earnings-panels -->
  <section id="es2-earnings-panels">
    <style>
      <padding>16px 16px 0</padding>
      <justifyContent>space-between</justifyContent>
    </style>
    <column id="es2-payment-panel" width="46.5%">
      <style>
        <border>1px solid #cfcfcf</border>
        <minHeight>150px</minHeight>
      </style>
      <table id="es2-payment-bar">
        <style>
          <width>100%</width>
          <backgroundColor>#d3d3d3</backgroundColor>
        </style>
        <cells>
          <rowcells>
            <cell id="es2-payment-bar-label" type="static">
              <style>
                <textAlign>center</textAlign>
                <fontWeight>bold</fontWeight>
                <padding>8px 8px</padding>
              </style>
              <value>PAYMENT</value>
            </cell>
          </rowcells>
        </cells>
      </table>
      <table id="es2-payment-main">
        <style>
          <width>100%</width>
          <tableLayout>fixed</tableLayout>
        </style>
        <header>
          <hdata>
            <hd id="es2-h-pay-desc">
              <style>
                <width>18%</width>
                <padding>7px 5px 5px</padding>
                <fontWeight>normal</fontWeight>
              </style>
              <label> </label>
            </hd>
            <hd id="es2-h-pay-rate">
              <style>
                <width>16%</width>
                <textAlign>center</textAlign>
                <padding>7px 5px 5px</padding>
                <whiteSpace>nowrap</whiteSpace>
              </style>
              <label>RATE</label>
            </hd>
            <hd id="es2-h-pay-hours">
              <style>
                <width>17%</width>
                <textAlign>center</textAlign>
                <padding>7px 5px 5px</padding>
                <whiteSpace>nowrap</whiteSpace>
              </style>
              <label>HOURS</label>
            </hd>
            <hd id="es2-h-pay-current">
              <style>
                <width>23%</width>
                <textAlign>center</textAlign>
                <padding>7px 5px 5px</padding>
                <whiteSpace>nowrap</whiteSpace>
              </style>
              <label>CURRENT</label>
            </hd>
            <hd id="es2-h-pay-ytd">
              <style>
                <width>26%</width>
                <textAlign>center</textAlign>
                <padding>7px 5px 5px</padding>
                <whiteSpace>nowrap</whiteSpace>
              </style>
              <label>YTD</label>
            </hd>
          </hdata>
        </header>
        <cells>
          <rowcells>
            <cell id="es2-reg-desc" type="static">
              <style>
                <width>18%</width>
                <textAlign>left</textAlign>
                <padding>4px 5px</padding>
              </style>
              <value>Regular</value>
            </cell>
            <cell id="es2-reg-rate" type="substitute" format="currency">
              <style>
                <width>16%</width>
                <textAlign>right</textAlign>
                <padding>4px 5px</padding>
              </style>
              <value>{incomeDetails.hourlyRate}</value>
            </cell>
            <cell id="es2-reg-hours" type="substitute" format="number">
              <style>
                <width>17%</width>
                <textAlign>right</textAlign>
                <padding>4px 5px</padding>
              </style>
              <value>{incomeDetails.hoursWorked}</value>
            </cell>
            <cell id="es2-reg-current" type="substitute" format="currency">
              <style>
                <width>23%</width>
                <textAlign>right</textAlign>
                <padding>4px 5px</padding>
              </style>
              <value>{regularPay}</value>
            </cell>
            <cell id="es2-reg-ytd" type="substitute" format="currency">
              <style>
                <width>26%</width>
                <textAlign>right</textAlign>
                <padding>4px 5px</padding>
              </style>
              <value>{regularPayYTD}</value>
            </cell>
          </rowcells>
        </cells>
      </table>
      <table id="es2-payment-overtime" renderIf="overtimePay">
        <style>
          <width>100%</width>
          <tableLayout>fixed</tableLayout>
        </style>
        <cells>
          <rowcells>
            <cell id="es2-ot-desc" type="static">
              <style>
                <width>18%</width>
                <textAlign>left</textAlign>
                <padding>4px 5px</padding>
              </style>
              <value>Overtime</value>
            </cell>
            <cell id="es2-ot-rate" type="substitute" format="currency">
              <style>
                <width>16%</width>
                <textAlign>right</textAlign>
                <padding>4px 5px</padding>
              </style>
              <value>{incomeDetails.overtimeRate}</value>
            </cell>
            <cell id="es2-ot-hours" type="substitute" format="number">
              <style>
                <width>17%</width>
                <textAlign>right</textAlign>
                <padding>4px 5px</padding>
              </style>
              <value>{incomeDetails.overtimeHours}</value>
            </cell>
            <cell id="es2-ot-current" type="substitute" format="currency">
              <style>
                <width>23%</width>
                <textAlign>right</textAlign>
                <padding>4px 5px</padding>
              </style>
              <value>{overtimePay}</value>
            </cell>
            <cell id="es2-ot-ytd" type="substitute" format="currency">
              <style>
                <width>26%</width>
                <textAlign>right</textAlign>
                <padding>4px 5px</padding>
              </style>
              <value>{overtimePayYTD}</value>
            </cell>
          </rowcells>
        </cells>
      </table>
      <table id="es2-payment-bonus" renderIf="otherEarnings">
        <style>
          <width>100%</width>
          <tableLayout>fixed</tableLayout>
        </style>
        <cells>
          <rowcells>
            <cell id="es2-bonus-desc" type="static">
              <style>
                <width>18%</width>
                <textAlign>left</textAlign>
                <padding>4px 5px</padding>
              </style>
              <value>Bonus</value>
            </cell>
            <cell id="es2-bonus-rate" type="static">
              <style>
                <width>16%</width>
                <padding>4px 5px</padding>
              </style>
              <value> </value>
            </cell>
            <cell id="es2-bonus-hours" type="static">
              <style>
                <width>17%</width>
                <padding>4px 5px</padding>
              </style>
              <value> </value>
            </cell>
            <cell id="es2-bonus-current" type="substitute" format="currency">
              <style>
                <width>23%</width>
                <textAlign>right</textAlign>
                <padding>4px 5px</padding>
              </style>
              <value>{otherEarnings}</value>
            </cell>
            <cell id="es2-bonus-ytd" type="substitute" format="currency">
              <style>
                <width>26%</width>
                <textAlign>right</textAlign>
                <padding>4px 5px</padding>
              </style>
              <value>{otherEarningsYTD}</value>
            </cell>
          </rowcells>
        </cells>
      </table>
    </column>
    <column id="es2-deductions-panel" width="46.5%">
      <style>
        <border>1px solid #cfcfcf</border>
        <minHeight>150px</minHeight>
      </style>
      <table id="es2-deductions-bar">
        <style>
          <width>100%</width>
          <backgroundColor>#d3d3d3</backgroundColor>
        </style>
        <cells>
          <rowcells>
            <cell id="es2-deductions-bar-label" type="static">
              <style>
                <textAlign>center</textAlign>
                <fontWeight>bold</fontWeight>
                <padding>8px 8px</padding>
              </style>
              <value>DEDUCTIONS</value>
            </cell>
          </rowcells>
        </cells>
      </table>
      <table id="es2-deductions-main">
        <style>
          <width>100%</width>
          <tableLayout>fixed</tableLayout>
        </style>
        <header>
          <hdata>
            <hd id="es2-h-ded-desc">
              <style>
                <width>38%</width>
                <padding>7px 5px 5px</padding>
                <fontWeight>normal</fontWeight>
              </style>
              <label> </label>
            </hd>
            <hd id="es2-h-ded-current">
              <style>
                <width>25%</width>
                <textAlign>center</textAlign>
                <padding>7px 5px 5px</padding>
                <whiteSpace>nowrap</whiteSpace>
              </style>
              <label>CURRENT</label>
            </hd>
            <hd id="es2-h-ded-ytd">
              <style>
                <width>37%</width>
                <textAlign>center</textAlign>
                <padding>7px 5px 5px</padding>
                <whiteSpace>nowrap</whiteSpace>
              </style>
              <label>YEAR TO DATE</label>
            </hd>
          </hdata>
        </header>
        <cells>
          <rowcells>
            <cell id="es2-med-desc" type="static">
              <style>
                <width>38%</width>
                <textAlign>left</textAlign>
                <padding>4px 5px</padding>
              </style>
              <value>FICA MED TAX</value>
            </cell>
            <cell id="es2-med-current" type="substitute" format="currency">
              <style>
                <width>25%</width>
                <textAlign>right</textAlign>
                <padding>4px 5px</padding>
              </style>
              <value>{medicare}</value>
            </cell>
            <cell id="es2-med-ytd" type="substitute" format="currency">
              <style>
                <width>37%</width>
                <textAlign>right</textAlign>
                <padding>4px 5px</padding>
              </style>
              <value>{medicareYTD}</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="es2-ss-desc" type="static">
              <style>
                <width>38%</width>
                <textAlign>left</textAlign>
                <padding>4px 5px</padding>
              </style>
              <value>FICA SS TAX</value>
            </cell>
            <cell id="es2-ss-current" type="substitute" format="currency">
              <style>
                <width>25%</width>
                <textAlign>right</textAlign>
                <padding>4px 5px</padding>
              </style>
              <value>{socialSecurity}</value>
            </cell>
            <cell id="es2-ss-ytd" type="substitute" format="currency">
              <style>
                <width>37%</width>
                <textAlign>right</textAlign>
                <padding>4px 5px</padding>
              </style>
              <value>{socialSecurityYTD}</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="es2-fed-desc" type="static">
              <style>
                <width>38%</width>
                <textAlign>left</textAlign>
                <padding>4px 5px</padding>
              </style>
              <value>FED TAX</value>
            </cell>
            <cell id="es2-fed-current" type="substitute" format="currency">
              <style>
                <width>25%</width>
                <textAlign>right</textAlign>
                <padding>4px 5px</padding>
              </style>
              <value>{federalTax}</value>
            </cell>
            <cell id="es2-fed-ytd" type="substitute" format="currency">
              <style>
                <width>37%</width>
                <textAlign>right</textAlign>
                <padding>4px 5px</padding>
              </style>
              <value>{federalTaxYTD}</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="es2-st-desc" type="substitute">
              <style>
                <width>38%</width>
                <textAlign>left</textAlign>
                <padding>4px 5px</padding>
              </style>
              <value>{stateTaxLabel}</value>
            </cell>
            <cell id="es2-st-current" type="substitute" format="currency">
              <style>
                <width>25%</width>
                <textAlign>right</textAlign>
                <padding>4px 5px</padding>
              </style>
              <value>{stateTax}</value>
            </cell>
            <cell id="es2-st-ytd" type="substitute" format="currency">
              <style>
                <width>37%</width>
                <textAlign>right</textAlign>
                <padding>4px 5px</padding>
              </style>
              <value>{stateTaxYTD}</value>
            </cell>
          </rowcells>
        </cells>
      </table>
      <table id="es2-deductions-paid-leave" renderIf="paidLeave">
        <style>
          <width>100%</width>
          <tableLayout>fixed</tableLayout>
        </style>
        <cells>
          <rowcells>
            <cell id="es2-pfml-desc" type="substitute">
              <style>
                <width>38%</width>
                <textAlign>left</textAlign>
                <padding>4px 5px</padding>
              </style>
              <value>{paidLeaveLabel}</value>
            </cell>
            <cell id="es2-pfml-current" type="substitute" format="currency">
              <style>
                <width>25%</width>
                <textAlign>right</textAlign>
                <padding>4px 5px</padding>
              </style>
              <value>{paidLeave}</value>
            </cell>
            <cell id="es2-pfml-ytd" type="substitute" format="currency">
              <style>
                <width>37%</width>
                <textAlign>right</textAlign>
                <padding>4px 5px</padding>
              </style>
              <value>{paidLeaveYTD}</value>
            </cell>
          </rowcells>
        </cells>
      </table>
    </column>
  </section>
  <!-- Section es2-earnings-totals -->
  <section id="es2-earnings-totals">
    <style>
      <padding>17px 16px 0</padding>
      <justifyContent>space-between</justifyContent>
    </style>
    <column id="es2-gross-col" width="46.5%">
      <style>
        <border>1px solid #cfcfcf</border>
      </style>
      <table id="es2-gross-table">
        <style>
          <width>100%</width>
        </style>
        <cells>
          <rowcells>
            <cell id="es2-gross-label" type="static">
              <style>
                <textAlign>left</textAlign>
                <fontWeight>bold</fontWeight>
                <padding>5px 6px</padding>
              </style>
              <value>GROSS EARNINGS</value>
            </cell>
            <cell id="es2-gross-value" type="substitute" format="currency">
              <style>
                <textAlign>right</textAlign>
                <padding>5px 6px</padding>
              </style>
              <value>{grossPay}</value>
            </cell>
          </rowcells>
        </cells>
      </table>
    </column>
    <column id="es2-totded-col" width="46.5%">
      <style>
        <border>1px solid #cfcfcf</border>
      </style>
      <table id="es2-totded-table">
        <style>
          <width>100%</width>
        </style>
        <cells>
          <rowcells>
            <cell id="es2-totded-label" type="static">
              <style>
                <textAlign>left</textAlign>
                <fontWeight>bold</fontWeight>
                <padding>5px 6px</padding>
              </style>
              <value>TOTAL DEDUCTIONS</value>
            </cell>
            <cell id="es2-totded-value" type="calculated" format="currency">
              <style>
                <textAlign>right</textAlign>
                <padding>5px 6px</padding>
              </style>
              <formula>{totalTaxes} + {totalDeductions}</formula>
            </cell>
          </rowcells>
        </cells>
      </table>
    </column>
  </section>
  <!-- Section es2-total-band -->
  <section id="es2-total-band">
    <style>
      <marginTop>24px</marginTop>
      <backgroundColor>#d3d3d3</backgroundColor>
    </style>
    <column id="es2-total-band-col" width="100%">
      <table id="es2-total-band-table">
        <style>
          <width>100%</width>
        </style>
        <cells>
          <rowcells>
            <cell id="es2-total-band-label" type="static">
              <style>
                <textAlign>center</textAlign>
                <fontWeight>bold</fontWeight>
                <fontSize>12px</fontSize>
                <padding>9px 10px</padding>
              </style>
              <value>TOTAL</value>
            </cell>
          </rowcells>
        </cells>
      </table>
    </column>
  </section>
  <!-- Section es2-total-summary -->
  <section id="es2-total-summary">
    <style>
      <padding>34px 16px 0</padding>
      <justifyContent>flex-end</justifyContent>
    </style>
    <column id="es2-total-summary-col" width="40%">
      <table id="es2-ytd-bar">
        <style>
          <width>100%</width>
          <backgroundColor>#d3d3d3</backgroundColor>
        </style>
        <cells>
          <rowcells>
            <cell id="es2-ytd-bar-label" type="static">
              <style>
                <textAlign>center</textAlign>
                <fontWeight>bold</fontWeight>
                <padding>8px 8px</padding>
              </style>
              <value>YEAR TO DATE TOTAL</value>
            </cell>
          </rowcells>
        </cells>
      </table>
      <table id="es2-ytd-table">
        <style>
          <width>100%</width>
          <border>1px solid #cfcfcf</border>
        </style>
        <cells>
          <rowcells>
            <cell id="es2-ytd-gross-label" type="static">
              <style>
                <textAlign>left</textAlign>
                <padding>4px 5px</padding>
              </style>
