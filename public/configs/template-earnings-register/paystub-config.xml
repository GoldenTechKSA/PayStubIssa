<?xml version='1.0' encoding='utf-8'?>
<paystub>
  <style>
    <fontFamily>'IBM Plex Sans', Arial, Helvetica, sans-serif</fontFamily>
    <color>#000000</color>
    <fontSize>11px</fontSize>
    <border>1px solid #d4d4d4</border>
    <backgroundColor>#ffffff</backgroundColor>
    <padding>18px 0 60px 0</padding>
  </style>
  <!-- Section er-header-section -->
  <section id="er-header-section">
    <style>
      <padding>0 26px</padding>
    </style>
    <column id="er-header-left" width="57%">
      <style>
        <paddingLeft>100px</paddingLeft>
      </style>
      <table id="er-code-strip">
        <style>
          <backgroundColor>#e8e8e8</backgroundColor>
          <tableLayout>fixed</tableLayout>
          <width>92%</width>
        </style>
        <header>
          <hdata>
            <hd id="er-h-ein">
              <style>
                <width>34%</width>
                <textAlign>left</textAlign>
                <fontSize>8px</fontSize>
                <fontWeight>normal</fontWeight>
                <padding>3px 4px 0</padding>
                <whiteSpace>nowrap</whiteSpace>
              </style>
              <label>EIN</label>
            </hd>
            <hd id="er-h-empid">
              <style>
                <width>26%</width>
                <textAlign>left</textAlign>
                <fontSize>8px</fontSize>
                <fontWeight>normal</fontWeight>
                <padding>3px 4px 0</padding>
                <whiteSpace>nowrap</whiteSpace>
              </style>
              <label>EMPLOYEE ID</label>
            </hd>
            <hd id="er-h-stub">
              <style>
                <width>16%</width>
                <textAlign>left</textAlign>
                <fontSize>8px</fontSize>
                <fontWeight>normal</fontWeight>
                <padding>3px 4px 0</padding>
                <whiteSpace>nowrap</whiteSpace>
              </style>
              <label>STUB</label>
            </hd>
            <hd id="er-h-chk">
              <style>
                <width>24%</width>
                <textAlign>left</textAlign>
                <fontSize>8px</fontSize>
                <fontWeight>normal</fontWeight>
                <padding>3px 4px 0</padding>
                <whiteSpace>nowrap</whiteSpace>
              </style>
              <label>CHECK NO.</label>
            </hd>
          </hdata>
        </header>
        <cells>
          <rowcells>
            <cell id="er-v-ein" type="substitute">
              <style>
                <width>34%</width>
                <textAlign>left</textAlign>
                <fontSize>8px</fontSize>
                <padding>0 4px 3px</padding>
              </style>
              <value>{companyInfo.companyEIN}</value>
            </cell>
            <cell id="er-v-empid" type="substitute">
              <style>
                <width>26%</width>
                <textAlign>left</textAlign>
                <fontSize>8px</fontSize>
                <padding>0 4px 3px</padding>
              </style>
              <value>{employeeInfo.employeeID}</value>
            </cell>
            <cell id="er-v-stub" type="substitute">
              <style>
                <width>16%</width>
                <textAlign>left</textAlign>
                <fontSize>8px</fontSize>
                <padding>0 4px 3px</padding>
              </style>
              <value>{stubNumber}</value>
            </cell>
            <cell id="er-v-chk" type="substitute">
              <style>
                <width>24%</width>
                <textAlign>left</textAlign>
                <fontSize>8px</fontSize>
                <padding>0 4px 3px</padding>
              </style>
              <value>{checkNumber}</value>
            </cell>
          </rowcells>
        </cells>
      </table>
      <table id="er-company-table">
        <style>
          <width>100%</width>
          <marginTop>16px</marginTop>
        </style>
        <cells>
          <rowcells>
            <cell id="er-company-name" type="substitute">
              <style>
                <textAlign>left</textAlign>
                <fontSize>14px</fontSize>
                <fontWeight>bold</fontWeight>
                <padding>0 0 1px</padding>
              </style>
              <value>{companyInfo.companyName}</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="er-company-city" type="substitute">
              <style>
                <textAlign>left</textAlign>
                <fontSize>14px</fontSize>
                <fontWeight>bold</fontWeight>
                <padding>0</padding>
              </style>
              <value>{companyCityStateZip}</value>
            </cell>
          </rowcells>
        </cells>
      </table>
      <table id="er-employee-detail">
        <style>
          <width>100%</width>
          <marginTop>22px</marginTop>
        </style>
        <cells>
          <rowcells>
            <cell id="er-ssn-label" type="static">
              <style>
                <textAlign>left</textAlign>
                <padding>1px 0</padding>
                <whiteSpace>nowrap</whiteSpace>
              </style>
              <value>Social Security Number:</value>
            </cell>
            <cell id="er-ssn-value" type="substitute">
              <style>
                <textAlign>left</textAlign>
                <padding>1px 0 1px 14px</padding>
                <width>100%</width>
              </style>
              <value>{employeeSSNMasked}</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="er-marital-label" type="static">
              <style>
                <textAlign>left</textAlign>
                <padding>1px 0</padding>
                <whiteSpace>nowrap</whiteSpace>
              </style>
              <value>Taxable Marital Status:</value>
            </cell>
            <cell id="er-marital-value" type="substitute">
              <style>
                <textAlign>left</textAlign>
                <padding>1px 0 1px 14px</padding>
              </style>
              <value>{filingStatusLabel}</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="er-exempt-label" type="static">
              <style>
                <textAlign>left</textAlign>
                <padding>1px 0</padding>
                <whiteSpace>nowrap</whiteSpace>
              </style>
              <value>Exemptions / Allowances:</value>
            </cell>
            <cell id="er-exempt-value" type="substitute">
              <style>
                <textAlign>left</textAlign>
                <padding>1px 0 1px 14px</padding>
              </style>
              <value>{employeeInfo.employeeExemptions}</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="er-empid-label" type="static">
              <style>
                <textAlign>left</textAlign>
                <padding>1px 0</padding>
                <whiteSpace>nowrap</whiteSpace>
              </style>
              <value>Employee ID:</value>
            </cell>
            <cell id="er-empid-value" type="substitute">
              <style>
                <textAlign>left</textAlign>
                <padding>1px 0 1px 14px</padding>
              </style>
              <value>{employeeInfo.employeeID}</value>
            </cell>
          </rowcells>
        </cells>
      </table>
    </column>
    <column id="er-header-right" width="43%">
      <table id="er-title-table">
        <style>
          <width>100%</width>
        </style>
        <cells>
          <rowcells>
            <cell id="er-title" type="static">
              <style>
                <textAlign>left</textAlign>
                <fontSize>18px</fontSize>
                <fontWeight>bold</fontWeight>
                <padding>0 0 10px</padding>
              </style>
              <value>Earnings Statement</value>
            </cell>
          </rowcells>
        </cells>
      </table>
      <table id="er-period-table">
        <style>
          <width>100%</width>
        </style>
        <cells>
          <rowcells>
            <cell id="er-pb-label" type="static">
              <style>
                <textAlign>left</textAlign>
                <padding>3px 0</padding>
                <whiteSpace>nowrap</whiteSpace>
              </style>
              <value>Period Beginning:</value>
            </cell>
            <cell id="er-pb-value" type="substitute" format="date">
              <style>
                <textAlign>left</textAlign>
                <padding>3px 0 3px 22px</padding>
                <width>100%</width>
              </style>
              <value>{incomeDetails.periodStartDate}</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="er-pe-label" type="static">
              <style>
                <textAlign>left</textAlign>
                <padding>3px 0</padding>
                <whiteSpace>nowrap</whiteSpace>
              </style>
              <value>Period Ending:</value>
            </cell>
            <cell id="er-pe-value" type="substitute" format="date">
              <style>
                <textAlign>left</textAlign>
                <padding>3px 0 3px 22px</padding>
              </style>
              <value>{incomeDetails.periodEndDate}</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="er-pd-label" type="static">
              <style>
                <textAlign>left</textAlign>
                <padding>3px 0</padding>
                <whiteSpace>nowrap</whiteSpace>
              </style>
              <value>Pay Date:</value>
            </cell>
            <cell id="er-pd-value" type="substitute" format="date">
              <style>
                <textAlign>left</textAlign>
                <padding>3px 0 3px 22px</padding>
              </style>
              <value>{incomeDetails.periodPayDate}</value>
            </cell>
          </rowcells>
        </cells>
      </table>
      <table id="er-employee-table">
        <style>
          <width>100%</width>
          <marginTop>20px</marginTop>
        </style>
        <cells>
          <rowcells>
            <cell id="er-emp-name" type="substitute">
              <style>
                <textAlign>left</textAlign>
                <fontSize>13px</fontSize>
                <fontWeight>bold</fontWeight>
                <padding>0 0 1px</padding>
                <whiteSpace>normal</whiteSpace>
              </style>
              <value>{employeeInfo.employeeFirstName} {employeeInfo.employeeLastName}</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="er-emp-addr" type="substitute">
              <style>
                <textAlign>left</textAlign>
                <fontSize>13px</fontSize>
                <fontWeight>bold</fontWeight>
                <padding>0</padding>
                <whiteSpace>normal</whiteSpace>
              </style>
              <value>{employeeInfo.employeeAddress1} {employeeAddressLine}</value>
            </cell>
          </rowcells>
        </cells>
      </table>
    </column>
  </section>
  <!-- Section er-ledger-section -->
  <section id="er-ledger-section">
    <style>
      <padding>26px 26px 0</padding>
    </style>
    <column id="er-ledger-left" width="57%">
      <table id="er-earnings-head">
        <style>
          <width>100%</width>
          <tableLayout>fixed</tableLayout>
          <marginTop>14px</marginTop>
        </style>
        <header>
          <hdata>
            <hd id="er-eh-desc">
              <style>
                <width>24%</width>
                <textAlign>left</textAlign>
                <padding>0 0 2px</padding>
                <whiteSpace>nowrap</whiteSpace>
              </style>
              <label>Earnings</label>
            </hd>
            <hd id="er-eh-rate">
              <style>
                <width>15%</width>
                <textAlign>right</textAlign>
                <padding>0 5px 2px 0</padding>
                <borderBottom>1px solid #555555</borderBottom>
                <whiteSpace>nowrap</whiteSpace>
              </style>
              <label>Rate</label>
            </hd>
            <hd id="er-eh-hours">
              <style>
                <width>15%</width>
                <textAlign>right</textAlign>
                <padding>0 5px 2px 0</padding>
                <borderBottom>1px solid #555555</borderBottom>
                <whiteSpace>nowrap</whiteSpace>
              </style>
              <label>Hours</label>
            </hd>
            <hd id="er-eh-amount">
              <style>
                <width>19%</width>
                <textAlign>right</textAlign>
                <padding>0 5px 2px 0</padding>
                <borderBottom>1px solid #555555</borderBottom>
                <whiteSpace>nowrap</whiteSpace>
              </style>
              <label>Amount</label>
            </hd>
            <hd id="er-eh-gap">
              <style>
                <width>3%</width>
                <padding>0</padding>
              </style>
              <label> </label>
            </hd>
            <hd id="er-eh-ytd">
              <style>
                <width>24%</width>
                <textAlign>right</textAlign>
                <padding>0 0 2px</padding>
                <borderBottom>1px solid #555555</borderBottom>
                <whiteSpace>nowrap</whiteSpace>
              </style>
              <label>Year To Date</label>
            </hd>
          </hdata>
        </header>
        <cells>
          <rowcells>
            <cell id="er-reg-desc" type="static">
              <style>
                <width>24%</width>
                <textAlign>left</textAlign>
                <padding>3px 0</padding>
              </style>
              <value>Regular</value>
            </cell>
            <cell id="er-reg-rate" type="substitute" format="number">
              <style>
                <width>15%</width>
                <textAlign>right</textAlign>
                <padding>3px 5px 3px 0</padding>
              </style>
              <value>{incomeDetails.hourlyRate}</value>
            </cell>
            <cell id="er-reg-hours" type="substitute" format="number">
              <style>
                <width>15%</width>
                <textAlign>right</textAlign>
                <padding>3px 5px 3px 0</padding>
              </style>
              <value>{incomeDetails.hoursWorked}</value>
            </cell>
            <cell id="er-reg-amount" type="substitute" format="number">
              <style>
                <width>19%</width>
                <textAlign>right</textAlign>
                <padding>3px 5px 3px 0</padding>
              </style>
              <value>{regularPay}</value>
            </cell>
            <cell id="er-reg-gap" type="static">
              <style>
                <width>3%</width>
                <padding>0</padding>
              </style>
              <value> </value>
            </cell>
            <cell id="er-reg-ytd" type="substitute" format="number">
              <style>
                <width>24%</width>
                <textAlign>right</textAlign>
                <padding>3px 0</padding>
              </style>
              <value>{regularPayYTD}</value>
            </cell>
          </rowcells>
        </cells>
      </table>
      <table id="er-earnings-ot" renderIf="overtimePay">
        <style>
          <width>100%</width>
          <tableLayout>fixed</tableLayout>
        </style>
        <cells>
          <rowcells>
            <cell id="er-ot-desc" type="static">
              <style>
                <width>24%</width>
                <textAlign>left</textAlign>
                <padding>3px 0</padding>
              </style>
              <value>Overtime Hourly</value>
            </cell>
            <cell id="er-ot-rate" type="substitute" format="number">
              <style>
                <width>15%</width>
                <textAlign>right</textAlign>
                <padding>3px 5px 3px 0</padding>
              </style>
              <value>{incomeDetails.overtimeRate}</value>
            </cell>
            <cell id="er-ot-hours" type="substitute" format="number">
              <style>
                <width>15%</width>
                <textAlign>right</textAlign>
                <padding>3px 5px 3px 0</padding>
              </style>
              <value>{incomeDetails.overtimeHours}</value>
            </cell>
            <cell id="er-ot-amount" type="substitute" format="number">
              <style>
                <width>19%</width>
                <textAlign>right</textAlign>
                <padding>3px 5px 3px 0</padding>
              </style>
              <value>{overtimePay}</value>
            </cell>
            <cell id="er-ot-gap" type="static">
              <style>
                <width>3%</width>
                <padding>0</padding>
              </style>
              <value> </value>
            </cell>
            <cell id="er-ot-ytd" type="substitute" format="number">
              <style>
                <width>24%</width>
                <textAlign>right</textAlign>
                <padding>3px 0</padding>
              </style>
              <value>{overtimePayYTD}</value>
            </cell>
          </rowcells>
        </cells>
      </table>
      <table id="er-earnings-bonus" renderIf="otherEarnings">
        <style>
          <width>100%</width>
          <tableLayout>fixed</tableLayout>
        </style>
        <cells>
          <rowcells>
            <cell id="er-bon-desc" type="static">
              <style>
                <width>24%</width>
                <textAlign>left</textAlign>
                <padding>3px 0</padding>
              </style>
              <value>Bonus</value>
            </cell>
            <cell id="er-bon-rate" type="static">
              <style>
                <width>15%</width>
                <padding>3px 5px 3px 0</padding>
              </style>
              <value> </value>
            </cell>
            <cell id="er-bon-hours" type="static">
              <style>
                <width>15%</width>
                <padding>3px 5px 3px 0</padding>
              </style>
              <value> </value>
            </cell>
            <cell id="er-bon-amount" type="substitute" format="number">
              <style>
                <width>19%</width>
                <textAlign>right</textAlign>
                <padding>3px 5px 3px 0</padding>
              </style>
              <value>{otherEarnings}</value>
            </cell>
            <cell id="er-bon-gap" type="static">
              <style>
                <width>3%</width>
                <padding>0</padding>
              </style>
              <value> </value>
            </cell>
            <cell id="er-bon-ytd" type="substitute" format="number">
              <style>
                <width>24%</width>
                <textAlign>right</textAlign>
                <padding>3px 0</padding>
              </style>
              <value>{otherEarningsYTD}</value>
            </cell>
          </rowcells>
        </cells>
      </table>
      <table id="er-gross">
        <style>
          <width>100%</width>
          <tableLayout>fixed</tableLayout>
          <marginTop>4px</marginTop>
        </style>
        <cells>
          <rowcells>
            <cell id="er-gross-pad" type="static">
              <style>
                <width>24%</width>
                <padding>4px 0</padding>
              </style>
              <value> </value>
            </cell>
            <cell id="er-gross-label" type="static">
              <style>
                <width>30%</width>
                <textAlign>left</textAlign>
                <fontWeight>bold</fontWeight>
                <padding>4px 0 4px 5px</padding>
                <backgroundColor>#e8e8e8</backgroundColor>
                <borderTop>1px solid #555555</borderTop>
              </style>
              <value>Gross Pay</value>
            </cell>
            <cell id="er-gross-amount" type="substitute" format="number">
              <style>
                <width>19%</width>
                <textAlign>right</textAlign>
                <fontWeight>bold</fontWeight>
                <padding>4px 5px 4px 0</padding>
                <backgroundColor>#e8e8e8</backgroundColor>
                <borderTop>1px solid #555555</borderTop>
              </style>
              <value>{grossPay}</value>
            </cell>
            <cell id="er-gross-gap" type="static">
              <style>
                <width>3%</width>
                <padding>0</padding>
              </style>
              <value> </value>
            </cell>
            <cell id="er-gross-ytd" type="substitute" format="number">
              <style>
                <width>24%</width>
                <textAlign>right</textAlign>
                <padding>4px 0</padding>
              </style>
              <value>{grossPayYTD}</value>
            </cell>
          </rowcells>
        </cells>
      </table>
      <table id="er-deductions-head">
        <style>
          <width>100%</width>
          <tableLayout>fixed</tableLayout>
          <marginTop>20px</marginTop>
        </style>
        <header>
          <hdata>
            <hd id="er-dh-desc">
              <style>
                <width>24%</width>
                <textAlign>left</textAlign>
                <padding>0 0 2px</padding>
                <whiteSpace>nowrap</whiteSpace>
              </style>
              <label>Deductions</label>
            </hd>
            <hd id="er-dh-stat">
              <style>
                <width>30%</width>
                <textAlign>left</textAlign>
                <padding>0 0 2px 5px</padding>
                <borderBottom>1px solid #555555</borderBottom>
                <whiteSpace>nowrap</whiteSpace>
              </style>
              <label>Statutory</label>
            </hd>
            <hd id="er-dh-amt">
              <style>
                <width>19%</width>
                <padding>0 5px 2px 0</padding>
                <borderBottom>1px solid #555555</borderBottom>
              </style>
              <label> </label>
            </hd>
            <hd id="er-dh-gap">
              <style>
                <width>3%</width>
                <padding>0</padding>
              </style>
              <label> </label>
            </hd>
            <hd id="er-dh-ytd">
              <style>
                <width>24%</width>
                <padding>0 0 2px</padding>
                <borderBottom>1px solid #555555</borderBottom>
              </style>
              <label> </label>
            </hd>
          </hdata>
        </header>
        <cells>
          <rowcells>
            <cell id="er-fmed-pad" type="static">
              <style>
                <width>24%</width>
                <padding>2px 0</padding>
              </style>
              <value> </value>
            </cell>
            <cell id="er-fmed-label" type="static">
              <style>
                <width>30%</width>
                <textAlign>left</textAlign>
                <padding>2px 0 2px 5px</padding>
              </style>
              <value>FICA MED TAX</value>
            </cell>
            <cell id="er-fmed-cur" type="calculated" format="number">
              <style>
                <width>19%</width>
                <textAlign>right</textAlign>
                <padding>2px 5px 2px 0</padding>
              </style>
              <formula>0 - {medicare}</formula>
            </cell>
            <cell id="er-fmed-gap" type="static">
              <style>
                <width>3%</width>
                <padding>0</padding>
              </style>
              <value> </value>
            </cell>
            <cell id="er-fmed-ytd" type="substitute" format="number">
              <style>
                <width>24%</width>
                <textAlign>right</textAlign>
                <padding>2px 0</padding>
              </style>
              <value>{medicareYTD}</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="er-fss-pad" type="static">
              <style>
                <width>24%</width>
                <padding>2px 0</padding>
              </style>
              <value> </value>
            </cell>
            <cell id="er-fss-label" type="static">
              <style>
                <width>30%</width>
                <textAlign>left</textAlign>
                <padding>2px 0 2px 5px</padding>
              </style>
              <value>FICA SS TAX</value>
            </cell>
            <cell id="er-fss-cur" type="calculated" format="number">
              <style>
                <width>19%</width>
                <textAlign>right</textAlign>
                <padding>2px 5px 2px 0</padding>
              </style>
              <formula>0 - {socialSecurity}</formula>
            </cell>
            <cell id="er-fss-gap" type="static">
              <style>
                <width>3%</width>
                <padding>0</padding>
              </style>
              <value> </value>
            </cell>
            <cell id="er-fss-ytd" type="substitute" format="number">
              <style>
                <width>24%</width>
                <textAlign>right</textAlign>
                <padding>2px 0</padding>
              </style>
              <value>{socialSecurityYTD}</value>
            </cell>
          </rowcells>
          <rowcells>
            <cell id="er-fed-pad" type="static">
              <style>
                <width>24%</width>
                <padding>2px 0</padding>
              </style>
              <value> </value>
            </cell>
            <cell id="er-fed-label" type="static">
              <style>
                <width>30%</width>
                <textAlign>left</textAlign>
                <padding>2px 0 2px 5px</padding>
              </style>
              <value>FED TAX</value>
            </cell>
            <cell id="er-fed-cur" type="calculated" format="number">
              <style>
                <width>19%</width>
                <textAlign>right</textAlign>
                <padding>2px 5px 2px 0</padding>
              </style>
              <formula>0 - {federalTax}</formula>
            </cell>
            <cell id="er-fed-gap" type="static">
              <style>
                <width>3%</width>
                <padding>0</padding>
              </style>
