    <style>
        <fontFamily>'IBM Plex Sans', Arial, Helvetica, sans-serif</fontFamily>
        <color>#000000</color>
        <fontSize>11px</fontSize>
        <border>1px solid #d4d4d4</border>
        <backgroundColor>#ffffff</backgroundColor>
        <padding>18px 0 60px 0</padding>
    </style>
    <include href="header/header-section.xml"/>
    <include href="body/ledger-section.xml"/>
</paystub>
