<?xml version='1.0' encoding='utf-8'?>
<!-- The ledger. Two grids share the same column boundaries so every rule and fill lines up:
     earnings item rows run 24/15/15/19/3/24, and every summary or deduction row runs
     24/30/19/3/24 - the 30 spans what would be Rate plus Hours, which is where the
     reference puts its Statutory labels. Both end at the same edges. -->
<section id="er-ledger-section">
    <style><padding>26px 26px 0</padding></style>

    <column id="er-ledger-left" width="57%">
        <table id="er-earnings-head">
            <style><width>100%</width><tableLayout>fixed</tableLayout><marginTop>14px</marginTop></style>
            <header>
                <hdata>
                    <hd id="er-eh-desc"><style><width>24%</width><textAlign>left</textAlign><padding>0 0 2px</padding><whiteSpace>nowrap</whiteSpace></style><label>Earnings</label></hd>
                    <hd id="er-eh-rate"><style><width>15%</width><textAlign>right</textAlign><padding>0 5px 2px 0</padding><borderBottom>1px solid #555555</borderBottom><whiteSpace>nowrap</whiteSpace></style><label>Rate</label></hd>
                    <hd id="er-eh-hours"><style><width>15%</width><textAlign>right</textAlign><padding>0 5px 2px 0</padding><borderBottom>1px solid #555555</borderBottom><whiteSpace>nowrap</whiteSpace></style><label>Hours</label></hd>
                    <hd id="er-eh-amount"><style><width>19%</width><textAlign>right</textAlign><padding>0 5px 2px 0</padding><borderBottom>1px solid #555555</borderBottom><whiteSpace>nowrap</whiteSpace></style><label>Amount</label></hd>
                    <hd id="er-eh-gap"><style><width>3%</width><padding>0</padding></style><label> </label></hd>
                    <hd id="er-eh-ytd"><style><width>24%</width><textAlign>right</textAlign><padding>0 0 2px</padding><borderBottom>1px solid #555555</borderBottom><whiteSpace>nowrap</whiteSpace></style><label>Year To Date</label></hd>
                </hdata>
            </header>
            <cells>
                <rowcells>
                    <cell id="er-reg-desc" type="static"><style><width>24%</width><textAlign>left</textAlign><padding>3px 0</padding></style><value>Regular</value></cell>
                    <cell id="er-reg-rate" type="substitute" format="number"><style><width>15%</width><textAlign>right</textAlign><padding>3px 5px 3px 0</padding></style><value>{incomeDetails.hourlyRate}</value></cell>
                    <cell id="er-reg-hours" type="substitute" format="number"><style><width>15%</width><textAlign>right</textAlign><padding>3px 5px 3px 0</padding></style><value>{incomeDetails.hoursWorked}</value></cell>
                    <cell id="er-reg-amount" type="substitute" format="number"><style><width>19%</width><textAlign>right</textAlign><padding>3px 5px 3px 0</padding></style><value>{regularPay}</value></cell>
                    <cell id="er-reg-gap" type="static"><style><width>3%</width><padding>0</padding></style><value> </value></cell>
                    <cell id="er-reg-ytd" type="substitute" format="number"><style><width>24%</width><textAlign>right</textAlign><padding>3px 0</padding></style><value>{regularPayYTD}</value></cell>
                </rowcells>
            </cells>
        </table>
        <table id="er-earnings-ot" renderIf="overtimePay">
            <style><width>100%</width><tableLayout>fixed</tableLayout></style>
            <cells>
                <rowcells>
                    <cell id="er-ot-desc" type="static"><style><width>24%</width><textAlign>left</textAlign><padding>3px 0</padding></style><value>Overtime Hourly</value></cell>
                    <cell id="er-ot-rate" type="substitute" format="number"><style><width>15%</width><textAlign>right</textAlign><padding>3px 5px 3px 0</padding></style><value>{incomeDetails.overtimeRate}</value></cell>
                    <cell id="er-ot-hours" type="substitute" format="number"><style><width>15%</width><textAlign>right</textAlign><padding>3px 5px 3px 0</padding></style><value>{incomeDetails.overtimeHours}</value></cell>
                    <cell id="er-ot-amount" type="substitute" format="number"><style><width>19%</width><textAlign>right</textAlign><padding>3px 5px 3px 0</padding></style><value>{overtimePay}</value></cell>
                    <cell id="er-ot-gap" type="static"><style><width>3%</width><padding>0</padding></style><value> </value></cell>
                    <cell id="er-ot-ytd" type="substitute" format="number"><style><width>24%</width><textAlign>right</textAlign><padding>3px 0</padding></style><value>{overtimePayYTD}</value></cell>
                </rowcells>
            </cells>
        </table>
        <table id="er-earnings-bonus" renderIf="otherEarnings">
            <style><width>100%</width><tableLayout>fixed</tableLayout></style>
            <cells>
                <rowcells>
                    <cell id="er-bon-desc" type="static"><style><width>24%</width><textAlign>left</textAlign><padding>3px 0</padding></style><value>Bonus</value></cell>
                    <cell id="er-bon-rate" type="static"><style><width>15%</width><padding>3px 5px 3px 0</padding></style><value> </value></cell>
                    <cell id="er-bon-hours" type="static"><style><width>15%</width><padding>3px 5px 3px 0</padding></style><value> </value></cell>
                    <cell id="er-bon-amount" type="substitute" format="number"><style><width>19%</width><textAlign>right</textAlign><padding>3px 5px 3px 0</padding></style><value>{otherEarnings}</value></cell>
                    <cell id="er-bon-gap" type="static"><style><width>3%</width><padding>0</padding></style><value> </value></cell>
                    <cell id="er-bon-ytd" type="substitute" format="number"><style><width>24%</width><textAlign>right</textAlign><padding>3px 0</padding></style><value>{otherEarningsYTD}</value></cell>
                </rowcells>
            </cells>
        </table>
        <table id="er-gross">
            <style><width>100%</width><tableLayout>fixed</tableLayout><marginTop>4px</marginTop></style>
            <cells>
                <rowcells>
                    <cell id="er-gross-pad" type="static"><style><width>24%</width><padding>4px 0</padding></style><value> </value></cell>
                    <cell id="er-gross-label" type="static"><style><width>30%</width><textAlign>left</textAlign><fontWeight>bold</fontWeight><padding>4px 0 4px 5px</padding><backgroundColor>#e8e8e8</backgroundColor><borderTop>1px solid #555555</borderTop></style><value>Gross Pay</value></cell>
                    <cell id="er-gross-amount" type="substitute" format="number"><style><width>19%</width><textAlign>right</textAlign><fontWeight>bold</fontWeight><padding>4px 5px 4px 0</padding><backgroundColor>#e8e8e8</backgroundColor><borderTop>1px solid #555555</borderTop></style><value>{grossPay}</value></cell>
                    <cell id="er-gross-gap" type="static"><style><width>3%</width><padding>0</padding></style><value> </value></cell>
                    <cell id="er-gross-ytd" type="substitute" format="number"><style><width>24%</width><textAlign>right</textAlign><padding>4px 0</padding></style><value>{grossPayYTD}</value></cell>
                </rowcells>
            </cells>
        </table>
        <table id="er-deductions-head">
            <style><width>100%</width><tableLayout>fixed</tableLayout><marginTop>20px</marginTop></style>
            <header>
                <hdata>
                    <hd id="er-dh-desc"><style><width>24%</width><textAlign>left</textAlign><padding>0 0 2px</padding><whiteSpace>nowrap</whiteSpace></style><label>Deductions</label></hd>
                    <hd id="er-dh-stat"><style><width>30%</width><textAlign>left</textAlign><padding>0 0 2px 5px</padding><borderBottom>1px solid #555555</borderBottom><whiteSpace>nowrap</whiteSpace></style><label>Statutory</label></hd>
                    <hd id="er-dh-amt"><style><width>19%</width><padding>0 5px 2px 0</padding><borderBottom>1px solid #555555</borderBottom></style><label> </label></hd>
                    <hd id="er-dh-gap"><style><width>3%</width><padding>0</padding></style><label> </label></hd>
                    <hd id="er-dh-ytd"><style><width>24%</width><padding>0 0 2px</padding><borderBottom>1px solid #555555</borderBottom></style><label> </label></hd>
                </hdata>
            </header>
            <cells>
                <rowcells>
                    <cell id="er-fmed-pad" type="static"><style><width>24%</width><padding>2px 0</padding></style><value> </value></cell>
                    <cell id="er-fmed-label" type="static"><style><width>30%</width><textAlign>left</textAlign><padding>2px 0 2px 5px</padding></style><value>FICA MED TAX</value></cell>
                    <cell id="er-fmed-cur" type="calculated" format="number"><style><width>19%</width><textAlign>right</textAlign><padding>2px 5px 2px 0</padding></style><formula>0 - {medicare}</formula></cell>
                    <cell id="er-fmed-gap" type="static"><style><width>3%</width><padding>0</padding></style><value> </value></cell>
                    <cell id="er-fmed-ytd" type="substitute" format="number"><style><width>24%</width><textAlign>right</textAlign><padding>2px 0</padding></style><value>{medicareYTD}</value></cell>
                </rowcells>
                <rowcells>
                    <cell id="er-fss-pad" type="static"><style><width>24%</width><padding>2px 0</padding></style><value> </value></cell>
                    <cell id="er-fss-label" type="static"><style><width>30%</width><textAlign>left</textAlign><padding>2px 0 2px 5px</padding></style><value>FICA SS TAX</value></cell>
                    <cell id="er-fss-cur" type="calculated" format="number"><style><width>19%</width><textAlign>right</textAlign><padding>2px 5px 2px 0</padding></style><formula>0 - {socialSecurity}</formula></cell>
                    <cell id="er-fss-gap" type="static"><style><width>3%</width><padding>0</padding></style><value> </value></cell>
                    <cell id="er-fss-ytd" type="substitute" format="number"><style><width>24%</width><textAlign>right</textAlign><padding>2px 0</padding></style><value>{socialSecurityYTD}</value></cell>
                </rowcells>
                <rowcells>
                    <cell id="er-fed-pad" type="static"><style><width>24%</width><padding>2px 0</padding></style><value> </value></cell>
                    <cell id="er-fed-label" type="static"><style><width>30%</width><textAlign>left</textAlign><padding>2px 0 2px 5px</padding></style><value>FED TAX</value></cell>
                    <cell id="er-fed-cur" type="calculated" format="number"><style><width>19%</width><textAlign>right</textAlign><padding>2px 5px 2px 0</padding></style><formula>0 - {federalTax}</formula></cell>
                    <cell id="er-fed-gap" type="static"><style><width>3%</width><padding>0</padding></style><value> </value></cell>
                    <cell id="er-fed-ytd" type="substitute" format="number"><style><width>24%</width><textAlign>right</textAlign><padding>2px 0</padding></style><value>{federalTaxYTD}</value></cell>
                </rowcells>
                <rowcells>
                    <cell id="er-st-pad" type="static"><style><width>24%</width><padding>2px 0</padding></style><value> </value></cell>
                    <cell id="er-st-label" type="substitute"><style><width>30%</width><textAlign>left</textAlign><padding>2px 0 2px 5px</padding></style><value>{stateTaxLabel}</value></cell>
                    <cell id="er-st-cur" type="calculated" format="number"><style><width>19%</width><textAlign>right</textAlign><padding>2px 5px 2px 0</padding></style><formula>0 - {stateTax}</formula></cell>
                    <cell id="er-st-gap" type="static"><style><width>3%</width><padding>0</padding></style><value> </value></cell>
                    <cell id="er-st-ytd" type="substitute" format="number"><style><width>24%</width><textAlign>right</textAlign><padding>2px 0</padding></style><value>{stateTaxYTD}</value></cell>
                </rowcells>
            </cells>
        </table>
        <table id="er-paid-leave" renderIf="paidLeave">
            <style><width>100%</width><tableLayout>fixed</tableLayout></style>
            <cells>
                <rowcells>
                    <cell id="er-pfml-pad" type="static"><style><width>24%</width><padding>2px 0</padding></style><value> </value></cell>
                    <cell id="er-pfml-label" type="substitute"><style><width>30%</width><textAlign>left</textAlign><padding>2px 0 2px 5px</padding></style><value>{paidLeaveLabel}</value></cell>
                    <cell id="er-pfml-cur" type="calculated" format="number"><style><width>19%</width><textAlign>right</textAlign><padding>2px 5px 2px 0</padding></style><formula>0 - {paidLeave}</formula></cell>
                    <cell id="er-pfml-gap" type="static"><style><width>3%</width><padding>0</padding></style><value> </value></cell>
                    <cell id="er-pfml-ytd" type="substitute" format="number"><style><width>24%</width><textAlign>right</textAlign><padding>2px 0</padding></style><value>{paidLeaveYTD}</value></cell>
                </rowcells>
            </cells>
        </table>
        <table id="er-netpay">
            <style><width>100%</width><tableLayout>fixed</tableLayout></style>
            <cells>
                <rowcells>
                    <cell id="er-netpay-pad" type="static"><style><width>24%</width><padding>4px 0</padding></style><value> </value></cell>
                    <cell id="er-netpay-label" type="static"><style><width>30%</width><textAlign>left</textAlign><fontWeight>bold</fontWeight><padding>4px 0 4px 5px</padding><backgroundColor>#e8e8e8</backgroundColor><borderTop>1px solid #555555</borderTop><borderBottom>1px solid #555555</borderBottom></style><value>Net Pay</value></cell>
                    <cell id="er-netpay-amt" type="substitute" format="currency"><style><width>19%</width><textAlign>right</textAlign><fontWeight>bold</fontWeight><padding>4px 5px 4px 0</padding><backgroundColor>#e8e8e8</backgroundColor><borderTop>1px solid #555555</borderTop><borderBottom>1px solid #555555</borderBottom></style><value>{netPay}</value></cell>
                    <cell id="er-netpay-gap" type="static"><style><width>3%</width><padding>0</padding></style><value> </value></cell>
                    <cell id="er-netpay-ytd" type="static"><style><width>24%</width><padding>4px 0</padding></style><value> </value></cell>
                </rowcells>
            </cells>
        </table>
        <table id="er-disburse">
            <style><width>100%</width><tableLayout>fixed</tableLayout></style>
            <cells>
                <rowcells>
                    <cell id="er-disburse-pad" type="static"><style><width>24%</width><padding>4px 0</padding></style><value> </value></cell>
                    <cell id="er-disburse-label" type="substitute"><style><width>30%</width><textAlign>left</textAlign><padding>4px 0 4px 5px</padding><borderBottom>1px solid #555555</borderBottom></style><value>{generalInfo.paymentMethod}</value></cell>
                    <cell id="er-disburse-amt" type="calculated" format="currency"><style><width>19%</width><textAlign>right</textAlign><padding>4px 5px 4px 0</padding><borderBottom>1px solid #555555</borderBottom></style><formula>0 - {netPay}</formula></cell>
                    <cell id="er-disburse-gap" type="static"><style><width>3%</width><padding>0</padding></style><value> </value></cell>
                    <cell id="er-disburse-ytd" type="static"><style><width>24%</width><padding>4px 0</padding></style><value> </value></cell>
                </rowcells>
            </cells>
        </table>
        <table id="er-netcheck">
            <style><width>100%</width><tableLayout>fixed</tableLayout></style>
            <cells>
                <rowcells>
                    <cell id="er-netcheck-pad" type="static"><style><width>24%</width><padding>4px 0</padding></style><value> </value></cell>
                    <cell id="er-netcheck-label" type="static"><style><width>30%</width><textAlign>left</textAlign><fontWeight>bold</fontWeight><padding>4px 0 4px 5px</padding><backgroundColor>#e8e8e8</backgroundColor><borderBottom>1px solid #555555</borderBottom></style><value>Net Check</value></cell>
                    <cell id="er-netcheck-amt" type="calculated" format="currency"><style><width>19%</width><textAlign>right</textAlign><fontWeight>bold</fontWeight><padding>4px 5px 4px 0</padding><backgroundColor>#e8e8e8</backgroundColor><borderBottom>1px solid #555555</borderBottom></style><formula>{netPay} - {netPay}</formula></cell>
                    <cell id="er-netcheck-gap" type="static"><style><width>3%</width><padding>0</padding></style><value> </value></cell>
                    <cell id="er-netcheck-ytd" type="static"><style><width>24%</width><padding>4px 0</padding></style><value> </value></cell>
                </rowcells>
            </cells>
        </table>
    </column>

    <column id="er-ledger-right" width="43%" renderIf="totalDeductions">
        <style><paddingLeft>26px</paddingLeft></style>
        <table id="er-benefits-title">
            <style><width>100%</width></style>
            <cells>
                <rowcells>
                    <cell id="er-bt-line1" type="static"><style><textAlign>left</textAlign><padding>0</padding></style><value>Other Benefits and</value></cell>
                </rowcells>
            </cells>
        </table>
        <table id="er-benefits-head">
            <style><width>100%</width><tableLayout>fixed</tableLayout></style>
            <header>
                <hdata>
                    <hd id="er-bh-desc"><style><width>44%</width><textAlign>left</textAlign><padding>0 0 2px</padding><borderBottom>1px solid #555555</borderBottom><whiteSpace>nowrap</whiteSpace></style><label>Information</label></hd>
                    <hd id="er-bh-cur"><style><width>24%</width><textAlign>right</textAlign><padding>0 5px 2px 0</padding><borderBottom>1px solid #555555</borderBottom><whiteSpace>nowrap</whiteSpace></style><label>This Period</label></hd>
                    <hd id="er-bh-gap"><style><width>3%</width><padding>0</padding></style><label> </label></hd>
                    <hd id="er-bh-ytd"><style><width>29%</width><textAlign>right</textAlign><padding>0 0 2px</padding><borderBottom>1px solid #555555</borderBottom><whiteSpace>nowrap</whiteSpace></style><label>Year To Date</label></hd>
                </hdata>
            </header>
            <cells>
                <rowcells>
                    <cell id="er-bh-spacer-a" type="static"><style><width>44%</width><padding>0</padding></style><value> </value></cell>
                    <cell id="er-bh-spacer-b" type="static"><style><width>24%</width><padding>0</padding></style><value> </value></cell>
                    <cell id="er-bh-spacer-c" type="static"><style><width>3%</width><padding>0</padding></style><value> </value></cell>
                    <cell id="er-bh-spacer-d" type="static"><style><width>29%</width><padding>0</padding></style><value> </value></cell>
                </rowcells>
            </cells>
        </table>
        <table id="er-ben-health" renderIf="medical">
            <style><width>100%</width><tableLayout>fixed</tableLayout></style>
            <cells>
                <rowcells>
                    <cell id="er-ben-health-label" type="static"><style><width>44%</width><textAlign>left</textAlign><padding>2px 0</padding></style><value>HEALTH INS</value></cell>
                    <cell id="er-ben-health-cur" type="substitute" format="number"><style><width>24%</width><textAlign>right</textAlign><padding>2px 5px 2px 0</padding></style><value>{medical}</value></cell>
                    <cell id="er-ben-health-gap" type="static"><style><width>3%</width><padding>0</padding></style><value> </value></cell>
                    <cell id="er-ben-health-ytd" type="substitute" format="number"><style><width>29%</width><textAlign>right</textAlign><padding>2px 0</padding></style><value>{medicalYTD}</value></cell>
                </rowcells>
            </cells>
        </table>
        <table id="er-ben-dental" renderIf="dental">
            <style><width>100%</width><tableLayout>fixed</tableLayout></style>
            <cells>
                <rowcells>
                    <cell id="er-ben-dental-label" type="static"><style><width>44%</width><textAlign>left</textAlign><padding>2px 0</padding></style><value>DENTAL INS</value></cell>
                    <cell id="er-ben-dental-cur" type="substitute" format="number"><style><width>24%</width><textAlign>right</textAlign><padding>2px 5px 2px 0</padding></style><value>{dental}</value></cell>
                    <cell id="er-ben-dental-gap" type="static"><style><width>3%</width><padding>0</padding></style><value> </value></cell>
                    <cell id="er-ben-dental-ytd" type="substitute" format="number"><style><width>29%</width><textAlign>right</textAlign><padding>2px 0</padding></style><value>{dentalYTD}</value></cell>
                </rowcells>
            </cells>
        </table>
        <table id="er-ben-vision" renderIf="vision">
            <style><width>100%</width><tableLayout>fixed</tableLayout></style>
            <cells>
                <rowcells>
                    <cell id="er-ben-vision-label" type="static"><style><width>44%</width><textAlign>left</textAlign><padding>2px 0</padding></style><value>VISION INS</value></cell>
                    <cell id="er-ben-vision-cur" type="substitute" format="number"><style><width>24%</width><textAlign>right</textAlign><padding>2px 5px 2px 0</padding></style><value>{vision}</value></cell>
                    <cell id="er-ben-vision-gap" type="static"><style><width>3%</width><padding>0</padding></style><value> </value></cell>
                    <cell id="er-ben-vision-ytd" type="substitute" format="number"><style><width>29%</width><textAlign>right</textAlign><padding>2px 0</padding></style><value>{visionYTD}</value></cell>
                </rowcells>
            </cells>
        </table>
        <table id="er-ben-retire" renderIf="retirement401k">
            <style><width>100%</width><tableLayout>fixed</tableLayout></style>
            <cells>
                <rowcells>
                    <cell id="er-ben-retire-label" type="static"><style><width>44%</width><textAlign>left</textAlign><padding>2px 0</padding></style><value>401(K)</value></cell>
                    <cell id="er-ben-retire-cur" type="substitute" format="number"><style><width>24%</width><textAlign>right</textAlign><padding>2px 5px 2px 0</padding></style><value>{retirement401k}</value></cell>
                    <cell id="er-ben-retire-gap" type="static"><style><width>3%</width><padding>0</padding></style><value> </value></cell>
                    <cell id="er-ben-retire-ytd" type="substitute" format="number"><style><width>29%</width><textAlign>right</textAlign><padding>2px 0</padding></style><value>{retirement401kYTD}</value></cell>
                </rowcells>
            </cells>
        </table>
        <table id="er-ben-otherded" renderIf="otherDeductions">
            <style><width>100%</width><tableLayout>fixed</tableLayout></style>
            <cells>
                <rowcells>
                    <cell id="er-ben-otherded-label" type="static"><style><width>44%</width><textAlign>left</textAlign><padding>2px 0</padding></style><value>OTHER</value></cell>
                    <cell id="er-ben-otherded-cur" type="substitute" format="number"><style><width>24%</width><textAlign>right</textAlign><padding>2px 5px 2px 0</padding></style><value>{otherDeductions}</value></cell>
                    <cell id="er-ben-otherded-gap" type="static"><style><width>3%</width><padding>0</padding></style><value> </value></cell>
                    <cell id="er-ben-otherded-ytd" type="substitute" format="number"><style><width>29%</width><textAlign>right</textAlign><padding>2px 0</padding></style><value>{otherDeductionsYTD}</value></cell>
                </rowcells>
            </cells>
        </table>
        <table id="er-ben-total" renderIf="totalDeductions">
            <style><width>100%</width><tableLayout>fixed</tableLayout></style>
            <cells>
                <rowcells>
                    <cell id="er-ben-total-label" type="static"><style><width>44%</width><textAlign>left</textAlign><fontWeight>bold</fontWeight><padding>4px 0</padding><borderTop>1px solid #555555</borderTop></style><value>Total Benefits</value></cell>
                    <cell id="er-ben-total-cur" type="substitute" format="number"><style><width>24%</width><textAlign>right</textAlign><fontWeight>bold</fontWeight><padding>4px 5px 4px 0</padding><borderTop>1px solid #555555</borderTop></style><value>{totalDeductions}</value></cell>
                    <cell id="er-ben-total-gap" type="static"><style><width>3%</width><padding>0</padding></style><value> </value></cell>
                    <cell id="er-ben-total-ytd" type="substitute" format="number"><style><width>29%</width><textAlign>right</textAlign><fontWeight>bold</fontWeight><padding>4px 0</padding><borderTop>1px solid #555555</borderTop></style><value>{totalDeductionsYTD}</value></cell>
                </rowcells>
            </cells>
        </table>
    </column>
</section>
