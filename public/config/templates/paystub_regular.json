      "data_type": "currency",
      "format": "$0,000.00",
      "position": {
        "section": "summary",
        "order": 1,
        "column": 1
      },
      "calculation": "regular_pay + overtime_pay + bonusAmount",
      "defaultValue": 2187.5,
      "editable": false
    },
    {
      "field_id": "current_deductions",
      "label": "Current Total Deductions",
      "data_type": "currency",
      "format": "$0,000.00",
      "position": {
        "section": "summary",
        "order": 1,
        "column": 2
      },
      "calculation": "federal_income_tax + state_income_tax + social_security_tax + medicare_tax + deduction401k + medicalDeduction + dentalDeduction + visionDeduction + otherDeduction",
