      "data_type": "currency",
      "format": "$0.00",
      "position": {
        "section": "pay_details",
        "order": 1,
        "column": 1
      },
      "defaultValue": 25.0
    },
    {
      "field_id": "hoursWorked",
      "label": "Hours Worked",
      "data_type": "number",
      "format": "0.00",
      "position": {
        "section": "pay_details",
        "order": 2,
        "column": 1
      },
      "defaultValue": 80
    },
    {
      "field_id": "regular_pay",
      "label": "Regular Pay",
      "data_type": "currency",
      "format": "$0.00",
      "position": {
        "section": "pay_details",
        "order": 3,
        "column": 1
      },
      "calculation": "hourlyRate * hoursWorked",
      "defaultValue": 2000.0,
      "editable": false
    },
    {
      "field_id": "overtimeRate",
