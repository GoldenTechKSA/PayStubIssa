{
  "metadata": {
    "template_id": "paystub_regular",
    "title": "Standard Employee Paystub",
    "version": "3.0",
    "description": "The standard paystub for a regular, ongoing employee. This template calculates standard withholdings (federal/state tax, FICA) and is suitable for most traditional employment relationships with a consistent schedule.",
    "category": "standard"
  },
  "sections": [
    {
      "section_id": "company_header",
      "order": 1,
      "layout_type": "grid",
      "columns": 3,
      "styling": "bg-black text-white"
    },
    {
      "section_id": "employee_details",
      "title": "Employee Information",
      "order": 2,
      "layout_type": "grid",
      "columns": 3,
      "styling": "bg-black text-white"
    },
    {
      "section_id": "pay_details",
      "title": "Pay Details",
      "order": 3,
      "layout_type": "grid",
      "columns": 3,
      "styling": "py-4 px-4"
    },
    {
      "section_id": "summary",
      "title": "Summary",
      "order": 4,
      "layout_type": "grid",
      "columns": 3,
      "styling": "bg-blue-100 font-bold py-4 px-4 border-t-2 border-blue-600"
    }
  ],
