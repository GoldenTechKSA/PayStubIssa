{
  "metadata": {
    "template_id": "classic_blue",
    "title": "Classic Blue",
    "version": "2.0",
    "description": "3-column layout paystub with company info, logo, and statement title",
    "category": "standard"
  },
  "sections": [
    {
      "section_id": "company_header",
      "title": "Company Header",
      "order": 1,
      "layout_type": "grid",
      "columns": 3,
      "styling": "bg-blue-50 border-b-2 border-blue-600 py-4 px-4"
    },
    {
      "section_id": "employee_details",
      "title": "Employee Information",
      "order": 2,
      "layout_type": "grid",
      "columns": 3,
      "styling": "bg-gray-50 py-4 px-4 border-b border-gray-300"
    },
    {
      "section_id": "pay_details",
      "title": "Pay Details",
      "order": 3,
      "layout_type": "grid",
      "columns": 3,
      "styling": "py-4 px-4"
    },
    {
      "section_id": "summary",
      "title": "Summary",
      "order": 4,
      "layout_type": "grid",
      "columns": 3,
      "styling": "bg-blue-100 font-bold py-4 px-4 border-t-2 border-blue-600"
    }
  ],
