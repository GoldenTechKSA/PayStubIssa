{
  "metadata": {
    "template_id": "executive_premium",
    "title": "Executive Premium",
    "version": "1.0",
    "description": "Luxury design for executive compensation packages",
    "category": "premium"
  },
  "sections": [
    {
      "section_id": "header",
      "title": "Executive Compensation Statement",
      "order": 1,
      "layout_type": "flex",
      "styling": "bg-gradient-to-r from-purple-900 to-indigo-900 text-white p-6 rounded-t-lg"
    },
    {
      "section_id": "executive_info",
      "title": "Executive Information",
      "order": 2,
      "layout_type": "grid",
      "columns": 3,
      "styling": "border-b-2 border-purple-200 py-4 px-6"
    },
    {
      "section_id": "base_compensation",
      "title": "Base Compensation",
      "order": 3,
      "layout_type": "table",
      "styling": "mx-6 my-4 border border-purple-200 rounded-lg"
    },
    {
      "section_id": "incentives",
      "title": "Incentives & Bonuses",
      "order": 4,
      "layout_type": "table",
      "styling": "mx-6 my-4 border border-purple-200 rounded-lg"
    },
    {
      "section_id": "benefits",
      "title": "Executive Benefits",
      "order": 5,
      "layout_type": "table",
      "styling": "mx-6 my-4 border border-purple-200 rounded-lg"
    },
    {
      "section_id": "equity",
      "title": "Equity Compensation",
      "order": 6,
      "layout_type": "table",
      "styling": "mx-6 my-4 border border-purple-200 rounded-lg"
    },
    {
      "section_id": "deductions",
      "title": "Deductions",
      "order": 7,
      "layout_type": "table",
      "styling": "mx-6 my-4 border border-purple-200 rounded-lg"
    },
    {
      "section_id": "summary",
      "title": "Total Compensation",
      "order": 8,
      "layout_type": "grid",
      "columns": 2,
      "styling": "bg-gradient-to-r from-purple-50 to-indigo-50 p-6 mx-6 mb-6 rounded-lg"
    }
  ],
  "fields": [
    {
      "field_id": "company_name",
      "label": "Company",
      "data_type": "string",
      "position": {
        "section": "header",
        "order": 1
      },
      "defaultValue": "Global Enterprises Inc.",
      "required": true
    },
    {
      "field_id": "executive_name",
      "label": "Executive Name",
      "data_type": "string",
      "position": {
        "section": "executive_info",
        "order": 1,
        "column": 1
      },
      "defaultValue": "Sarah Williams",
      "required": true
    },
    {
      "field_id": "title",
      "label": "Title",
      "data_type": "string",
      "position": {
        "section": "executive_info",
        "order": 2,
        "column": 2
      },
      "defaultValue": "Chief Financial Officer",
      "required": true
    },
    {
      "field_id": "executive_id",
      "label": "Executive ID",
      "data_type": "string",
      "position": {
        "section": "executive_info",
        "order": 3,
        "column": 3
      },
      "defaultValue": "EXE-2025-001",
      "required": true
    },
    {
      "field_id": "pay_period_start",
      "label": "Period Start",
      "data_type": "date",
      "format": "MMM DD, YYYY",
      "position": {
        "section": "executive_info",
        "order": 4,
        "column": 1
      },
      "defaultValue": "01/01/2025"
    },
    {
      "field_id": "pay_period_end",
      "label": "Period End",
      "data_type": "date",
      "format": "MMM DD, YYYY",
      "position": {
        "section": "executive_info",
        "order": 5,
        "column": 2
      },
      "defaultValue": "01/31/2025"
    },
    {
      "field_id": "pay_date",
      "label": "Pay Date",
      "data_type": "date",
      "format": "MMM DD, YYYY",
      "position": {
        "section": "executive_info",
        "order": 6,
        "column": 3
      },
      "defaultValue": "02/05/2025"
    },
    {
      "field_id": "base_salary",
      "label": "Base Salary",
      "data_type": "currency",
      "format": "$0,000.00",
      "position": {
        "section": "base_compensation",
        "order": 1
      },
      "defaultValue": 25000.0,
      "required": true
    },
    {
      "field_id": "housing_allowance",
      "label": "Housing Allowance",
      "data_type": "currency",
      "format": "$0,000.00",
      "position": {
        "section": "base_compensation",
        "order": 2
      },
      "defaultValue": 3000.0
    },
    {
      "field_id": "car_allowance",
      "label": "Car Allowance",
      "data_type": "currency",
      "format": "$0,000.00",
      "position": {
        "section": "base_compensation",
        "order": 3
      },
      "defaultValue": 1500.0
    },
    {
      "field_id": "performance_bonus",
      "label": "Performance Bonus",
      "data_type": "currency",
      "format": "$0,000.00",
      "position": {
        "section": "incentives",
        "order": 1
      },
      "defaultValue": 10000.0
    },
    {
      "field_id": "annual_bonus",
      "label": "Annual Bonus Pro-Rata",
      "data_type": "currency",
      "format": "$0,000.00",
      "position": {
        "section": "incentives",
        "order": 2
      },
      "defaultValue": 8333.33
    },
    {
      "field_id": "signing_bonus",
      "label": "Signing Bonus",
      "data_type": "currency",
      "format": "$0,000.00",
      "position": {
        "section": "incentives",
        "order": 3
      },
      "defaultValue": 0.0
    },
    {
      "field_id": "health_premium",
      "label": "Executive Health Plan",
      "data_type": "currency",
      "format": "$0,000.00",
      "position": {
        "section": "benefits",
        "order": 1
      },
      "defaultValue": 500.0
    },
    {
      "field_id": "life_insurance",
      "label": "Life Insurance Premium",
      "data_type": "currency",
      "format": "$0,000.00",
      "position": {
        "section": "benefits",
        "order": 2
      },
      "defaultValue": 250.0
    },
    {
      "field_id": "retirement_match",
      "label": "401(k) Company Match",
      "data_type": "currency",
      "format": "$0,000.00",
      "position": {
        "section": "benefits",
        "order": 3
      },
      "defaultValue": 2000.0
    },
    {
      "field_id": "stock_options_value",
      "label": "Stock Options Vested",
      "data_type": "currency",
      "format": "$0,000.00",
      "position": {
        "section": "equity",
        "order": 1
      },
      "defaultValue": 5000.0
    },
    {
      "field_id": "rsu_value",
      "label": "RSU Vested Value",
      "data_type": "currency",
      "format": "$0,000.00",
      "position": {
        "section": "equity",
        "order": 2
      },
      "defaultValue": 7500.0
    },
    {
      "field_id": "federal_tax",
      "label": "Federal Tax",
      "data_type": "currency",
      "format": "$0,000.00",
      "position": {
        "section": "deductions",
        "order": 1
      },
      "defaultValue": 12000.0
    },
    {
      "field_id": "state_tax",
      "label": "State Tax",
      "data_type": "currency",
      "format": "$0,000.00",
      "position": {
        "section": "deductions",
        "order": 2
      },
      "defaultValue": 3500.0
    },
    {
      "field_id": "medicare",
      "label": "Medicare",
      "data_type": "currency",
      "format": "$0,000.00",
      "position": {
        "section": "deductions",
        "order": 3
      },
      "defaultValue": 435.0
    },
    {
      "field_id": "social_security",
      "label": "Social Security",
      "data_type": "currency",
      "format": "$0,000.00",
      "position": {
        "section": "deductions",
        "order": 4
      },
      "defaultValue": 1860.0
    },
    {
      "field_id": "retirement_contribution",
      "label": "401(k) Contribution",
      "data_type": "currency",
      "format": "$0,000.00",
      "position": {
        "section": "deductions",
        "order": 5
      },
      "defaultValue": 2500.0
    },
    {
      "field_id": "gross_compensation",
      "label": "Gross Compensation",
      "data_type": "currency",
      "format": "$0,000.00",
      "position": {
        "section": "summary",
        "order": 1,
        "column": 1
      },
      "calculation": "base_salary + housing_allowance + car_allowance + performance_bonus + annual_bonus + signing_bonus",
      "defaultValue": 47833.33,
      "editable": false
    },
    {
      "field_id": "total_benefits",
      "label": "Total Benefits",
      "data_type": "currency",
      "format": "$0,000.00",
      "position": {
        "section": "summary",
        "order": 2,
        "column": 1
      },
      "calculation": "health_premium + life_insurance + retirement_match",
      "defaultValue": 2750.0,
      "editable": false
    },
    {
      "field_id": "equity_compensation",
      "label": "Equity Compensation",
      "data_type": "currency",
      "format": "$0,000.00",
      "position": {
        "section": "summary",
        "order": 3,
        "column": 1
      },
      "calculation": "stock_options_value + rsu_value",
      "defaultValue": 12500.0,
      "editable": false
    },
    {
      "field_id": "total_deductions",
      "label": "Total Deductions",
      "data_type": "currency",
      "format": "$0,000.00",
      "position": {
        "section": "summary",
        "order": 4,
        "column": 2
      },
      "calculation": "federal_tax + state_tax + medicare + social_security + retirement_contribution",
      "defaultValue": 20295.0,
      "editable": false
    },
    {
      "field_id": "net_payment",
      "label": "Net Payment",
      "data_type": "currency",
      "format": "$0,000.00",
      "position": {
        "section": "summary",
        "order": 5,
        "column": 2
      },
      "calculation": "gross_compensation - total_deductions",
      "defaultValue": 27538.33,
      "editable": false
    },
    {
      "field_id": "total_package",
      "label": "Total Compensation Package",
      "data_type": "currency",
      "format": "$0,000.00",
      "position": {
        "section": "summary",
        "order": 6,
        "column": 2
      },
      "calculation": "gross_compensation + total_benefits + equity_compensation",
      "defaultValue": 63083.33,
      "editable": false
    }
  ],
  "styling": {
    "primaryColor": "#6b21a8",
    "secondaryColor": "#8b5cf6",
    "backgroundColor": "#ffffff",
    "fontFamily": "Georgia, serif",
    "borderColor": "#e9d5ff",
    "headerBackground": "#581c87"
  },
  "layout": {
    "maxWidth": "900px",
    "padding": "0",
    "margin": "auto"
  }
}