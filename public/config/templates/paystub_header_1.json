      "field_id": "companyName",
      "data_type": "string",
      "source": "company_name",
      "position": {
        "section": "company_header",
        "order": 1,
        "column": 1
      },
      "defaultValue": "ABC Corporation",
      "required": true,
      "styling": "label_fontsize"
    },
    {
