{
  "metadata": {
    "template_id": "paystub_header_1",
    "title": "Standard Employee Paystub",
    "version": "4.0",
    "description": "The standard paystub for a regular, ongoing employee. This template calculates standard withholdings (federal/state tax, FICA) and is suitable for most traditional employment relationships with a consistent schedule.",
    "category": "standard"
  },
  "sections": [
    {
      "section_id": "company_header",
      "order": 1,
      "layout_type": "grid",
      "columns": 3,
      "styling": "bg-light border-top border-primary",
      "fields": [
        {
          "field_id": "companyName",
          "data_type": "string",
          "source": "company_name",
          "position": { "section": "company_header", "order": 1, "column": 1 },
          "defaultValue": "ABC Corporation",
          "required": true,
          "styling": "label_fontsize"
        },
        {
          "field_id": "companyFullAddress",
          "data_type": "string",
          "source": "company_address",
          "position": { "section": "company_header", "order": 2, "column": 1 },
          "defaultValue": "Issam 123 Business Street, New York, NY 10001",
          "styling": "label_fontsize"
        },
        {
          "field_id": "companyPhone",
          "data_type": "phone",
          "source": "company_phone",
          "position": { "section": "company_header", "order": 3, "column": 1 },
          "defaultValue": "(555) 123-4567",
          "styling": "label_fontsize"
        },
        {
          "field_id": "companyEmail",
          "data_type": "email",
          "source": "company_email",
          "position": { "section": "company_header", "order": 4, "column": 1 },
          "defaultValue": "payroll@company.com",
          "styling": "label_fontsize"
        },
        {
          "field_id": "companyEIN",
          "label": "EIN",
          "source": "company_tax_id",
          "data_type": "string",
          "position": { "section": "company_header", "order": 5, "column": 1 },
          "defaultValue": "12-3456789",
          "styling": "label_fontsize"
        },
        {
          "field_id": "company_logo",
          "source": "company_logo",
          "data_type": "image",
          "position": { "section": "company_header", "order": 1, "column": 2 },
          "defaultValue": "[LOGO1]",
          "styling": "label_fontsize"
        },
        {
          "field_id": "paystub_title",
          "source": "paystub_title",
          "data_type": "string",
          "position": { "section": "company_header", "order": 1, "column": 3 },
          "defaultValue": "EARNINGS STATEMENT",
          "styling": "paystub_heading_fontsize"
        },
        {
          "field_id": "payStubNumber",
          "label": "Pay Stub Number",
          "data_type": "string",
          "source": "paystub_id",
          "position": { "section": "company_header", "order": 2, "column": 3 },
          "defaultValue": "PS-2025-001",
          "styling": "label_fontsize"
        },
        {
          "field_id": "checkNumber",
          "label": "Check Number",
          "data_type": "string",
          "source": "check_number",
          "position": { "section": "company_header", "order": 3, "column": 3 },
          "defaultValue": "CHK-12345",
          "styling": "label_fontsize"
        },
        {
          "field_id": "periodStartDate",
          "label": "Pay Period Start",
          "data_type": "date",
          "format": "MM/DD/YYYY",
          "source": "pay_period_start",
          "position": { "section": "company_header", "order": 4, "column": 3 },
          "defaultValue": "01/01/2025",
          "styling": "label_fontsize"
        },
        {
          "field_id": "periodEndDate",
          "label": "Pay Period End",
          "data_type": "date",
          "format": "MM/DD/YYYY",
          "source": "pay_period_end",
          "position": { "section": "company_header", "order": 5, "column": 3 },
          "defaultValue": "01/15/2025",
          "styling": "label_fontsize"
        },
        {
          "field_id": "periodPayDate",
          "label": "Pay Date",
          "data_type": "date",
          "format": "MM/DD/YYYY",
          "source": "pay_date",
          "position": { "section": "company_header", "order": 6, "column": 3 },
          "defaultValue": "01/20/2025",
          "styling": "label_fontsize"
        },
        {
          "field_id": "periodDateRange",
          "label": "Pay Period",
          "data_type": "date",
          "format": "MM/DD/YYYY to MM/DD/YYYY",
          "source": "pay_period",
          "position": { "section": "company_header", "order": 7, "column": 3 },
          "defaultValue": "Issam 01/01/2025 to 01/15/2025",
          "styling": "label_fontsize"
        }
      ]
    },
    {
      "section_id": "employee_details",
      "order": 2,
      "layout_type": "grid",
      "columns": 3,
      "styling": "border-top border-primary",
      "fields": [
        {
          "field_id": "employeeFullName",
          "data_type": "string",
          "source": "employee_name",
          "position": { "section": "employee_details", "order": 1, "column": 1 },
          "defaultValue": "John M. Doe",
          "required": true,
          "styling": "label_fontsize"
        },
        {
          "field_id": "employeeID",
          "label": "Employee ID",
          "data_type": "string",
          "source": "employee_id",
          "position": { "section": "employee_details", "order": 2, "column": 1 },
          "defaultValue": "EMP-001",
          "required": true,
          "styling": "label_fontsize"
        },
        {
          "field_id": "employeeSSN",
          "label": "SSN (Last 4)",
          "data_type": "string",
          "source": "employee_ssn",
          "position": { "section": "employee_details", "order": 3, "column": 1 },
          "defaultValue": "XXX-XX-1234",
          "styling": "label_fontsize"
        },
        {
          "field_id": "employeeMarriedStatus",
          "label": "Filing Status",
          "data_type": "string",
          "source": "employee_status",
          "position": { "section": "employee_details", "order": 4, "column": 1 },
          "defaultValue": "Single",
          "styling": "label_fontsize"
        },
        {
          "field_id": "employeeFullAddress",
          "data_type": "string",
          "source": "employee_address",
          "position": { "section": "employee_details", "order": 1, "column": 2 },
          "defaultValue": "456 Elm Street, Brooklyn, NY 11201",
          "styling": "label_fontsize"
        },
        {
          "field_id": "employeePhone",
          "label": "Phone",
          "data_type": "phone",
          "source": "employee_phone",
          "position": { "section": "employee_details", "order": 2, "column": 2 },
          "defaultValue": "(555) 987-6543",
          "styling": "label_fontsize"
        },
        {
          "field_id": "employeeEmail",
          "label": "Email",
          "data_type": "email",
          "source": "employee_email",
          "position": { "section": "employee_details", "order": 3, "column": 2 },
          "defaultValue": "john.doe@email.com",
          "styling": "label_fontsize"
        },
        {
          "field_id": "employeeHireDate",
          "label": "Hire Date",
          "data_type": "date",
          "source": "employee_hire_date",
          "position": { "section": "employee_details", "order": 4, "column": 2 },
          "defaultValue": "01/01/2025",
          "styling": "label_fontsize"
        },
        {
          "field_id": "employmentType",
          "label": "Employment Type",
          "data_type": "string",
          "source": "employment_type",
          "position": { "section": "employee_details", "order": 1, "column": 3 },
          "defaultValue": "Full-Time",
          "styling": "label_fontsize"
        },
        {
          "field_id": "wageType",
          "label": "Wage Type",
          "data_type": "string",
          "source": "employee_wage_type",
          "position": { "section": "employee_details", "order": 2, "column": 3 },
          "defaultValue": "Hourly",
          "styling": "label_fontsize"
        },
        {
          "field_id": "paymentMethod",
          "label": "Payment Method",
          "data_type": "string",
          "source": "payment_method",
          "position": { "section": "employee_details", "order": 3, "column": 3 },
          "defaultValue": "Direct Deposit",
          "styling": "label_fontsize"
        },
        {
          "field_id": "paymentFrequency",
          "label": "Pay Frequency",
          "data_type": "string",
          "source": "payment_frequency",
          "position": { "section": "employee_details", "order": 4, "column": 3 },
          "defaultValue": "Bi-Weekly",
          "styling": "label_fontsize"
        }
      ]
    },
    {
      "section_id": "pay_details",
      "title": "Pay Details",
      "order": 3,
      "layout_type": "table",
      "styling": "border-top border-primary",
      "fields": [
        {
          "field_id": "hourlyRate",
          "label": "Hourly Rate",
          "data_type": "currency",
          "format": "$0.00",
          "source": "incomeDetails.hourlyRate",
          "position": { "section": "pay_details", "order": 1, "column": 1 },
          "defaultValue": 25.0,
          "styling": "label_fontsize"
        },
        {
          "field_id": "hoursWorked",
          "label": "Hours Worked",
          "data_type": "number",
          "format": "0.00",
          "source": "incomeDetails.hoursWorked",
          "position": { "section": "pay_details", "order": 1, "column": 1 },
          "defaultValue": 80,
          "styling": "label_fontsize"
        },
        {
          "field_id": "regular_pay",
          "label": "Regular Pay",
          "data_type": "currency",
          "format": "$0.00",
          "source": "incomeDetails.regularPay",
          "position": { "section": "pay_details", "order": 1, "column": 1 },
          "calculation": "hourlyRate * hoursWorked",
          "defaultValue": 2000.0,
          "editable": false,
          "styling": "label_fontsize"
        },
        {
          "field_id": "overtimeRate",
          "label": "Overtime Rate",
          "data_type": "currency",
          "format": "$0.00",
          "source": "incomeDetails.overtimeRate",
          "position": { "section": "pay_details", "order": 2, "column": 1 },
          "defaultValue": 37.5,
          "styling": "label_fontsize"
        },
        {
          "field_id": "overtimeHours",
          "label": "Overtime Hours",
          "data_type": "number",
          "format": "0.00",
          "source": "incomeDetails.overtimeHours",
          "position": { "section": "pay_details", "order": 2, "column": 1 },
          "defaultValue": 5,
          "styling": "label_fontsize"
        },
        {
          "field_id": "overtime_pay",
          "label": "Overtime Pay",
          "data_type": "currency",
          "format": "$0.00",
          "source": "incomeDetails.overtimePay",
          "position": { "section": "pay_details", "order": 2, "column": 1 },
          "calculation": "overtimeRate * overtimeHours",
          "defaultValue": 187.5,
          "editable": false,
          "styling": "label_fontsize"
        },
        {
          "field_id": "bonusAmount",
