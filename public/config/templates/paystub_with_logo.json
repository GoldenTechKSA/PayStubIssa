{
  "metadata": {
    "template_id": "paystub_with_logo",
    "title": "Standard Employee Paystub",
    "version": "1.4",
    "description": "The standard paystub for a regular, ongoing employee. This template calculates standard withholdings (federal/state tax, FICA) and is suitable for most traditional employment relationships with a consistent schedule.",
    "category": "standard_with_logo"
  },
  "sections": [
    {
      "section_id": "paystub_header",
      "order": 1,
      "layout_type": "flex",
      "columns": [
        {
          "id": 1,
          "layout_type": "flex",
          "styling": "d-flex justify-content-end",
          "fields": [
            { "field_id": "paystub_title", "source": "paystub_title", "data_type": "string", "position": { "section": "paystub_header", "order": 1 }, "defaultValue": "EARNINGS STATEMENT", "styling": "paystub_heading_fontsize"}
          ]
        }
      ]
    },
    {
      "section_id": "company_header",
      "order": 2,
      "layout_type": "grid",
      "columns": [
        {
          "id": 1,
          "layout_type": "grid",
          "fields": [
            {"field_id": "company_logo","source": "company_logo","data_type": "image","position": { "section": "company_header", "order": 1 },"defaultValue": "[LOGO1]","styling": "label_fontsize"            }
          ]
        },
        {
          "id": 2,
          "layout_type": "grid",
          "fields": [
            { "field_id": "companyName", "data_type": "string", "source": "company_name", "position": { "section": "company_header", "order": 1 }, "defaultValue": "ABC Corporation", "required": true, "styling": "label_fontsize"},
            { "field_id": "companyFullAddress", "data_type": "string", "source": "company_address", "position": { "section": "company_header", "order": 2 }, "defaultValue": "Issam 123 Business Street, New York, NY 10001", "styling": "label_fontsize"},
            {"field_id": "companyPhone", "data_type": "phone", "source": "company_phone","position": { "section": "company_header", "order": 3 },"defaultValue": "(555) 123-4567","styling": "label_fontsize"},
            {"field_id": "companyEmail","data_type": "email","source": "company_email","position": { "section": "company_header", "order": 4 },"defaultValue": "payroll@company.com","styling": "label_fontsize"},
            {"field_id": "companyEIN","label": "EIN","source": "company_tax_id","data_type": "string","position": { "section": "company_header", "order": 5 },"defaultValue": "12-3456789","styling": "label_fontsize"            }
          ]
        },
        {
          "id": 3,
          "layout_type": "grid",
          "fields": [
            {"field_id": "payStubNumber","label": "Pay Stub Number","data_type": "string","source": "paystub_id","position": { "section": "company_header", "order": 1 },"defaultValue": "PS-2025-001","styling": "label_fontsize"            },
            {"field_id": "checkNumber","label": "Check Number","data_type": "string","source": "check_number","position": { "section": "company_header", "order": 2 },"defaultValue": "CHK-12345","styling": "label_fontsize"            },
            {"field_id": "periodStartDate","label": "Pay Period Start","data_type": "date","format": "MM/DD/YYYY","source": "pay_period_start","position": { "section": "company_header", "order": 3 },"defaultValue": "01/01/2025","styling": "label_fontsize"            },
            {"field_id": "periodEndDate","label": "Pay Period End","data_type": "date","format": "MM/DD/YYYY","source": "pay_period_end","position": { "section": "company_header", "order": 4 },"defaultValue": "01/15/2025","styling": "label_fontsize"            },
            {"field_id": "periodPayDate","label": "Pay Date","data_type": "date","format": "MM/DD/YYYY","source": "pay_date","position": { "section": "company_header", "order": 5 },"defaultValue": "01/20/2025","styling": "label_fontsize"            },
            {"field_id": "periodDateRange","label": "Pay Period","data_type": "date","format": "MM/DD/YYYY to MM/DD/YYYY","source": "pay_period","position": { "section": "company_header", "order": 6 },"defaultValue": "Issam 01/01/2025 to 01/15/2025","styling": "label_fontsize"
            }
          ]
        }
      ]
    },
    {
      "section_id": "employee_details",
      "order": 3,
      "layout_type": "grid",
      "columns": [
        {
          "id": 1,
          "width": 4,
          "layout_type": "grid",
          "styling": "border border-primary",
          "fields": [
            { "field_id": "employeeFullName", "data_type": "string", "source": "employee_name", "position": { "section": "employee_details", "order": 1 }, "defaultValue": "John M. Doe", "required": true, "styling": "label_fontsize" },
            { "field_id": "employeeID", "label": "Employee ID", "data_type": "string", "source": "employee_id", "position": { "section": "employee_details", "order": 2 }, "defaultValue": "EMP-001", "required": true, "styling": "label_fontsize" },
            { "field_id": "employeeSSN", "label": "SSN (Last 4)", "data_type": "string", "source": "employee_ssn", "position": { "section": "employee_details", "order": 3 }, "defaultValue": "XXX-XX-1234", "styling": "label_fontsize" },
            { "field_id": "employeeMarriedStatus", "label": "Filing Status", "data_type": "string", "source": "employee_status", "position": { "section": "employee_details", "order": 4 }, "defaultValue": "Single", "styling": "label_fontsize" }
          ]
        },
        {
          "id": 2,
          "width": 4,
          "layout_type": "grid",
          "fields": [
            { "field_id": "employeeFullAddress", "data_type": "string", "source": "employee_address", "position": { "section": "employee_details", "order": 1 }, "defaultValue": "456 Elm Street, Brooklyn, NY 11201", "styling": "label_fontsize" },
            { "field_id": "employeePhone", "label": "Phone", "data_type": "phone", "source": "employee_phone", "position": { "section": "employee_details", "order": 2 }, "defaultValue": "(555) 987-6543", "styling": "label_fontsize" },
            { "field_id": "employeeEmail", "label": "Email", "data_type": "email", "source": "employee_email", "position": { "section": "employee_details", "order": 3 }, "defaultValue": "john.doe@email.com", "styling": "label_fontsize" },
            { "field_id": "employeeHireDate", "label": "Hire Date", "data_type": "date", "source": "employee_hire_date", "position": { "section": "employee_details", "order": 4 }, "defaultValue": "01/01/2025", "styling": "label_fontsize" }
          ]
        },
        {
          "id": 3,
          "width": 4,
          "layout_type": "grid",
          "fields": [
            { "field_id": "employmentType", "label": "Employment Type", "data_type": "string", "source": "employment_type", "position": { "section": "employee_details", "order": 1 }, "defaultValue": "Full-Time", "styling": "label_fontsize" },
            { "field_id": "wageType", "label": "Wage Type", "data_type": "string", "source": "employee_wage_type", "position": { "section": "employee_details", "order": 2 }, "defaultValue": "Hourly", "styling": "label_fontsize" },
            { "field_id": "paymentMethod", "label": "Payment Method", "data_type": "string", "source": "payment_method", "position": { "section": "employee_details", "order": 3 }, "defaultValue": "Direct Deposit", "styling": "label_fontsize" },
            { "field_id": "paymentFrequency", "label": "Pay Frequency", "data_type": "string", "source": "payment_frequency", "position": { "section": "employee_details", "order": 4 }, "defaultValue": "Bi-Weekly", "styling": "label_fontsize" }
          ]
        }
      ]
    },
    {
      "section_id": "pay_details",
      "title": "Pay Details",
      "order": 4,
      "layout_type": "table",
      "styling": "flex border border-primary",
      "columns": [
        {
          "id": 1,
          "width": 5,
          "layout_type": "table",
          "headers": ["Rate", "Hours", "Current Pay", "YTD Pay"],
          "fields": [
            { "field_id": "regular_pay", "label": "Regular Pay", "data_type": "currency", "format": "$0.00", "source": "regular_pay", "position": { "section": "pay_details", "row": 1 }, "calculation": "hourlyRate * hoursWorked", "defaultValue": 2000.0, "editable": false, "styling": "label_fontsize" },
            { "field_id": "hourlyRate", "label": "Hourly Rate", "data_type": "currency", "format": "$0.00", "source": "hourly_rate", "position": { "section": "pay_details", "row": 1 }, "defaultValue": 25.0, "styling": "label_fontsize" },
            { "field_id": "hoursWorked", "label": "Hours Worked", "data_type": "number", "format": "0.00", "source": "hours_worked", "position": { "section": "pay_details", "row": 1 }, "defaultValue": 80, "styling": "label_fontsize" },
            { "field_id": "overtime_pay", "label": "Overtime Pay", "data_type": "currency", "format": "$0.00", "source": "overtime_pay", "position": { "section": "pay_details", "row": 2 }, "calculation": "overtimeRate * overtimeHours", "defaultValue": 187.5, "editable": false, "styling": "label_fontsize" },
            { "field_id": "overtimeRate", "label": "Overtime Rate", "data_type": "currency", "format": "$0.00", "source": "overtime_rate", "position": { "section": "pay_details", "row": 2 }, "defaultValue": 37.5, "styling": "label_fontsize" },
            { "field_id": "overtimeHours", "label": "Overtime Hours", "data_type": "number", "format": "0.00", "source": "overtime_hours", "position": { "section": "pay_details", "row": 2 }, "defaultValue": 5, "styling": "label_fontsize" },
            { "field_id": "bonusAmount", "label": "Bonus", "data_type": "currency", "format": "$0.00", "source": "bonus_amount", "position": { "section": "pay_details", "row": 3 }, "defaultValue": 0.0, "styling": "label_fontsize" }
          ]
        },
        {
          "id": 3,
          "width": 2,
          "layout_type": "table",
          "headers": ["Description", "Current", "YTD"],
          "fields": [
            { "field_id": "deduction401k", "label": "401(k) Contribution", "data_type": "currency", "format": "$0.00", "source": "deduction_401k", "position": { "section": "pay_details", "row": 1 }, "defaultValue": 100.0, "styling": "label_fontsize" },
            { "field_id": "medicalDeduction", "label": "Medical Insurance", "data_type": "currency", "format": "$0.00", "source": "medical_deduction", "position": { "section": "pay_details", "row": 2 }, "defaultValue": 150.0, "styling": "label_fontsize" },
            { "field_id": "dentalDeduction", "label": "Dental Insurance", "data_type": "currency", "format": "$0.00", "source": "dental_deduction", "position": { "section": "pay_details", "row": 3 }, "defaultValue": 25.0, "styling": "label_fontsize" },
            { "field_id": "visionDeduction", "label": "Vision Insurance", "data_type": "currency", "format": "$0.00", "source": "vision_deduction", "position": { "section": "pay_details", "row": 4 }, "defaultValue": 15.0, "styling": "label_fontsize" },
            { "field_id": "otherDeduction", "label": "Other Deductions", "data_type": "currency", "format": "$0.00", "source": "other_deduction", "position": { "section": "pay_details", "row": 5}, "defaultValue": 0.0, "styling": "label_fontsize" },
            { "field_id": "unionDues", "label": "Union Dues", "data_type": "currency", "format": "$0.00", "source": "union_dues", "position": { "section": "pay_details", "row": 6 }, "defaultValue": 0.0, "styling": "label_fontsize" }
          ]
        },
        {
          "id": 3,
          "width": 4,
          "layout_type": "table",
          "headers": ["Description", "Current Tax", "YTD Taxes"],
          "fields": [
            { "field_id": "federal_income_tax", "label": "Federal Income Tax", "data_type": "currency", "format": "$0.00", "position": { "section": "pay_details", "row": 1 }, "defaultValue": 350.0, "styling": "label_fontsize" },
            { "field_id": "ytd_federal_tax", "label": "YTD Federal Tax", "data_type": "currency", "format": "$0,000.00", "position": { "section": "pay_details", "row": 1 }, "defaultValue": 4200.0, "styling": "label_fontsize" },
            { "field_id": "social_security_tax", "label": "Social Security Tax", "data_type": "currency", "format": "$0.00", "position": { "section": "pay_details", "row": 2}, "defaultValue": 135.63, "styling": "label_fontsize" },
            { "field_id": "ytd_social_security", "label": "YTD Social Security", "data_type": "currency", "format": "$0,000.00", "position": { "section": "pay_details", "row": 2}, "defaultValue": 1627.5, "styling": "label_fontsize" },
            { "field_id": "medicare_tax", "label": "Medicare Tax", "data_type": "currency", "format": "$0.00", "position": { "section": "pay_details", "row": 3}, "defaultValue": 31.71, "styling": "label_fontsize" },
            { "field_id": "ytd_medicare", "label": "YTD Medicare", "data_type": "currency", "format": "$0,000.00", "position": { "section": "pay_details", "row": 3}, "defaultValue": 380.5, "styling": "label_fontsize" },
            { "field_id": "state_income_tax", "label": "State Income Tax", "data_type": "currency", "format": "$0.00", "position": { "section": "pay_details", "row": 3}, "defaultValue": 120.0, "styling": "label_fontsize" },
            { "field_id": "ytd_state_tax", "label": "YTD State Tax", "data_type": "currency", "format": "$0,000.00", "position": { "section": "pay_details", "row": 3}, "defaultValue": 1440.0, "styling": "label_fontsize" }
          ]
        }
      ]
    }
  ],
  "styling": {
    "primaryColor": "#2563eb",
    "secondaryColor": "#60a5fa",
    "backgroundColor": "#ffffff",
    "fontFamily": "Arial, sans-serif",
    "borderColor": "#d1d5db",
    "headerBackground": "#eff6ff"
  },
  "layout": {
    "maxWidth": "900px",
    "padding": "0",
    "margin": "auto"
  }
}