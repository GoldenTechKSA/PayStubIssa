{
  "template_id": "prof-2column-paystub",
  "title": "Professional 2-Column Paystub",
  "version": "1.0",
  "description": "Clean, professional paystub with 2-column layout optimized for readability",
  "layout_type": "2-column-consistent",
  "styling": {
    "container": "bg-white border rounded shadow-sm p-4 mx-auto",
    "header_container": "row mb-4 pb-3 border-bottom",
    "body_container": "row mb-4",
    "summary_container": "row pt-3 border-top border-2",
    "column": "mb-3",
    "section": "p-3 bg-light rounded",
    "section_title": "fw-bold fs-5 mb-2 text-primary",
    "field": "py-1",
    "field_content": "fw-normal",
    "company_name_field": "fs-3 fw-bold text-dark mb-2 d-block",
    "calculated_field": "fw-bold fs-4 text-success",
    "logo_container": "d-flex justify-content-start mb-2",
    "logo": "img-fluid object-fit-contain max-height-32px",
    "paystub_title": "fs-2 fw-bold text-dark mb-1",
    "paystub_id": "text-muted small",
    "array_table": "table table-sm w-100 mt-2",
    "array_th": "text-start fw-bold bg-secondary text-white small",
    "array_td": "text-start py-1 small",
    "array_tr": "border-bottom"
  },
  "header": {
    "columns": [
      {
        "column_id": "header_company_logo",
        "fields": [
          {
            "field_id": "company_logo",
            "data_type": "image"
          },
          {
            "field_id": "company_name",
            "data_type": "string"
          },
          {
            "field_id": "company_address",
            "data_type": "string"
          },
          {
            "field_id": "company_city_state_zip",
            "data_type": "string"
          }
        ]
      },
      {
        "column_id": "header_paystub_info",
        "fields": [
          {
            "field_id": "paystub_title",
            "label": "Earnings Statement",
            "data_type": "string"
          },
          {
            "field_id": "paystub_id",
            "label": "Statement #: ",
            "data_type": "string"
          },
          {
            "field_id": "pay_period",
            "label": "Pay Period: ",
            "data_type": "date_range",
            "format": "MMM DD, YYYY - MMM DD, YYYY"
          },
          {
            "field_id": "pay_date",
            "label": "Pay Date: ",
            "data_type": "date",
            "format": "MMM DD, YYYY"
          },
          {
            "field_id": "company_phone",
            "label": "Contact: ",
            "data_type": "string"
          },
          {
            "field_id": "company_tax_id",
            "label": "EIN: ",
            "data_type": "string"
          }
        ]
      }
    ]
  },
  "body": {
    "columns": [
      {
        "column_id": "employee_earnings",
        "fields": [
          {
            "field_id": "employee_name",
            "label": "Employee: ",
            "data_type": "string"
          },
          {
            "field_id": "employee_id",
            "label": "Employee ID: ",
            "data_type": "string"
          },
          {
            "field_id": "employee_address",
            "label": "Address: ",
            "data_type": "string"
          },
          {
            "field_id": "employee_city_state_zip",
            "label": "City/State/ZIP: ",
            "data_type": "string"
          },
          {
            "field_id": "department",
            "label": "Department: ",
            "data_type": "string"
          },
          {
            "field_id": "position",
            "label": "Position: ",
            "data_type": "string"
          },
          {
            "field_id": "hire_date",
            "label": "Hire Date: ",
            "data_type": "date",
            "format": "MMM DD, YYYY"
          }
        ]
      },
      {
        "column_id": "deductions_taxes_summary",
        "fields": [
          {
            "field_id": "earnings_items",
            "label": "Earnings",
            "data_type": "array",
            "array_type": "earnings"
          },
          {
            "field_id": "deductions_items",
            "label": "Deductions",
            "data_type": "array",
            "array_type": "deductions"
          },
          {
            "field_id": "taxes_items",
            "label": "Taxes",
            "data_type": "array",
            "array_type": "taxes"
          }
        ]
      }
    ]
  },
  "summary": {
    "columns": [
      {
        "column_id": "summary_details",
        "fields": [
          {
            "field_id": "current_gross",
            "label": "Gross Pay This Period: ",
            "data_type": "currency",
            "format": "$0,0.00"
          },
          {
            "field_id": "current_deductions",
            "label": "Total Deductions: ",
            "data_type": "currency",
            "format": "$0,0.00"
          },
          {
            "field_id": "ytd_gross",
            "label": "YTD Gross: ",
            "data_type": "currency",
            "format": "$0,0.00"
          },
          {
            "field_id": "ytd_deductions",
            "label": "YTD Deductions: ",
            "data_type": "currency",
            "format": "$0,0.00"
          }
        ]
      },
      {
        "column_id": "summary_net_pay",
        "fields": [
          {
            "field_id": "net_pay",
            "label": "NET PAY: ",
            "data_type": "currency",
            "format": "$0,0.00"
          },
          {
            "field_id": "ytd_net",
            "label": "YTD Net Pay: ",
            "data_type": "currency",
            "format": "$0,0.00"
          },
          {
            "field_id": "payment_method",
            "label": "Payment Method: ",
            "data_type": "string"
          },
          {
            "field_id": "check_number",
            "label": "Check/Ref #: ",
            "data_type": "string"
          }
        ]
      }
    ]
  }
}