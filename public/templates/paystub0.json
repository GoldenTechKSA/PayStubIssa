{
  "template_id": "standard-paystub",
  "title": "Advanced 3-Column Paystub",
  "version": "3.4",
  "description": "Professional paystub with consistent 3-column layout using Bootstrap 5",
  "layout_type": "3-column-consistent",
  "styling": {
    "container": "border rounded p-4 bg-white shadow-sm mx-auto",
    "header_container": "row g-4 mb-5 p-4 bg-light rounded border",
    "body_container": "row g-5 mb-5",
    "summary_container": "row g-4 p-4 bg-light rounded border-top border-3",
    "column": "mb-4",
    "section": "p-3 rounded bg-white border",
    "section_title": "fw-bold fs-5 mb-3 pb-2 border-bottom text-center",
    "field": "py-2 px-1",
    "field_content": "fw-medium",
    "logo_container": "d-flex justify-content-center align-items-center mb-3",
    "logo": "img-fluid max-height-100px",
    "paystub_title": "text-center fs-2 fw-bold mb-2",
    "paystub_id": "text-center text-muted mb-3",
    "array_table": "table table-bordered table-sm w-100 mt-2",
    "array_th": "text-start fw-bold bg-light",
    "array_td": "text-start py-2",
    "array_tr": ""
  },
  "header": {
    "columns": [
      {
        "column_id": "header_company_info",
        "fields": [
          {
            "field_id": "company_name",
            "label": "Company Name",
            "data_type": "string"
          },
          {
            "field_id": "company_address",
            "label": "Address",
            "data_type": "string"
          },
          {
            "field_id": "company_city_state_zip",
            "label": "City, State ZIP",
            "data_type": "string"
          },
          {
            "field_id": "company_phone",
            "label": "Phone",
            "data_type": "string"
          },
          {
            "field_id": "company_tax_id",
            "label": "Tax ID",
            "data_type": "string"
          }
        ]
      },
      {
        "column_id": "header_logo",
        "fields": [
          {
            "field_id": "company_logo",
            "label": "Company Logo",
            "data_type": "image",
            "position": "center"
          }
        ]
      },
      {
        "column_id": "header_title",
        "fields": [
          {
            "field_id": "paystub_title",
            "label": "Paystub Title",
            "data_type": "string",
            "format": "title"
          },
          {
            "field_id": "paystub_id",
            "label": "Paystub ID",
            "data_type": "string"
          },
          {
            "field_id": "pay_period",
            "label": "Pay Period",
            "data_type": "date_range",
            "format": "MM/DD/YYYY - MM/DD/YYYY"
          },
          {
            "field_id": "pay_date",
            "label": "Pay Date",
            "data_type": "date",
            "format": "MM/DD/YYYY"
          }
        ]
      }
    ]
  },
  "body": {
    "columns": [
      {
        "column_id": "employee_info",
        "title": "Employee Information",
        "fields": [
          {
            "field_id": "employee_name",
            "label": "Employee Name",
            "data_type": "string"
          },
          {
            "field_id": "employee_id",
            "label": "Employee ID",
            "data_type": "string"
          },
          {
            "field_id": "employee_address",
            "label": "Address",
            "data_type": "string"
          },
          {
            "field_id": "employee_city_state_zip",
            "label": "City, State ZIP",
            "data_type": "string"
          },
          {
            "field_id": "employee_ssn",
            "label": "SSN",
            "data_type": "string",
            "format": "masked"
          },
          {
            "field_id": "department",
            "label": "Department",
            "data_type": "string"
          },
          {
            "field_id": "position",
            "label": "Position",
            "data_type": "string"
          },
          {
            "field_id": "hire_date",
            "label": "Hire Date",
            "data_type": "date",
            "format": "MM/DD/YYYY"
          }
        ]
      },
      {
        "column_id": "earnings",
        "title": "Earnings",
        "fields": [
          {
            "field_id": "earnings_items",
            "label": "Earnings Details",
            "data_type": "array",
            "array_type": "earnings"
          }
        ]
      },
      {
        "column_id": "deductions_taxes",
        "title": "Deductions & Taxes",
        "fields": [
          {
            "field_id": "deductions_items",
            "label": "Deductions",
            "data_type": "array",
            "array_type": "deductions"
          },
          {
            "field_id": "taxes_items",
            "label": "Taxes",
            "data_type": "array",
            "array_type": "taxes"
          }
        ]
      }
    ]
  },
  "summary": {
    "columns": [
      {
        "column_id": "summary_earnings",
        "title": "Earnings Summary",
        "fields": [
          {
            "field_id": "current_gross",
            "label": "Current Gross Pay",
            "data_type": "currency",
            "format": "$0,0.00"
          },
          {
            "field_id": "ytd_gross",
            "label": "YTD Gross Pay",
            "data_type": "currency",
            "format": "$0,0.00"
          }
        ]
      },
      {
        "column_id": "summary_deductions",
        "title": "Deductions Summary",
        "fields": [
          {
            "field_id": "current_deductions",
            "label": "Current Deductions",
            "data_type": "currency",
            "format": "$0,0.00"
          },
          {
            "field_id": "ytd_deductions",
            "label": "YTD Deductions",
            "data_type": "currency",
            "format": "$0,0.00"
          }
        ]
      },
      {
        "column_id": "summary_totals",
        "title": "Final Summary",
        "fields": [
          {
            "field_id": "net_pay",
            "label": "Net Pay",
            "data_type": "currency",
            "format": "$0,0.00"
          },
          {
            "field_id": "ytd_net",
            "label": "YTD Net Pay",
            "data_type": "currency",
            "format": "$0,0.00"
          },
          {
            "field_id": "payment_method",
            "label": "Payment Method",
            "data_type": "string"
          },
          {
            "field_id": "check_number",
            "label": "Check Number",
            "data_type": "string"
          }
        ]
      }
    ]
  }
}