# react-scripts@5.0.1 declares a stale peerOptional on typescript@"^3 || ^4",
# but this project runs on TypeScript 5 (which CRA 5 builds/tests fine in practice).
# Use npm's relaxed peer-dependency resolution so a plain `npm install` succeeds
# without requiring the --legacy-peer-deps flag on every install.
legacy-peer-deps=true
