# PayStubIssa API — environment configuration.
# Copy to `.env` (same folder) and fill in. `.env` is gitignored; never commit real values.

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
# Bind to loopback only: Apache mod_proxy is the only public way in.
HOST=127.0.0.1
PORT=4000
# Number of proxies in front of Node (Apache = 1) so rate limiting sees the real client IP.
TRUST_PROXY=1

# --- PayPal (REST app credentials from developer.paypal.com) -----------------
# sandbox for local/staging, live for production. The client SDK is loaded with
# PAYPAL_CLIENT_ID, so the browser automatically matches this environment.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional until the webhook route ships.
PAYPAL_WEBHOOK_ID=

# --- Unlock token ------------------------------------------------------------
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# How long a paid unlock stays valid in the browser.
UNLOCK_TOKEN_TTL_MINUTES=60

# --- Pricing (server-authoritative) ------------------------------------------
CURRENCY=USD
PRICE_PER_STUB_CENTS=899
MAX_STUBS_PER_ORDER=12
# Hand-made percent-off coupon codes, `CODE:PERCENT` separated by commas (whole numbers 1–99;
# 100% is refused because a $0 order has no PayPal path). Codes are case-insensitive.
# Leave empty for no coupons. Change it, then `pm2 restart <app> --update-env`.
COUPONS=

# --- Storage -----------------------------------------------------------------
# Relative paths resolve against the server/ folder regardless of cwd.
DATABASE_PATH=./data/orders.sqlite

# --- Telemetry ---------------------------------------------------------------
# Store anonymous usage events from the client in telemetry_events (same DB). false = accept and discard.
TELEMETRY_ENABLED=true
# Rows older than this are deleted at boot and daily.
TELEMETRY_RETENTION_DAYS=90
# Hard ceiling on stored rows (oldest deleted first) so a runaway client cannot fill the disk
# the orders ledger shares.
TELEMETRY_MAX_ROWS=2000000
